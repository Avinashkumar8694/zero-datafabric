<%- include('partials/header') %>

<div class="docs-layout fade-in">
    <!-- Left Navigation Sidebar -->
    <aside class="docs-nav" aria-label="Integration guide index">
        <div class="docs-nav-group">
            <div class="docs-nav-group-title">Integration Guide</div>
            <ul class="docs-nav-list" id="integrationNavList">
                <li class="docs-loading">Loading docs...</li>
            </ul>
        </div>
    </aside>

    <!-- Right Reading Pane -->
    <main class="docs-content">
        <nav class="docs-crumb" aria-label="Breadcrumb">
            <a href="/dashboard">Console</a>
            <span aria-hidden="true">/</span>
            <span>Integration Guide</span>
            <span aria-hidden="true">/</span>
            <span id="integrationCurrentTitle" aria-current="page">Select a document</span>
        </nav>
        <div class="markdown-body" id="integrationDocContent">
            <div class="docs-loading">Select a document from the sidebar to view its content.</div>
        </div>
    </main>
</div>

<script>
(function() {
    const API_BASE = window.location.hostname.includes('fabrixly.com')
        ? `/api`
        : `http://${window.location.hostname}:4000/api`;
    const DOCS_API = API_BASE + '/developer-docs';
    const navList = document.getElementById('integrationNavList');
    const contentDiv = document.getElementById('integrationDocContent');
    const titleSpan = document.getElementById('integrationCurrentTitle');

    function getQueryParam(name) {
        const params = new URLSearchParams(window.location.search);
        return params.get(name);
    }

    function setQueryParam(name, value) {
        const url = new URL(window.location.href);
        url.searchParams.set(name, value);
        window.history.pushState({}, '', url);
    }

    async function loadDocList() {
        try {
            const res = await fetch(DOCS_API, { headers: getAuthHeaders ? getAuthHeaders() : {} });
            if (!res.ok) throw new Error('Failed to load docs');
            const data = await res.json();
            renderNav(data.groups || []);
        } catch (err) {
            navList.innerHTML = '<li class="docs-error">Error loading docs</li>';
        }
    }

    function renderNav(groups) {
        navList.innerHTML = '';
        groups.forEach(function(group) {
            const groupLi = document.createElement('li');
            groupLi.className = 'docs-nav-group';
            const groupTitle = document.createElement('div');
            groupTitle.className = 'docs-nav-group-title';
            groupTitle.textContent = group.label;
                        groupLi.appendChild(groupTitle);

            const ul = document.createElement('ul');
            ul.className = 'docs-nav-list';

            group.docs.forEach(function(doc) {
                const li = document.createElement('li');
                const a = document.createElement('button');
                a.className = 'docs-nav-link';
                a.type = 'button';
                a.textContent = doc.title;
                a.title = doc.title;
                a.addEventListener('click', function() {
                    document.querySelectorAll('.docs-nav-link').forEach(function(el) {
                        el.classList.remove('active');
                    });
                    a.classList.add('active');
                    setQueryParam('doc', doc.id);
                    loadDoc(doc.id, doc.title);
                });
                li.appendChild(a);
                ul.appendChild(li);
            });

            groupLi.appendChild(ul);
            navList.appendChild(groupLi);
        });

        const initialDoc = getQueryParam('doc');
        if (initialDoc) {
            const allDocs = groups.flatMap(function(g) { return g.docs; });
            const found = allDocs.find(function(d) { return d.id === initialDoc; });
            if (found) {
                const btn = Array.from(document.querySelectorAll('.docs-nav-link')).find(function(el) {
                    return el.textContent === found.title;
                });
                if (btn) btn.classList.add('active');
                loadDoc(found.id, found.title);
                return;
            }
        }

        const firstDoc = groups[0] && groups[0].docs[0];
        if (firstDoc) {
            loadDoc(firstDoc.id, firstDoc.title);
        }
    }

    async function loadDoc(docId, title) {
        titleSpan.textContent = title || docId;
        contentDiv.innerHTML = '<div class="docs-loading">Loading...</div>';
        try {
            const res = await fetch(DOCS_API + '/' + encodeURIComponent(docId), { headers: getAuthHeaders ? getAuthHeaders() : {} });
            if (!res.ok) throw new Error('Failed to load doc');
            const data = await res.json();
            contentDiv.innerHTML = data.htmlContent || '<div class="docs-error">Empty document</div>';
        } catch (err) {
            contentDiv.innerHTML = '<div class="docs-error">Error loading document</div>';
        }
    }

    loadDocList();
})();
</script>

<%- include('partials/footer') %>
