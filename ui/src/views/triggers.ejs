<%- include('partials/header') %>

<div class="page fade-in">
  <div class="page-head">
    <div>
      <h1 class="page-title">Trigger Control Plane</h1>
      <p class="page-sub">Row triggers and generic scheduler triggers (<code>every n unit</code>) with async execution via trigger-engine.</p>
    </div>
    <div class="page-actions">
      <button type="button" class="btn-outline" onclick="loadAll()"><i class="fas fa-sync" aria-hidden="true"></i> Refresh</button>
      <button type="button" class="btn-primary" onclick="openTriggerModal()"><i class="fas fa-plus" aria-hidden="true"></i> Create Trigger</button>
    </div>
  </div>

  <div class="split even">
    <section class="glass-card">
      <h3><i class="fas fa-bolt" aria-hidden="true"></i> Registry</h3>
      <div class="table-wrapper scroll-y">
        <table>
          <thead><tr><th>Name</th><th>Scope</th><th>Type</th><th>Status</th><th>Actions</th></tr></thead>
          <tbody id="trgBody"><tr><td colspan="5" class="state-cell">Loading...</td></tr></tbody>
        </table>
      </div>
    </section>

    <section class="glass-card">
      <h3>Jobs</h3>
      <div class="table-wrapper scroll-y">
        <table>
          <thead><tr><th>Job</th><th>Status</th><th>Attempts</th><th>Action</th></tr></thead>
          <tbody id="jobBody"><tr><td colspan="4" class="state-cell">Loading...</td></tr></tbody>
        </table>
      </div>
    </section>
  </div>

  <section class="glass-card">
    <div class="card-head">
      <h3>Execution Logs</h3>
      <span class="text-muted small" id="logMeta" role="status">Auto-pagination on scroll</span>
    </div>
    <div class="table-wrapper scroll-y" id="logScroller">
      <table>
        <thead><tr><th>Time</th><th>Trigger</th><th>Action</th><th>Status</th><th>Detail</th></tr></thead>
        <tbody id="logBody"><tr><td colspan="5" class="state-cell">Loading...</td></tr></tbody>
      </table>
    </div>
  </section>
</div>

<div id="triggerModal" class="modal-overlay" role="dialog" aria-modal="true" aria-labelledby="trgModalTitle">
  <div class="modal-card lg">
    <div class="modal-header">
      <h3 id="trgModalTitle">Create Trigger</h3>
      <button type="button" class="modal-close" onclick="closeTriggerModal()" aria-label="Close dialog">&times;</button>
    </div>
    <div class="modal-body">
    <div class="form-grid">
      <div class="field">
        <label for="fTriggerName">Trigger Name</label>
        <input id="fTriggerName" placeholder="trg_orders_notify">
      </div>
      <div class="field">
        <label for="fMode">Mode</label>
        <select id="fMode" onchange="toggleModeFields()">
          <option value="ROW">Row Trigger</option>
          <option value="SCHEDULE">Scheduler Trigger</option>
        </select>
      </div>
      <div class="field" id="rowFieldsA">
        <label for="fSchema">Schema</label>
        <input id="fSchema" placeholder="tenant_tenant_A_Global_Supply_Chain">
      </div>
      <div class="field" id="rowFieldsB">
        <label for="fTable">Table</label>
        <input id="fTable" placeholder="shipments">
      </div>
      <div class="field" id="rowFieldsC">
        <label for="fEvent">Event</label>
        <select id="fEvent">
          <option>AFTER_INSERT</option><option>AFTER_UPDATE</option><option>AFTER_DELETE</option>
          <option>BEFORE_INSERT</option><option>BEFORE_UPDATE</option><option>BEFORE_DELETE</option>
        </select>
      </div>
      <div class="field" id="schedFieldsA" style="display:none;">
        <label for="fEvery">Every</label>
        <input id="fEvery" type="number" value="1" min="1">
      </div>
      <div class="field" id="schedFieldsB" style="display:none;">
        <label for="fUnit">Unit</label>
        <select id="fUnit"><option>SECOND</option><option>MINUTE</option><option>HOUR</option><option>DAY</option></select>
      </div>
      <div class="field full" id="schedFieldsC" style="display:none;">
        <label for="fSchedType">Scheduler Mode</label>
        <select id="fSchedType" onchange="toggleSchedType()">
          <option value="FIXED">FIXED (Every N Unit)</option>
          <option value="CRON">CRON Expression</option>
        </select>
      </div>
      <div class="field full" id="schedCronWrap" style="display:none;">
        <label for="fCron">Cron Expression</label>
        <input id="fCron" placeholder="*/5 * * * *">
      </div>
      <div class="field">
        <label for="fActionType">Action Type</label>
        <select id="fActionType">
          <option>AUDIT</option><option>EMAIL</option><option>TELEGRAM</option><option>WEBHOOK</option><option>FUNCTION</option><option>EXCEPTION</option>
        </select>
      </div>
      <div class="field full">
        <label for="fActionJson">Action JSON (<code>execute</code> fields: params/payload/headers/auth)</label>
        <textarea id="fActionJson" class="code-input">{}</textarea>
      </div>
      <div class="field full">
        <label for="fExtrasJson">Schedule/AutoDrop JSON (optional)</label>
        <textarea id="fExtrasJson" class="code-input">{}</textarea>
      </div>
    </div>
    </div>
    <div class="modal-footer">
      <button type="button" class="btn-outline" onclick="closeTriggerModal()">Cancel</button>
      <button type="button" class="btn-primary" onclick="saveTriggerFromModal()">Save Trigger</button>
    </div>
  </div>
</div>

<script>
  let editingId = null;
  let logOffset = 0;
  let logLoading = false;
  let logDone = false;
  const LOG_PAGE = 30;

  function esc(s) {
    return escapeHtml(s);
  }

  function toggleModeFields() {
    const mode = document.getElementById('fMode').value;
    const row = mode === 'ROW';
    ['rowFieldsA','rowFieldsB','rowFieldsC'].forEach(id => document.getElementById(id).style.display = row ? '' : 'none');
    ['schedFieldsA','schedFieldsB','schedFieldsC'].forEach(id => document.getElementById(id).style.display = row ? 'none' : '');
    if (!row) toggleSchedType();
    else document.getElementById('schedCronWrap').style.display = 'none';
  }

  function toggleSchedType() {
    const t = document.getElementById('fSchedType').value;
    const cron = t === 'CRON';
    document.getElementById('schedCronWrap').style.display = cron ? '' : 'none';
    document.getElementById('schedFieldsA').style.display = cron ? 'none' : '';
    document.getElementById('schedFieldsB').style.display = cron ? 'none' : '';
  }

  function openTriggerModal(row = null) {
    if (typeof row === 'string') {
      try { row = JSON.parse(row); } catch (e) { row = null; }
    }
    editingId = row?.id || null;
    document.getElementById('trgModalTitle').innerText = editingId ? 'Edit Trigger' : 'Create Trigger';
    const tenant = localStorage.getItem('active_tenant') || 'tenant_A';
    document.getElementById('fTriggerName').value = row?.triggerName || 'trg_new_action';
    const isSched = row?.schemaName === '__SYSTEM__' || row?.tableName === '__SYSTEM__' || !!row?.definition?.schedule?.type;
    document.getElementById('fMode').value = isSched ? 'SCHEDULE' : 'ROW';
    document.getElementById('fSchema').value = row?.schemaName && row.schemaName !== '__SYSTEM__' ? row.schemaName : `tenant_${tenant}_Global_Supply_Chain`;
    document.getElementById('fTable').value = row?.tableName && row.tableName !== '__SYSTEM__' ? row.tableName : 'shipments';
    document.getElementById('fEvent').value = row?.definition?.event || 'AFTER_INSERT';
    document.getElementById('fEvery').value = row?.definition?.schedule?.every || 1;
    document.getElementById('fUnit').value = row?.definition?.schedule?.unit || 'MINUTE';
    document.getElementById('fSchedType').value = row?.definition?.schedule?.type || 'FIXED';
    document.getElementById('fCron').value = row?.definition?.schedule?.cron || '*/5 * * * *';
    document.getElementById('fActionType').value = row?.definition?.execute?.type || 'AUDIT';
    const action = { ...row?.definition?.execute } || {};
    delete action.type;
    document.getElementById('fActionJson').value = JSON.stringify(action || {}, null, 2);
    const extras = { schedule: row?.definition?.schedule || null, autoDrop: row?.definition?.autoDrop || null };
    document.getElementById('fExtrasJson').value = JSON.stringify(extras, null, 2);
    toggleModeFields();
    document.getElementById('triggerModal').classList.add('active');
  }

  function closeTriggerModal() {
    document.getElementById('triggerModal').classList.remove('active');
  }

  async function saveTriggerFromModal() {
    try {
      const mode = document.getElementById('fMode').value;
      const triggerName = document.getElementById('fTriggerName').value.trim();
      const actionType = document.getElementById('fActionType').value;
      const actionJson = JSON.parse(document.getElementById('fActionJson').value || '{}');
      const extras = JSON.parse(document.getElementById('fExtrasJson').value || '{}');

      const definition = {
        execute: { type: actionType, ...actionJson }
      };
      if (mode === 'ROW') definition.event = document.getElementById('fEvent').value;
      if (extras?.autoDrop) definition.autoDrop = extras.autoDrop;
      if (mode === 'SCHEDULE') {
        const schedType = document.getElementById('fSchedType').value;
        if (schedType === 'CRON') {
          definition.schedule = {
            type: 'CRON',
            cron: document.getElementById('fCron').value.trim() || '*/5 * * * *',
            ...(extras?.schedule || {})
          };
        } else {
          definition.schedule = {
            type: 'FIXED',
            every: Number(document.getElementById('fEvery').value || 1),
            unit: document.getElementById('fUnit').value,
            ...(extras?.schedule || {})
          };
        }
      } else if (extras?.schedule) {
        definition.schedule = extras.schedule;
      }

      const payload = {
        triggerName,
        schemaName: mode === 'ROW' ? document.getElementById('fSchema').value.trim() : '__SYSTEM__',
        tableName: mode === 'ROW' ? document.getElementById('fTable').value.trim() : '__SYSTEM__',
        definition
      };

      const url = editingId ? `${API_BASE}/triggers/${editingId}` : `${API_BASE}/triggers`;
      const method = editingId ? 'PUT' : 'POST';
      const res = await fetch(url, { method, headers: getAuthHeaders(), body: JSON.stringify(payload) });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Save failed');
      closeTriggerModal();
      await loadAll();
    } catch (e) {
      showModal('Save Failed', e.message || 'Failed to save trigger');
    }
  }

  async function loadTriggers() {
    const body = document.getElementById('trgBody');
    body.innerHTML = '<tr><td colspan="5" class="state-cell">Loading...</td></tr>';
    try {
      const res = await fetch(`${API_BASE}/triggers`, { headers: getAuthHeaders() });
      const rows = await res.json();
      if (!Array.isArray(rows) || !rows.length) {
        body.innerHTML = '<tr><td colspan="5" class="state-cell">No triggers</td></tr>';
        return;
      }
      const MAX_ROWS = 500;
      const capped = rows.length > MAX_ROWS;
      const shown = capped ? rows.slice(0, MAX_ROWS) : rows;
      body.innerHTML = shown.map(r => {
        const scope = (r.schemaName === '__SYSTEM__' || r.tableName === '__SYSTEM__') ? 'Scheduler' : `${r.schemaName}.${r.tableName}`;
        const typ = r.definition?.execute?.type || 'N/A';
        return `<tr>
          <td><b>${esc(r.triggerName)}</b></td>
          <td><code>${esc(scope)}</code></td>
          <td>${esc(typ)}</td>
          <td><span class="badge ${r.status === 'ACTIVE' ? 'badge-ok' : 'badge-warn'}">${esc(r.status)}</span></td>
          <td><div class="row-actions">
            <button class="btn-outline btn-sm" onclick='openTriggerModal(${escapeHtml(JSON.stringify(JSON.stringify(r)))})'>Edit</button>
            <button class="btn-outline btn-sm" onclick='deployTrigger("${escapeJs(r.id)}")'>Deploy</button>
            <button class="btn-outline btn-sm btn-danger" onclick='deleteTrigger("${escapeJs(r.id)}","${escapeJs(r.triggerName)}")'>Delete</button>
          </div></td>
        </tr>`;
      }).join('') + (capped ? `<tr><td colspan="5" class="state-cell">Showing ${MAX_ROWS} of ${rows.length}</td></tr>` : '');
    } catch (e) {
      body.innerHTML = `<tr><td colspan="5" class="state-cell text-danger">Failed to load triggers: ${esc(e.message)}</td></tr>`;
    }
  }

  async function loadJobs() {
    const body = document.getElementById('jobBody');
    body.innerHTML = '<tr><td colspan="4" class="state-cell">Loading...</td></tr>';
    try {
      const res = await fetch(`${API_BASE}/triggers/jobs/list`, { headers: getAuthHeaders() });
      const rows = await res.json();
      if (!Array.isArray(rows) || !rows.length) {
        body.innerHTML = '<tr><td colspan="4" class="state-cell">No jobs</td></tr>';
        return;
      }
      const MAX_ROWS = 500;
      const capped = rows.length > MAX_ROWS;
      const shown = capped ? rows.slice(0, MAX_ROWS) : rows;
      body.innerHTML = shown.map(r => `<tr>
        <td>${esc(r.jobType)}</td>
        <td><span class="badge ${r.status === 'COMPLETED' ? 'badge-ok' : (r.status === 'FAILED' ? 'badge-danger' : 'badge-info')}">${esc(r.status)}</span></td>
        <td>${esc(r.attempts)}/${esc(r.maxAttempts)}</td>
        <td>${r.status === 'FAILED' ? `<button class="btn-outline btn-sm" onclick='retryJob("${escapeJs(r.id)}")'>Retry</button>` : ''}</td>
      </tr>`).join('') + (capped ? `<tr><td colspan="4" class="state-cell">Showing ${MAX_ROWS} of ${rows.length}</td></tr>` : '');
    } catch (e) {
      body.innerHTML = `<tr><td colspan="4" class="state-cell text-danger">Failed to load jobs: ${esc(e.message)}</td></tr>`;
    }
  }

  async function loadLogs(reset = false) {
    if (logLoading || logDone) return;
    if (reset) {
      logOffset = 0; logDone = false;
      document.getElementById('logBody').innerHTML = '';
    }
    logLoading = true;
    document.getElementById('logMeta').innerText = `Loading...`;
    const body = document.getElementById('logBody');
    try {
      const res = await fetch(`${API_BASE}/triggers/logs/list?limit=${LOG_PAGE}&offset=${logOffset}`, { headers: getAuthHeaders() });
      const rows = await res.json();
      if (!Array.isArray(rows) || rows.length === 0) {
        if (logOffset === 0) body.innerHTML = '<tr><td colspan="5" class="state-cell">No logs</td></tr>';
        logDone = true;
        document.getElementById('logMeta').innerText = `No more logs`;
        return;
      }
      body.innerHTML += rows.map(r => `<tr>
        <td>${esc(new Date(r.createdAt).toLocaleString())}</td>
        <td>${esc(r.triggerName)}</td>
        <td>${esc(r.action)}</td>
        <td><span class="badge ${r.status === 'SUCCESS' ? 'badge-ok' : 'badge-danger'}">${esc(r.status)}</span></td>
        <td><code>${esc(JSON.stringify(r.detail || {}))}</code></td>
      </tr>`).join('');
      logOffset += rows.length;
      document.getElementById('logMeta').innerText = `Loaded ${logOffset} logs`;
    } catch (e) {
      if (logOffset === 0) body.innerHTML = `<tr><td colspan="5" class="state-cell text-danger">Failed to load logs: ${esc(e.message)}</td></tr>`;
      document.getElementById('logMeta').innerText = `Failed to load logs`;
      logDone = true;
    } finally {
      logLoading = false;
    }
  }

  async function deployTrigger(id) {
    const res = await fetch(`${API_BASE}/triggers/${id}/deploy`, { method: 'POST', headers: getAuthHeaders() });
    const data = await res.json();
    if (!res.ok) return showModal('Deploy Failed', data.error || 'Deploy failed');
    showModal('Deploy Succeeded', 'Trigger deployed successfully.');
    await loadAll();
  }

  async function deleteTrigger(id, name) {
    showModal('Delete Trigger', `Delete '${name}'?`, async () => {
      const res = await fetch(`${API_BASE}/triggers/${id}`, { method: 'DELETE', headers: getAuthHeaders() });
      const data = await res.json();
      if (!res.ok) return showModal('Delete Failed', data.error || 'Delete failed');
      await loadAll();
    }, 'Delete');
  }

  async function retryJob(id) {
    const res = await fetch(`${API_BASE}/triggers/jobs/${id}/retry`, { method: 'POST', headers: getAuthHeaders() });
    const data = await res.json();
    if (!res.ok) return showModal('Retry Failed', data.error || 'Retry failed');
    showModal('Retry Queued', 'Job retry has been queued.');
    await loadJobs();
  }

  async function loadAll() {
    await Promise.all([loadTriggers(), loadJobs()]);
    await loadLogs(true);
  }

  document.getElementById('logScroller').addEventListener('scroll', (e) => {
    const el = e.target;
    if (el.scrollTop + el.clientHeight >= el.scrollHeight - 40) loadLogs(false);
  });

  loadAll();
</script>

<%- include('partials/footer') %>
