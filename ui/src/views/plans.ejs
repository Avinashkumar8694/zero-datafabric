<%- include('partials/header') %>

<div class="page fade-in">
    <div class="page-head">
        <div>
            <h1 class="page-title">Subscription Plans</h1>
            <p class="page-sub">Manage your subscription and view available plans.</p>
        </div>
    </div>

    <!-- Current Subscription -->
    <section class="glass-card">
        <h3>Current Subscription</h3>
        <div id="currentSubscription">
            <div class="state"><span class="spinner" aria-hidden="true"></span> Loading subscription...</div>
        </div>
    </section>

    <!-- Available Plans -->
    <section class="glass-card">
        <h3>Available Plans</h3>
        <p>Choose a plan that fits your needs. Upgrade or downgrade at any time.</p>
        <div id="plansList" class="plans-list">
            <div class="state"><span class="spinner" aria-hidden="true"></span> Loading plans...</div>
        </div>
    </section>
</div>

<script>
(function() {
    const API_BASE = window.location.hostname.includes('fabrixly.com') ? `/api` : `http://${window.location.hostname}:4000/api`;
    const getAuthHeaders = () => ({
        'Authorization': `Bearer ${localStorage.getItem('token')}`,
        'Content-Type': 'application/json'
    });

    function getUserRole() {
        const token = localStorage.getItem('token');
        if (!token) return 'USER';
        try {
            const payload = JSON.parse(atob(token.split('.')[1]));
            return payload.internal_role || 'USER';
        } catch (e) {
            return 'USER';
        }
    }

    let activePlanId = null;

    async function loadCurrentSubscription() {
        const container = document.getElementById('currentSubscription');
        try {
            const res = await fetch(`${API_BASE}/subscriptions/me`, { headers: getAuthHeaders() });
            if (!res.ok) {
                container.innerHTML = '<div class="state">No active subscription. You are on the trial plan.</div>';
                activePlanId = null;
                return;
            }
            const sub = await res.json();
            activePlanId = sub.plan_id;
            container.innerHTML = `
                <div class="subscription-details">
                    <div class="subscription-detail">
                        <span class="sd-label">Plan</span>
                        <span class="sd-value">${escapeHtml(sub.plan_name)}</span>
                    </div>
                    <div class="subscription-detail">
                        <span class="sd-label">Status</span>
                        <span class="sd-value"><span class="badge badge-ok">${escapeHtml(sub.status)}</span></span>
                    </div>
                    <div class="subscription-detail">
                        <span class="sd-label">Price</span>
                        <span class="sd-value">$${escapeHtml(String(sub.price_monthly))}/mo</span>
                    </div>
                    <div class="subscription-detail">
                        <span class="sd-label">Started</span>
                        <span class="sd-value">${new Date(sub.start_date).toLocaleDateString()}</span>
                    </div>
                </div>
            `;
        } catch (err) {
            container.innerHTML = '<div class="state err">Error loading subscription.</div>';
        }
    }

    let allPlans = [];

    async function loadPlans() {
        const container = document.getElementById('plansList');
        try {
            const res = await fetch(`${API_BASE}/plans`, { headers: getAuthHeaders() });
            if (!res.ok) throw new Error('Failed to load plans');
            const plans = await res.json();
            allPlans = plans;
            renderPlans(plans);
        } catch (err) {
            container.innerHTML = '<div class="state err">Error loading plans.</div>';
        }
    }

    function renderPlans(plans) {
        const container = document.getElementById('plansList');
        if (!plans || plans.length === 0) {
            container.innerHTML = '<div class="state">No plans available.</div>';
            return;
        }

        const currentActiveId = activePlanId || plans.find(p => p.is_default)?.id;
        const userRole = getUserRole();
        const activePlan = plans.find(p => p.id === activePlanId);
        const isSelfHostSub = activePlan && activePlan.name === 'selfhost';

        container.innerHTML = plans.map(plan => {
            const limits = plan.limits || {};
            const features = plan.features || {};
            
            // Non-admin users see all non-trial plans as "Custom Plan"
            const showAsCustom = plan.is_custom || (userRole !== 'ADMIN' && plan.name !== 'trial');
            const isActive = plan.id === currentActiveId;

            let limitsHtml = '';
            if (limits.max_tenants !== undefined) {
                limitsHtml += `<li>${limits.max_tenants === -1 ? 'Unlimited' : limits.max_tenants} Tenants</li>`;
            }
            if (limits.max_connections !== undefined) {
                limitsHtml += `<li>${limits.max_connections === -1 ? 'Unlimited' : limits.max_connections} Connections</li>`;
            }
            if (limits.max_tables !== undefined) {
                limitsHtml += `<li>${limits.max_tables === -1 ? 'Unlimited' : limits.max_tables} Tables</li>`;
            }
            if (limits.max_triggers !== undefined) {
                limitsHtml += `<li>${limits.max_triggers === -1 ? 'Unlimited' : limits.max_triggers} Triggers</li>`;
            }
            if (limits.rate_limit_per_min !== undefined) {
                limitsHtml += `<li>${limits.rate_limit_per_min === -1 ? 'Unlimited' : limits.rate_limit_per_min} Req/min</li>`;
            }

            let actionHtml = '';
            if (isActive) {
                actionHtml = `<button class="btn-outline btn-disabled" disabled>Current Plan</button>`;
            } else if (showAsCustom) {
                actionHtml = `<button class="btn-outline" onclick="window.location.href='mailto:fabric@fabrixly.com?subject=Inquiry%20about%20${encodeURIComponent(plan.name)}%20plan'">Contact Us</button>`;
            } else if (isSelfHostSub) {
                actionHtml = `<button class="btn-outline btn-disabled" disabled>Locked (Selfhost Active)</button>`;
            } else {
                actionHtml = `<button class="btn-primary" onclick="activatePlan('${plan.id}', '${escapeHtml(plan.name)}')">Activate Plan</button>`;
            }

            if (userRole === 'ADMIN' && !isSelfHostSub) {
                actionHtml += `<button class="btn-outline" onclick="openEditModal('${plan.id}')">Edit Plan</button>`;
            }

            const planTitle = showAsCustom ? 'Custom Plan' : plan.name;
            const planDescription = features.description || plan.description || '';

            return `
                <div class="plan-card ${isActive ? 'active-plan' : ''}">
                    ${isActive ? '<div class="plan-badge">Current</div>' : (showAsCustom ? '<div class="plan-badge custom">Custom</div>' : '')}
                    <h4>${escapeHtml(planTitle)}</h4>
                    <div class="plan-price">$${plan.price_monthly}<span>/month</span></div>
                    <div class="plan-description">${escapeHtml(planDescription)}</div>
                    <div class="plan-limits">
                        <h5>Limits</h5>
                        <ul>${limitsHtml || '<li>Contact for details</li>'}</ul>
                    </div>
                    <div class="plan-actions">${actionHtml}</div>
                </div>
            `;
        }).join('');
    }

    window.activatePlan = async function(planId, planName) {
        if (!confirm(`Are you sure you want to activate the "${planName}" plan?`)) return;
        
        try {
            const res = await fetch(`${API_BASE}/subscriptions/me`, {
                method: 'POST',
                headers: getAuthHeaders(),
                body: JSON.stringify({ plan_id: planId, status: 'active' })
            });
            
            if (!res.ok) {
                const err = await res.json();
                throw new Error(err.error || 'Failed to activate plan');
            }
            
            alert(`Successfully activated ${planName} plan!`);
            await loadCurrentSubscription();
            await loadPlans();
        } catch (err) {
            alert('Error activating plan: ' + err.message);
        }
    };

    window.openEditModal = function(planId) {
        const plan = allPlans.find(p => p.id === planId);
        if (!plan) return;
        
        document.getElementById('editPlanId').value = plan.id;
        document.getElementById('editPlanName').value = plan.name;
        document.getElementById('editPlanPrice').value = plan.price_monthly;
        document.getElementById('editPlanDescription').value = plan.features?.description || '';
        
        const limits = plan.limits || {};
        document.getElementById('editPlanMaxTenants').value = limits.max_tenants !== undefined ? limits.max_tenants : -1;
        document.getElementById('editPlanMaxConnections').value = limits.max_connections !== undefined ? limits.max_connections : -1;
        document.getElementById('editPlanMaxTables').value = limits.max_tables !== undefined ? limits.max_tables : -1;
        document.getElementById('editPlanMaxTriggers').value = limits.max_triggers !== undefined ? limits.max_triggers : -1;
        document.getElementById('editPlanMaxReplications').value = limits.max_replications !== undefined ? limits.max_replications : -1;
        document.getElementById('editPlanMaxReplicationTables').value = limits.max_replication_tables !== undefined ? limits.max_replication_tables : -1;
        document.getElementById('editPlanMaxReplicationRows').value = limits.max_replication_rows !== undefined ? limits.max_replication_rows : -1;
        document.getElementById('editPlanMaxReplicationRowsPerTable').value = limits.max_replication_rows_per_table !== undefined ? limits.max_replication_rows_per_table : -1;
        document.getElementById('editPlanRateLimitPerMonth').value = limits.rate_limit_per_month !== undefined ? limits.rate_limit_per_month : -1;
        document.getElementById('editPlanDataCleanupFrequency').value = limits.data_cleanup_frequency !== undefined ? limits.data_cleanup_frequency : 'none';
        document.getElementById('editPlanDataCleanupHour').value = limits.data_cleanup_hour !== undefined ? limits.data_cleanup_hour : 2;
        
        document.getElementById('editPlanModal').classList.add('active');
    };

    window.closeEditModal = function() {
        document.getElementById('editPlanModal').classList.remove('active');
    };

    window.savePlanChanges = async function() {
        const planId = document.getElementById('editPlanId').value;
        const name = document.getElementById('editPlanName').value;
        const price_monthly = parseFloat(document.getElementById('editPlanPrice').value);
        const description = document.getElementById('editPlanDescription').value;
        
        const max_tenants = parseInt(document.getElementById('editPlanMaxTenants').value);
        const max_connections = parseInt(document.getElementById('editPlanMaxConnections').value);
        const max_tables = parseInt(document.getElementById('editPlanMaxTables').value);
        const max_triggers = parseInt(document.getElementById('editPlanMaxTriggers').value);
        const max_replications = parseInt(document.getElementById('editPlanMaxReplications').value);
        const max_replication_tables = parseInt(document.getElementById('editPlanMaxReplicationTables').value);
        const max_replication_rows = parseInt(document.getElementById('editPlanMaxReplicationRows').value);
        const max_replication_rows_per_table = parseInt(document.getElementById('editPlanMaxReplicationRowsPerTable').value);
        const rate_limit_per_month = parseInt(document.getElementById('editPlanRateLimitPerMonth').value);
        const data_cleanup_frequency = document.getElementById('editPlanDataCleanupFrequency').value;
        const data_cleanup_hour = parseInt(document.getElementById('editPlanDataCleanupHour').value);
        
        const plan = allPlans.find(p => p.id === planId);
        if (!plan) return;
        
        const limits = {
            ...(plan.limits || {}),
            max_tenants,
            max_connections,
            max_tables,
            max_triggers,
            max_replications,
            max_replication_tables,
            max_replication_rows,
            max_replication_rows_per_table,
            rate_limit_per_month,
            data_cleanup_frequency,
            data_cleanup_hour
        };
        
        const features = {
            ...(plan.features || {}),
            description
        };
        
        try {
            const res = await fetch(`${API_BASE}/plans/${planId}`, {
                method: 'PUT',
                headers: getAuthHeaders(),
                body: JSON.stringify({
                    name,
                    price_monthly,
                    limits,
                    features
                })
            });
            
            if (!res.ok) {
                const err = await res.json();
                throw new Error(err.error || 'Failed to update plan');
            }
            
            alert('Plan updated successfully!');
            closeEditModal();
            await loadCurrentSubscription();
            await loadPlans();
        } catch (err) {
            alert('Error updating plan: ' + err.message);
        }
    };

    function escapeHtml(text) {
        if (!text) return '';
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }

    async function init() {
        await loadCurrentSubscription();
        await loadPlans();
    }
    init();
})();
</script>

<!-- Edit Plan Modal (Admin only modal container) -->
<div id="editPlanModal" class="modal-overlay" role="dialog" aria-modal="true" aria-labelledby="editPlanTitle">
    <div class="modal-card lg">
        <div class="modal-header">
            <h3 id="editPlanTitle">Customize Plan Details</h3>
            <button type="button" class="modal-close" onclick="closeEditModal()" aria-label="Close dialog">&times;</button>
        </div>
        <div class="modal-body">
            <input type="hidden" id="editPlanId">
            <div class="field"><label for="editPlanName">Plan Name</label><input type="text" id="editPlanName" required></div>
            <div class="field"><label for="editPlanPrice">Monthly Price ($)</label><input type="number" id="editPlanPrice" step="0.01" required></div>
            <div class="field"><label for="editPlanDescription">Description / Text</label><input type="text" id="editPlanDescription"></div>
            <div class="form-grid">
                <div class="field"><label for="editPlanMaxTenants">Max Tenants</label><input type="number" id="editPlanMaxTenants" required></div>
                <div class="field"><label for="editPlanMaxConnections">Max Connections</label><input type="number" id="editPlanMaxConnections" required></div>
                <div class="field"><label for="editPlanMaxTables">Max Tables</label><input type="number" id="editPlanMaxTables" required></div>
                <div class="field"><label for="editPlanMaxTriggers">Max Triggers</label><input type="number" id="editPlanMaxTriggers" required></div>
                <div class="field"><label for="editPlanMaxReplications">Max Replications</label><input type="number" id="editPlanMaxReplications" required></div>
                <div class="field"><label for="editPlanMaxReplicationTables">Max Rep Tables</label><input type="number" id="editPlanMaxReplicationTables" required></div>
                <div class="field"><label for="editPlanMaxReplicationRows">Max Rep Rows (Total)</label><input type="number" id="editPlanMaxReplicationRows" required></div>
                <div class="field"><label for="editPlanMaxReplicationRowsPerTable">Max Rep Rows Per Table</label><input type="number" id="editPlanMaxReplicationRowsPerTable" required></div>
            </div>
            <div class="field"><label for="editPlanRateLimitPerMonth">Requests Per Month Limit</label><input type="number" id="editPlanRateLimitPerMonth" required></div>
            <div class="form-grid">
                <div class="field">
                    <label for="editPlanDataCleanupFrequency">Data Cleanup Frequency</label>
                    <select id="editPlanDataCleanupFrequency">
                        <option value="none">None</option>
                        <option value="daily">Daily</option>
                        <option value="weekly">Weekly (Sunday)</option>
                    </select>
                </div>
                <div class="field"><label for="editPlanDataCleanupHour">Cleanup Hour (0-23)</label><input type="number" id="editPlanDataCleanupHour" min="0" max="23" required></div>
            </div>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn-outline" onclick="closeEditModal()">Cancel</button>
            <button type="button" class="btn-primary" onclick="savePlanChanges()">Save Changes</button>
        </div>
    </div>
</div>

<%- include('partials/footer') %>
