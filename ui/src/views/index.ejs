<script>
  // ── SSO redirect: all login buttons go directly to the SSO endpoint ──
  const API_BASE_URL = window.location.hostname.includes('fabrixly.com')
      ? `/api`
      : `http://${window.location.hostname}:4000/api`;

  function redirectToSSO() {
    window.location.href = `${API_BASE_URL}/auth/sso`;
  }

  document.getElementById('heroLoginBtn').addEventListener('click', redirectToSSO);
  document.getElementById('navLoginBtn').addEventListener('click', redirectToSSO);
  document.getElementById('ctaLoginBtn').addEventListener('click', redirectToSSO);

  // If already logged in, swap nav button to "Go to Dashboard"
  if (localStorage.getItem('token')) {
    document.getElementById('navLoginBtn').style.display = 'none';
    document.getElementById('navDashBtn').style.display = 'inline-flex';
    document.getElementById('heroLoginBtn').textContent = 'Go to Dashboard →';
    document.getElementById('heroLoginBtn').addEventListener('click', () => {
      window.location.href = '/dashboard';
    }, { once: true });
    document.getElementById('ctaLoginBtn').textContent = 'Go to Dashboard →';
    document.getElementById('ctaLoginBtn').addEventListener('click', () => {
      window.location.href = '/dashboard';
    }, { once: true });
  }

  // Handle SSO callback token (IDS redirects back here with ?token=...)
  const params = new URLSearchParams(window.location.search);
  const token = params.get('token');
  if (token) {
    localStorage.setItem('token', token);
    window.location.href = '/dashboard';
  }
</script>

