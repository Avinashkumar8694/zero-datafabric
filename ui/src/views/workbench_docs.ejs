<%- include('partials/header') %>

<div class="docs-layout fade-in">
    <!-- Left Navigation Sidebar -->
    <aside class="docs-nav" aria-label="Documentation index">
        <div class="docs-nav-title">Integration &amp; APIs</div>
        <ul class="docs-nav-list">
            <% docList.forEach(doc => { %>
                <li>
                    <a href="/workbench/docs?doc=<%= doc.id %>"
                       class="docs-nav-link <%= currentDoc === doc.id ? 'active' : '' %>"
                       <%- currentDoc === doc.id ? 'aria-current="page"' : '' %>
                       title="<%= doc.title %>">
                        <%= doc.title %>
                    </a>
                </li>
            <% }) %>
        </ul>
    </aside>

    <!-- Right Reading Pane -->
    <main class="docs-content">
        <div class="markdown-body">
            <%- htmlContent %>
        </div>
    </main>
</div>

<%- include('partials/footer') %>
