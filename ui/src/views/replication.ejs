<%- include('partials/header') %>

<div class="page fade-in">
  <div class="page-head">
    <div>
      <h1 class="page-title">Replication</h1>
      <p class="page-sub">Copy a data source into another source (destination = PostgreSQL). One-way today; disaster-recovery restore replays a replica back into a chosen source. Distinct from the fabric's inbound SYNC/CDC (which loads a source into the hub for querying).</p>
    </div>
    <div class="page-actions"><button type="button" class="btn-primary" onclick="openRepl()"><i class="fas fa-plus" aria-hidden="true"></i> Create Replication</button></div>
  </div>

  <section class="glass-card">
    <div class="card-head"><h3>Replication jobs</h3></div>
    <div class="table-wrapper">
      <table>
        <thead><tr><th>Job</th><th>Source → Destination</th><th>Strategy</th><th>Schedule</th><th>Last run</th><th>Actions</th></tr></thead>
        <tbody id="replBody"><tr><td colspan="6" class="state-cell">Loading…</td></tr></tbody>
      </table>
    </div>
  </section>

  <section class="glass-card">
    <div class="card-head">
      <div>
        <h3>Replication analytics</h3>
        <p>Live copy-job throughput, success rate, and per-job % completion. The fabric assigns jobs; the replication microservice executes and reports progress here.</p>
      </div>
    </div>
    <div id="analyticsCards" class="stat-grid"></div>
    <div id="activeJobs"></div>
  </section>

  <section class="glass-card">
    <div class="card-head">
      <div>
        <h3>Copy-job runs</h3>
        <p>Every SYNC / CDC / REPLICATE / RESTORE is assigned to the replication microservice as a job. This is the queue the worker processes.</p>
      </div>
      <div class="card-actions"><button type="button" class="btn-outline btn-sm" onclick="loadRuns(); loadAnalytics();"><i class="fas fa-sync" aria-hidden="true"></i> Refresh</button></div>
    </div>
    <div class="table-wrapper">
      <table>
        <thead><tr><th>Kind</th><th>Target</th><th>Status</th><th>Progress</th><th>Config</th><th>Attempts</th><th>Updated</th><th>Actions</th></tr></thead>
        <tbody id="runsBody"><tr><td colspan="8" class="state-cell">Loading…</td></tr></tbody>
      </table>
    </div>
  </section>
</div>

<!-- Create job modal -->
<div id="replModal" class="modal-overlay" role="dialog" aria-modal="true" aria-labelledby="replModalTitle"><div class="modal-card lg">
  <div class="modal-header"><h3 id="replModalTitle">New replication job</h3><button type="button" class="modal-close" onclick="closeRepl()" aria-label="Close dialog">&times;</button></div>
  <div class="modal-body">
    <div class="field"><label for="rfName">Job name</label><input id="rfName" placeholder="e.g. mysql_to_warehouse"></div>
    <div class="field"><label for="rfSource">Source (read from)</label><select id="rfSource"></select></div>
    <div class="field"><label for="rfDest">Destination: same engine as source for <b>DR</b> (PG/MySQL/Mongo to same), or <b>Elasticsearch</b> for fast search</label><select id="rfDest"></select></div>
    <div class="cols-2">
      <div class="field"><label for="rfStrategy">Strategy</label><select id="rfStrategy" onchange="rfToggle()"><option value="FULL">FULL (copy all, reload)</option><option value="INCREMENTAL">INCREMENTAL (watermark; inserts/updates)</option><option value="CDC">CDC (snapshot + full CRUD incl. deletes)</option></select></div>
      <div class="field"><label for="rfDestSchema">Target schema/db (blank = mirror all source schemas)</label><input id="rfDestSchema" placeholder="blank = full replica, mirror source structure"></div>
    </div>
    <div id="rfCdcHint" class="note" style="display:none;">
      <b>CDC</b> captures full CRUD incl. <b>deletes</b> (snapshot + change stream). Native per engine: <b>PostgreSQL/MySQL</b> (trigger+outbox), <b>MongoDB</b> (change streams, needs a replica set). Oracle/Snowflake/Elasticsearch: use FULL (scheduled reload) or INCREMENTAL (watermark) for now.
    </div>
    <div id="rfCdcField" class="field" style="display:none;"><label for="rfCdc">Watermark column (blank = auto-detect)</label><input id="rfCdc" placeholder="blank = smart auto-detect (e.g. updated_at / id)"></div>
    <div id="rfInitField" class="field" style="display:none;"><label for="rfInitialLoad">Initial load (first run)</label>
      <select id="rfInitialLoad">
        <option value="FULL">FULL: load all existing rows now, then track deltas</option>
        <option value="NONE">ONLY NEW: copy nothing now; capture only new/changed rows from now</option>
      </select></div>
    <div class="field"><label for="rfSchedule">Schedule (ms, optional)</label><input id="rfSchedule" placeholder="blank = manual only; e.g. 300000 = every 5 min"></div>
    <div class="divider-top">
      <div class="section-label">Copy configuration (worker)</div>
      <div class="cols-3">
        <div class="field"><label for="rfPageSize">Page size (rows/batch)</label><input id="rfPageSize" type="number" min="1" placeholder="default 1000"></div>
        <div class="field"><label for="rfMemCeil">Memory ceiling (MB)</label><input id="rfMemCeil" type="number" min="64" placeholder="default 1024"></div>
        <div class="field"><label for="rfMaxRows">Max rows (cap)</label><input id="rfMaxRows" type="number" min="1" placeholder="default 5000000"></div>
      </div>
    </div>
  </div>
  <div class="modal-footer">
    <button type="button" class="btn-outline" onclick="closeRepl()">Cancel</button>
    <button type="button" class="btn-primary" onclick="saveRepl()">Create</button>
  </div>
</div></div>

<!-- Restore (DR) modal -->
<div id="restoreModal" class="modal-overlay" role="dialog" aria-modal="true" aria-labelledby="restoreModalTitle"><div class="modal-card">
  <div class="modal-header"><h3 id="restoreModalTitle">Disaster recovery: restore replica</h3><button type="button" class="modal-close" onclick="closeRestore()" aria-label="Close dialog">&times;</button></div>
  <div class="modal-body">
    <p class="mb-2">Replays the destination replica back into the chosen source. The target source must be writable (PostgreSQL).</p>
    <div class="field"><label for="rsTarget">Restore INTO source</label><select id="rsTarget"></select></div>
  </div>
  <div class="modal-footer"><button type="button" class="btn-outline" onclick="closeRestore()">Cancel</button><button type="button" class="btn-primary btn-danger-solid" onclick="doRestore()">Restore</button></div>
</div></div>

<script>
  let SOURCES = [];
  async function loadSources() {
    try { SOURCES = await (await fetch(`${API_BASE}/admin/connections`, { headers: getAuthHeaders() })).json(); }
    catch { SOURCES = []; }
    if (!Array.isArray(SOURCES)) SOURCES = [];
  }
  function opts(list) { return list.map(s => `<option value="${escapeHtml(s.name)}">${escapeHtml(s.name)} (${escapeHtml((s.type||'').toUpperCase())})</option>`).join(''); }
  function rfToggle() {
    const s = document.getElementById('rfStrategy').value; const inc = s === 'INCREMENTAL';
    document.getElementById('rfCdcField').style.display = inc ? '' : 'none';
    document.getElementById('rfInitField').style.display = inc ? '' : 'none';
    document.getElementById('rfCdcHint').style.display = s === 'CDC' ? 'block' : 'none';
  }
  // Guard: CDC requires a Postgres/MySQL source (trigger-based capture).
  function cdcSourceOk() {
    const s = SOURCES.find(x => x.name === document.getElementById('rfSource').value);
    return !s || ['POSTGRES','POSTGRESQL','MYSQL','MONGODB','MONGO'].includes((s.type||'').toUpperCase());
  }

  async function loadJobs() {
    const body = document.getElementById('replBody');
    body.innerHTML = '<tr><td colspan="6" class="state-cell">Loading…</td></tr>';
    try {
      const jobs = await (await fetch(`${API_BASE}/replication`, { headers: getAuthHeaders() })).json();
      if (!Array.isArray(jobs) || !jobs.length) { body.innerHTML = '<tr><td colspan="6" class="state-cell">No replication jobs yet.</td></tr>'; return; }
      body.innerHTML = jobs.map(j => `
        <tr class="fade-in">
          <td><b>${escapeHtml(j.name)}</b></td>
          <td><code>${escapeHtml(j.source_name)}</code> → <code>${escapeHtml(j.dest_name)}</code> <span class="text-muted small">${escapeHtml(j.dest_schema||'public')}</span></td>
          <td><span class="badge badge-info">${escapeHtml(j.strategy)}</span>${j.cdc_column?` <span class="text-muted small">on ${escapeHtml(j.cdc_column)}</span>`:''}</td>
          <td>${j.schedule_ms?escapeHtml(j.schedule_ms+'ms'):'<span class="text-muted">manual</span>'}</td>
          <td>${j.last_run_at?`<span class="badge ${j.last_status==='SUCCESS'?'badge-ok':'badge-warn'}">${escapeHtml(j.last_status||'')}</span><div class="text-muted small">${escapeHtml(new Date(j.last_run_at).toLocaleString())}</div>`:'<span class="text-muted">never</span>'}</td>
          <td><div class="row-actions">
            <button class="btn-outline btn-sm" onclick="runRepl('${escapeJs(j.id)}')" title="Run now (incremental delta, or first-run per initial-load)"><i class="fas fa-play" aria-hidden="true"></i> Run</button>
            <button class="btn-outline btn-sm" onclick="runRepl('${escapeJs(j.id)}', true)" title="Full sync now: reload all rows"><i class="fas fa-database" aria-hidden="true"></i> Full sync</button>
            <button class="btn-outline btn-sm" onclick="openRestore('${escapeJs(j.id)}')"><i class="fas fa-life-ring" aria-hidden="true"></i> Restore</button>
            <button class="btn-outline btn-sm btn-danger" aria-label="Delete job" onclick="delRepl('${escapeJs(j.id)}')"><i class="fas fa-trash-alt" aria-hidden="true"></i></button>
          </div></td>
        </tr>`).join('');
    } catch (e) { body.innerHTML = '<tr><td colspan="6" class="state-cell text-danger">Failed to load jobs</td></tr>'; }
  }

  function openRepl() {
    document.getElementById('rfSource').innerHTML = opts(SOURCES);
    document.getElementById('rfDest').innerHTML = opts(SOURCES.filter(s => ['POSTGRES','POSTGRESQL','ELASTICSEARCH','ELASTIC','ES','MONGODB','MONGO','MYSQL'].includes((s.type||'').toUpperCase())));
    rfToggle();
    document.getElementById('replModal').classList.add('active');
  }
  function closeRepl() { document.getElementById('replModal').classList.remove('active'); }
  function closeRestore() { document.getElementById('restoreModal').classList.remove('active'); }

  async function saveRepl() {
    const body = {
      name: document.getElementById('rfName').value.trim(),
      sourceName: document.getElementById('rfSource').value,
      destName: document.getElementById('rfDest').value,
      strategy: document.getElementById('rfStrategy').value,
      destSchema: document.getElementById('rfDestSchema').value.trim() || undefined,   // blank = mirror all source schemas
      cdcColumn: document.getElementById('rfCdc').value.trim() || undefined,
      initialLoad: document.getElementById('rfInitialLoad').value,
      scheduleMs: parseInt(document.getElementById('rfSchedule').value) || undefined,
      pageSize: parseInt(document.getElementById('rfPageSize').value) || undefined,
      memCeilingMb: parseInt(document.getElementById('rfMemCeil').value) || undefined,
      maxRows: parseInt(document.getElementById('rfMaxRows').value) || undefined,
    };
    if (!body.name || !body.sourceName || !body.destName) return showModal('Missing', 'Name, source and destination are required.');
    if (body.strategy === 'CDC' && !cdcSourceOk()) return showModal('CDC not supported for this source', 'CDC (trigger-based full-CRUD capture) currently requires a PostgreSQL or MySQL source. For other engines use FULL (scheduled reload) or INCREMENTAL (watermark).');
    const res = await fetch(`${API_BASE}/replication`, { method: 'POST', headers: getAuthHeaders(), body: JSON.stringify(body) });
    const d = await res.json();
    if (!res.ok) return showModal('Create failed', d.error);
    closeRepl(); loadJobs();
  }

  const STATUS_BADGE = { QUEUED:'badge-info', RUNNING:'badge-warn', COMPLETED:'badge-ok', FAILED:'badge-danger' };

  // Poll a queued copy-job run until it reaches a terminal state, then summarize.
  async function pollRun(runId, title) {
    for (let i = 0; i < 150; i++) {
      let run;
      try { run = await (await fetch(`${API_BASE}/replication/runs/${runId}`, { headers: getAuthHeaders() })).json(); }
      catch { await new Promise(r => setTimeout(r, 1500)); continue; }
      loadRuns();
      if (run.status === 'COMPLETED' || run.status === 'FAILED') {
        const r = run.result || {};
        const total = (r.tables||[]).reduce((n,t)=>n+(t.rows||0),0);
        const body = run.status === 'COMPLETED'
          ? `<b>${total}</b> rows across ${(r.tables||[]).length} table(s):<br>${(r.tables||[]).map(t=>`${escapeHtml(t.table||'')}: ${t.rows}`).join('<br>')}`
          : `<span class="text-danger">${escapeHtml(run.error || 'failed')}</span>`;
        return showModal(`${title} — ${run.status}`, body);
      }
      showModal(`${title}…`, `Worker status: <b>${escapeHtml(run.status)}</b> (attempt ${run.attempts||0})…`);
      await new Promise(r => setTimeout(r, 1500));
    }
    showModal(title, 'Still running — check the Copy-job runs panel.');
  }

  async function runRepl(id, full) {
    showModal('Queuing…', full ? 'Assigning a FULL sync to the worker…' : 'Assigning the replication job to the worker…');
    const res = await fetch(`${API_BASE}/replication/${id}/run`, { method: 'POST', headers: getAuthHeaders(), body: JSON.stringify({ full: !!full }) });
    const d = await res.json();
    if (!res.ok) return showModal('Run failed', d.error);
    loadRuns(); loadJobs();
    pollRun(d.runId, 'Replication');
  }

  let restoreId = null;
  function openRestore(id) {
    restoreId = id;
    document.getElementById('rsTarget').innerHTML = opts(SOURCES.filter(s => ['POSTGRES','POSTGRESQL','MONGODB','MONGO','MYSQL'].includes((s.type||'').toUpperCase())));
    document.getElementById('restoreModal').classList.add('active');
  }
  async function doRestore() {
    const target = document.getElementById('rsTarget').value;
    closeRestore();
    showModal('Queuing restore…', `Assigning the restore job (replica → <code>${escapeHtml(target)}</code>) to the worker…`);
    const res = await fetch(`${API_BASE}/replication/${restoreId}/restore`, { method: 'POST', headers: getAuthHeaders(), body: JSON.stringify({ targetSource: target }) });
    const d = await res.json();
    if (!res.ok) return showModal('Restore failed', d.error);
    loadRuns(); loadJobs();
    pollRun(d.runId, 'Disaster-recovery restore');
  }

  function progressBar(pct, label) {
    const p = Math.max(0, Math.min(100, Number(pct)||0));
    return `<div class="progress-wrap"><div class="progress" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="${p}"><i style="width:${p}%"></i></div><div class="progress-label">${label}</div></div>`;
  }
  function fmtRows(n){ n=Number(n||0); return n>=1000? (n/1000).toFixed(n>=100000?0:1)+'k' : String(n); }

  async function loadRuns() {
    const body = document.getElementById('runsBody');
    try {
      const runs = await (await fetch(`${API_BASE}/replication/runs`, { headers: getAuthHeaders() })).json();
      if (!Array.isArray(runs) || !runs.length) { body.innerHTML = '<tr><td colspan="8" class="state-cell">No runs yet.</td></tr>'; return; }
      body.innerHTML = runs.map(r => {
        const cfg = r.config || {};
        const cfgStr = [cfg.pageSize && `page ${cfg.pageSize}`, cfg.memCeilingMb && `${cfg.memCeilingMb}MB`, cfg.maxRows && `cap ${cfg.maxRows}`].filter(Boolean).join(', ') || '<span class="text-muted">defaults</span>';
        const pctLabel = `${fmtRows(r.rows_copied)}${r.rows_total>0?'/'+fmtRows(r.rows_total):''} rows · ${r.tables_done||0}/${r.tables_total||0} tbl`;
        const prog = ['RUNNING','PAUSED','QUEUED'].includes(r.status) || r.status==='COMPLETED'
          ? progressBar(r.status==='COMPLETED'?100:r.progress_pct, pctLabel)
          : (r.status==='FAILED' ? `<span class="text-danger small">${escapeHtml((r.error||'').slice(0,80))}</span>` : '');
        let actions = '';
        if (r.status === 'RUNNING' || r.status === 'QUEUED') actions = `<button class="btn-outline btn-sm" aria-label="Pause run" onclick="pauseRun('${escapeJs(r.id)}')"><i class="fas fa-pause" aria-hidden="true"></i></button>`;
        else if (r.status === 'PAUSED' || r.status === 'FAILED') actions = `<button class="btn-outline btn-sm" onclick="resumeRun('${escapeJs(r.id)}')"><i class="fas fa-play" aria-hidden="true"></i> Resume</button>`;
        return `<tr class="fade-in">
          <td><span class="badge badge-info">${escapeHtml(r.kind)}</span></td>
          <td><code>${escapeHtml(r.job_ref)}</code>${r.target_source?` → <code>${escapeHtml(r.target_source)}</code>`:''}</td>
          <td><span class="badge ${STATUS_BADGE[r.status]||'badge-muted'}">${escapeHtml(r.status)}</span></td>
          <td>${prog}</td>
          <td class="small">${cfgStr}</td>
          <td>${r.attempts||0}/${r.max_attempts||3}</td>
          <td class="text-muted small">${r.updated_at?escapeHtml(new Date(r.updated_at).toLocaleString()):''}</td>
          <td>${actions}</td>
        </tr>`;
      }).join('');
    } catch { body.innerHTML = '<tr><td colspan="8" class="state-cell text-danger">Failed to load runs</td></tr>'; }
  }

  function card(label, value, sub) {
    return `<div class="stat-card"><span class="stat-label">${escapeHtml(label)}</span><span class="stat-value">${value}</span>${sub?`<span class="stat-sub">${escapeHtml(sub)}</span>`:''}</div>`;
  }
  async function loadAnalytics() {
    try {
      const a = await (await fetch(`${API_BASE}/replication/analytics`, { headers: getAuthHeaders() })).json();
      const s = a.byStatus || {};
      document.getElementById('analyticsCards').innerHTML =
        card('Total rows copied', fmtRows(a.totalRowsCopied)) +
        card('Success rate', a.successRate==null?'—':a.successRate+'%', `${(s.COMPLETED?.jobs)||0} ok / ${(s.FAILED?.jobs)||0} failed`) +
        card('Running', (s.RUNNING?.jobs)||0) +
        card('Queued', (s.QUEUED?.jobs)||0) +
        card('Paused', (s.PAUSED?.jobs)||0) +
        card('Completed', (s.COMPLETED?.jobs)||0);
      const active = a.active || [];
      document.getElementById('activeJobs').innerHTML = active.length ? active.map(j => {
        const eta = j.eta_seconds!=null ? ` · ETA ${j.eta_seconds}s` : '';
        const rps = j.throughput_rps ? ` · ${fmtRows(j.throughput_rps)}/s` : '';
        return `<div class="job-row">
          <span class="badge badge-info">${escapeHtml(j.kind)}</span>
          <code>${escapeHtml(j.job_ref)}</code>
          <div class="grow">${progressBar(j.status==='RUNNING'||j.status==='PAUSED'?j.progress_pct:0, `${escapeHtml(j.status)} · ${fmtRows(j.rows_copied)}${j.rows_total>0?'/'+fmtRows(j.rows_total):''} rows · ${j.tables_done||0}/${j.tables_total||0} tbl${rps}${eta}`)}</div>
          ${j.status==='RUNNING'||j.status==='QUEUED'?`<button class="btn-outline btn-sm" aria-label="Pause run" onclick="pauseRun('${escapeJs(j.id)}')"><i class="fas fa-pause" aria-hidden="true"></i></button>`:''}
          ${j.status==='PAUSED'?`<button class="btn-outline btn-sm" aria-label="Resume run" onclick="resumeRun('${escapeJs(j.id)}')"><i class="fas fa-play" aria-hidden="true"></i></button>`:''}
        </div>`;
      }).join('') : '<div class="text-muted small">No active jobs.</div>';
    } catch { /* best-effort */ }
  }

  async function pauseRun(id) {
    await fetch(`${API_BASE}/replication/runs/${id}/pause`, { method:'POST', headers: getAuthHeaders() });
    loadRuns(); loadAnalytics();
  }
  async function resumeRun(id) {
    await fetch(`${API_BASE}/replication/runs/${id}/resume`, { method:'POST', headers: getAuthHeaders() });
    loadRuns(); loadAnalytics();
  }

  async function delRepl(id) {
    if (!confirm('Delete this replication job?')) return;
    await fetch(`${API_BASE}/replication/${id}`, { method: 'DELETE', headers: getAuthHeaders() });
    loadJobs();
  }

  (async () => { await loadSources(); loadJobs(); loadRuns(); loadAnalytics(); })();
  // Live refresh of runs + analytics every 3s (progress bars, active jobs).
  setInterval(() => { loadRuns(); loadAnalytics(); }, 3000);
</script>

<%- include('partials/footer') %>
