<%- include('partials/header') %>

<div class="page full fade-in">
    <div class="page-head">
        <div>
            <h1 class="page-title">Explorer</h1>
            <p class="page-sub">Browse sources, schemas and resources; inspect properties, data preview, lineage, DDL and AST.</p>
        </div>
    </div>
<div class="studio">
    <!-- Sidebar: Hierarchical Tree -->
    <div class="studio-side">
        <div class="studio-side-head">
            <div class="studio-title-row">
                <h2 class="studio-title">Management Studio</h2>
                <button type="button" id="toggleTreeBtn" class="tree-toggle-mobile" aria-label="Toggle resource tree" onclick="toggleMobileTree()">
                    <i class="fas fa-chevron-up" id="treeToggleIcon" aria-hidden="true"></i>
                </button>
            </div>
            <div class="search-container">
                <i class="fas fa-search search-icon" aria-hidden="true"></i>
                <label for="catalogSearch" class="sr-only">Search resources</label>
                <input type="text" id="catalogSearch" placeholder="Search resources..." onkeyup="filterTree()">
            </div>
        </div>
        <div id="fabricTree" class="tree-view">
            <div class="state"><span class="spinner" aria-hidden="true"></span> Loading tree...</div>
        </div>
    </div>

    <!-- Main Panel: Tabbed Interface -->
    <div class="studio-main">
        <div id="welcomeView" class="view-panel active">
            <div class="welcome-content">
                <i class="fas fa-project-diagram welcome-icon"></i>
                <h2>Welcome to Fabric Management Studio</h2>
                <p>Select a resource from the tree to explore its properties, data, and technical lineage across the distributed fabric.</p>
            </div>
        </div>

        <div id="resourceView" class="view-panel">
            <div class="resource-header">
                <div class="resource-identity">
                    <i id="resIcon" class="fas fa-table res-header-icon"></i>
                    <div>
                        <h2 id="resName">Resource Name</h2>
                        <span id="resEngine" class="engine-badge">POSTGRESQL</span>
                    </div>
                </div>
                <div id="tabBar" class="resource-tabs tabs" role="tablist">
                    <!-- Dynamic Tabs -->
                </div>
            </div>

            <div class="tab-content" id="tab-properties">
                <div id="propertyCards" class="grid-layout">
                    <!-- Dynamic Property Cards -->
                </div>
                
                <!-- NEW: Columns Inspector -->
                <div id="columnsSection" class="meta-card full-width" style="display:none;">
                    <span class="meta-label">Schema & Constraints</span>
                    <div class="data-grid-container">
                        <table id="columnsGrid">
                            <thead>
                                <tr>
                                    <th>Column</th>
                                    <th>Type</th>
                                    <th>Strategy</th>
                                    <th>Nullable</th>
                                    <th>PK</th>
                                </tr>
                            </thead>
                            <tbody id="columnsBody"></tbody>
                        </table>
                    </div>
                </div>

                <div class="meta-card full-width">
                    <span class="meta-label">Technical Descriptor (Raw AST)</span>
                    <pre id="propRaw" class="code-block md">{}</pre>
                </div>
            </div>

            <div class="tab-content" id="tab-data" style="display:none;">
                <div class="data-toolbar">
                    <span>Showing top 50 rows</span>
                    <button type="button" class="btn-outline btn-sm" onclick="refreshData()"><i class="fas fa-sync" aria-hidden="true"></i> Refresh</button>
                </div>
                <div class="data-grid-container">
                    <table id="previewGrid">
                        <thead><tr id="gridHeader"></tr></thead>
                        <tbody id="gridBody"></tbody>
                    </table>
                </div>
            </div>

            <div class="tab-content" id="tab-lineage" style="display:none;">
                <div class="lineage-flow">
                    <div class="lineage-node">Source<br><small id="linSource">—</small></div>
                    <i class="fas fa-long-arrow-alt-right" aria-hidden="true"></i>
                    <div class="lineage-node highlight">Fabric Resource<br><small id="linLogical">—</small></div>
                    <i class="fas fa-long-arrow-alt-right" aria-hidden="true"></i>
                    <div class="lineage-node">Consumers<br><small id="linDownstream">query / API</small></div>
                </div>
            </div>

            <div class="tab-content" id="tab-ddl" style="display:none;">
                <pre id="ddlCode" class="language-sql">-- Generating DDL...</pre>
            </div>
            <div class="tab-content" id="tab-ast" style="display:none;">
                <pre id="astCode" class="language-json">-- Generating AST...</pre>
            </div>
        </div>
    </div>
</div>
</div>

<script>
    let allData = { sources: [], schemas: [], tables: [], currentTable: null };

    // Escape untrusted datasource / catalog values before inserting into the DOM.
    function escapeHtml(v) {
        if (v === null || v === undefined) return '';
        const s = typeof v === 'object' ? JSON.stringify(v) : String(v);
        return s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    }

    function toggleMobileTree() {
        const tree = document.getElementById('fabricTree');
        const icon = document.getElementById('treeToggleIcon');
        if (!tree || !icon) return;
        if (tree.style.display === 'none') {
            tree.style.display = 'block';
            icon.className = 'fas fa-chevron-up';
        } else {
            tree.style.display = 'none';
            icon.className = 'fas fa-chevron-down';
        }
    }

    async function loadTree() {
        const treeEl = document.getElementById('fabricTree');
        try {
            const sourcesRes = await fetch(`${API_BASE}/metadata/sources`, { headers: getAuthHeaders() });
            allData.sources = await sourcesRes.json();
            
            let html = '';
            for (const source of allData.sources) {
                html += `
                    <div class="tree-node"><i class="fas fa-server"></i> ${escapeHtml(source.name)} <small>(${escapeHtml(source.type)})</small></div>
                    <div id="source-${escapeHtml(source.id)}-schemas">
                        <div class="tree-note">Loading schemas...</div>
                    </div>
                `;
            }
            treeEl.innerHTML = html;

            // Now that containers exist, trigger loading
            for (const source of allData.sources) {
                loadSchemas(source.id);
            }
        } catch (e) {
            treeEl.innerHTML = '<p class="state err">Failed to load tree.</p>';
        }
    }

    async function loadSchemas(sourceId) {
        const schemaEl = document.getElementById(`source-${sourceId}-schemas`);
        try {
            const res = await fetch(`${API_BASE}/metadata/schemas?sourceId=${sourceId}`, { headers: getAuthHeaders() });
            const schemas = await res.json();
            
            schemaEl.innerHTML = schemas.map(s => `
                <div class="tree-item tree-sub-item" data-schema-id="${escapeHtml(s.schemaId)}" onclick="toggleSchema('${s.schemaId}', this)">
                    <i class="fas fa-folder"></i> ${escapeHtml(s.name)}
                </div>
                <div id="schema-${escapeHtml(s.schemaId)}-resources" style="display:none;"></div>
            `).join('') || '<div class="tree-note">No schemas</div>';
        } catch (e) { schemaEl.innerHTML = '<p class="tree-note text-danger">Error</p>'; }
    }

    async function toggleSchema(schemaId, el) {
        const resourceEl = document.getElementById(`schema-${schemaId}-resources`);
        const icon = el.querySelector('i');
        
        if (resourceEl.style.display === 'none') {
            resourceEl.style.display = 'block';
            icon.className = 'fas fa-folder-open';
            el.classList.add('active');
            
            if (!resourceEl.innerHTML) {
                resourceEl.innerHTML = '<div class="tree-note l3">Loading resources...</div>';
                const res = await fetch(`${API_BASE}/metadata/tables?schemaId=${schemaId}`, { headers: getAuthHeaders() });
                const resources = await res.json();
                
                // Manifest-Aligned Categorization
                const groups = resources.reduce((acc, r) => {
                    const type = r.resourceType + (r.resourceType.endsWith('S') ? '' : 'S'); 
                    if (!acc[type]) acc[type] = [];
                    acc[type].push(r);
                    return acc;
                }, {});

                let html = '';
                for (const [cat, items] of Object.entries(groups)) {
                    if (items.length > 0) {
                        html += `<div class="tree-cat">${escapeHtml(cat)}</div>`;
                        html += items.map(t => `
                            <div class="tree-item tree-res" data-table-id="${escapeHtml(t.tableId)}" data-schema-id="${escapeHtml(schemaId)}" onclick="selectResource('${t.tableId}', this, event)">
                                <i class="fas ${getIcon(t.resourceType)}"></i> ${escapeHtml(t.name)}
                            </div>
                        `).join('');
                    }
                }
                resourceEl.innerHTML = html || '<div class="tree-note l3">Empty</div>';
            }
        } else {
            resourceEl.style.display = 'none';
            icon.className = 'fas fa-folder';
            el.classList.remove('active');
        }
    }

    function getIcon(type) {
        switch(type) {
            case 'TABLE': return 'fa-table';
            case 'VIEW': return 'fa-eye';
            case 'MATERIALIZED_VIEW': return 'fa-bolt';
            case 'SEQUENCE': return 'fa-sort-numeric-up';
            case 'FUNCTION': return 'fa-code';
            case 'PROCEDURE': return 'fa-cogs';
            case 'ENUM': return 'fa-list-ul';
            case 'TRIGGER': return 'fa-running';
            case 'POLICY': return 'fa-shield-alt';
            default: return 'fa-cube';
        }
    }

    async function selectResource(tableId, el, event) {
        try {
            event.stopPropagation();
            document.querySelectorAll('.tree-item').forEach(i => i.classList.remove('active'));
            el.classList.add('active');
            
            document.getElementById('welcomeView').classList.remove('active');
            document.getElementById('resourceView').classList.add('active');
            if (window.innerWidth <= 960) {
                document.getElementById('resourceView')?.scrollIntoView({ behavior: 'smooth' });
            }
            
            // High-Fidelity Fetch: Resolve deep metadata for any resource type
            const res = await fetch(`${API_BASE}/metadata/resource/${tableId}`, { headers: getAuthHeaders() });
            if (!res.ok) throw new Error('Resource resolution failed');
            const resource = await res.json();
            
            allData.currentTable = resource;

            // Update Header
            document.getElementById('resName').innerText = resource.name;
            document.getElementById('resIcon').className = `fas ${getIcon(resource.resourceType)} res-header-icon`;
            // Use the real source engine returned by the API, not a name heuristic.
            const engine = (resource.sourceType || 'POSTGRES').toUpperCase();
            document.getElementById('resEngine').innerText = engine;

            // Populate the lineage flow with real values (was static placeholder text).
            const linSrc = document.getElementById('linSource');
            const linLog = document.getElementById('linLogical');
            if (linSrc) linSrc.innerText = `${resource.sourceName || 'Fabric'} · ${engine}`;
            if (linLog) linLog.innerText = `${resource.name} (${resource.resourceType})`;

            // Dynamic Tab Generation
            const tabs = [
                { id: 'properties', label: 'Properties', icon: 'fa-info-circle' }
            ];
            
            if (['TABLE', 'VIEW', 'MATERIALIZED_VIEW'].includes(resource.resourceType)) {
                tabs.push({ id: 'data', label: 'Data Preview', icon: 'fa-table' });
                tabs.push({ id: 'lineage', label: 'Lineage', icon: 'fa-link' });
            }
            
            tabs.push({ id: 'ddl', label: 'SQL DDL', icon: 'fa-code' });
            tabs.push({ id: 'ast', label: 'Fabric AST', icon: 'fa-project-diagram' });

            document.getElementById('tabBar').innerHTML = tabs.map(t => `
                <button type="button" role="tab" id="btn-${t.id}" class="tab-btn ${t.id === 'properties' ? 'active' : ''}" onclick="switchTab('${t.id}')">
                    <i class="fas ${t.icon}" aria-hidden="true"></i> ${t.label}
                </button>
            `).join('');

            // Dynamic Property Card Generation
            const ast = (resource.definitionAst && typeof resource.definitionAst === 'object') ? resource.definitionAst : null;
            let propHtml = `
                <div class="meta-card">
                    <span class="meta-label">General Information</span>
                    <div class="property-row"><span>Logical ID</span><code>${escapeHtml(resource.tableId)}</code></div>
                    <div class="property-row"><span>Type</span><b>${escapeHtml(resource.resourceType)}</b></div>
                    <div class="property-row"><span>Physical Name</span><code>${escapeHtml(resource.physicalName)}</code></div>
                </div>
            `;

            if (resource.resourceType === 'SEQUENCE') {
                propHtml += `
                    <div class="meta-card">
                        <span class="meta-label">Sequence Configuration</span>
                        <div class="property-row"><span>Start With</span><b>${ast?.start || 1}</b></div>
                        <div class="property-row"><span>Increment</span><b>${ast?.increment || 1}</b></div>
                        <div class="property-row"><span>Min/Max</span><span>${ast?.minValue || 'N/A'} / ${ast?.maxValue || 'N/A'}</span></div>
                        <div class="property-row"><span>Cache</span><b>${ast?.cache || 'OFF'}</b></div>
                    </div>
                `;
            } else if (resource.resourceType === 'TRIGGER') {
                propHtml += `
                    <div class="meta-card">
                        <span class="meta-label">Trigger Definition</span>
                        <div class="property-row"><span>Event</span><b>${ast?.event || 'N/A'}</b></div>
                        <div class="property-row"><span>Timing</span><b>${ast?.timing || 'N/A'}</b></div>
                        <div class="property-row"><span>Level</span><b>${ast?.level || 'ROW'}</b></div>
                    </div>
                `;
            } else if (resource.resourceType === 'ENUM') {
                propHtml += `
                    <div class="meta-card">
                        <span class="meta-label">Enum Values</span>
                        <div style="margin-top:0.5rem;">${(ast?.values || []).map(v => `<span class="engine-badge chip-gap">${escapeHtml(v)}</span>`).join('')}</div>
                    </div>
                `;
            } else if (resource.resourceType.includes('VIEW')) {
                propHtml += `
                    <div class="meta-card">
                        <span class="meta-label">View Optimization</span>
                        <div class="property-row"><span>Materialized</span><b>${resource.resourceType.includes('MATERIALIZED') ? 'YES' : 'NO'}</b></div>
                        <div class="property-row"><span>Recursive</span><b>${ast?.recursive ? 'YES' : 'NO'}</b></div>
                        <div class="property-row"><span>Federated</span><b>${ast?.federationStrategy || 'NONE'}</b></div>
                    </div>
                `;
            } else {
                propHtml += `
                    <div class="meta-card">
                        <span class="meta-label">Storage Metrics</span>
                        <div class="property-row"><span>Estimated Rows</span><b>${resource.rowCount || 'N/A'}</b></div>
                        <div class="property-row"><span>Status</span><span class="status-indicator active">LIVE_SYNC</span></div>
                    </div>
                `;
            }

            // Render the Properties cards (previously built but never inserted).
            document.getElementById('propertyCards').innerHTML = propHtml;

            // Columns Inspector logic
            const colSection = document.getElementById('columnsSection');
            const colBody = document.getElementById('columnsBody');

            const renderColumns = (cols) => {
                colSection.style.display = 'block';
                colBody.innerHTML = cols.map(c => `
                    <tr>
                        <td><b>${escapeHtml(c.name)}</b></td>
                        <td><code>${escapeHtml(c.type)}</code></td>
                        <td><small>${escapeHtml(c.strategy || 'NONE')}</small></td>
                        <td>${c.nullable !== false ? '<i class="fas fa-check text-success"></i>' : '<i class="fas fa-times text-danger"></i>'}</td>
                        <td>${c.primaryKey ? '<i class="fas fa-key text-warning"></i>' : ''}</td>
                    </tr>
                `).join('');
            };
            if (Array.isArray(resource.columns) && resource.columns.length) {
                // Backend now resolves columns (manifest or live) and returns them inline.
                renderColumns(resource.columns);
            } else if (ast?.columns) {
                renderColumns(ast.columns);
            } else if (['TABLE', 'VIEW', 'MATERIALIZED_VIEW', 'FOREIGN_TABLE'].includes(resource.resourceType)) {
                // Crawled table with no manifest AST — fetch live columns from the source.
                colSection.style.display = 'block';
                colBody.innerHTML = '<tr><td colspan="5">Loading columns…</td></tr>';
                fetch(`${API_BASE}/metadata/columns?tableId=${encodeURIComponent(resource.tableId)}`, { headers: getAuthHeaders() })
                    .then(r => r.json())
                    .then(d => { if (Array.isArray(d?.columns) && d.columns.length) renderColumns(d.columns); else colSection.style.display = 'none'; })
                    .catch(() => { colSection.style.display = 'none'; });
            } else {
                colSection.style.display = 'none';
            }

            // SQL DDL — datafabric-format CREATE statement generated by the backend
            // (unified relational projection of the resource; never a SELECT placeholder).
            document.getElementById('ddlCode').innerText = resource.definitionSql
                || `-- DDL unavailable for ${resource.name} — crawl the source (POST /api/metadata/crawl).`;

            // Fabric AST — the fabric's canonical descriptor (columns + a runnable
            // query/CALL AST), synthesized when no manifest AST exists. Falls back to
            // the raw manifest AST, then a note.
            const fabricAst = resource.fabricAst || ast;
            const astText = fabricAst ? JSON.stringify(fabricAst, null, 2) : '// No logical definition found';
            document.getElementById('astCode').innerText = astText;
            document.getElementById('propRaw').innerText = astText;

            switchTab('properties');
            if (['TABLE', 'VIEW', 'MATERIALIZED_VIEW'].includes(resource.resourceType)) {
                refreshData();
            } else {
                // Clear the grid contents WITHOUT destroying #gridHeader/#gridBody, so a
                // subsequent TABLE selection's refreshData() still has its DOM targets.
                const gh = document.getElementById('gridHeader');
                const gb = document.getElementById('gridBody');
                if (gh) gh.innerHTML = '';
                if (gb) gb.innerHTML = '<tr><td colspan="100" class="state-cell">Data preview not available for this resource type.</td></tr>';
            }
        } catch (e) {
            console.error('[Discovery] Select Resource Error:', e);
            showModal('Discovery Error', 'Failed to load resource details. The target engine may be unreachable.');
        }
    }

    function switchTab(tab) {
        document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
        document.querySelectorAll('.tab-content').forEach(c => c.style.display = 'none');
        
        document.querySelector(`.tab-btn[onclick="switchTab('${tab}')"]`).classList.add('active');
        document.getElementById(`tab-${tab}`).style.display = 'block';
    }

    async function refreshData() {
        const tableId = allData.currentTable?.tableId;
        if (!tableId) return;

        const body = document.getElementById('gridBody');
        const head = document.getElementById('gridHeader');
        body.innerHTML = '<tr><td colspan="100" class="state-cell">Loading data...</td></tr>';
        
        try {
            const res = await fetch(`${API_BASE}/metadata/preview?tableId=${tableId}&limit=50`, { headers: getAuthHeaders() });
            const data = await res.json();
            const rows = Array.isArray(data)
                ? data
                : (Array.isArray(data?.results)
                    ? data.results
                    : (Array.isArray(data?.data) ? data.data : []));
            
            if (!rows || rows.length === 0) {
                body.innerHTML = '<tr><td colspan="100" class="state-cell">No records found.</td></tr>';
                return;
            }

            const columns = Object.keys(rows[0]);
            head.innerHTML = columns.map(c => `<th>${escapeHtml(c)}</th>`).join('');
            body.innerHTML = rows.map(row => `
                <tr>
                    ${columns.map(c => `<td>${escapeHtml(row[c])}</td>`).join('')}
                </tr>
            `).join('');
        } catch (e) {
            body.innerHTML = '<tr><td colspan="100" class="state-cell text-danger">Error loading data preview.</td></tr>';
        }
    }

    loadTree();
</script>

<%- include('partials/footer') %>
