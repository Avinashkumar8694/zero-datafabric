<%- include('partials/header') %>

<div class="page fade-in">
    <div class="page-head">
        <div>
            <h1 class="page-title">Metadata Orchestration</h1>
            <p class="page-sub">Declarative schema management via industrial orchestration blueprints.</p>
        </div>
    </div>

    <div class="cols-3">
        <!-- Template Download -->
        <section class="glass-card">
            <h3>Orchestration Blueprint</h3>
            <p>Download the definitive V7.0 specification as a reference for your target state.</p>
            <div class="btn-row">
                <button type="button" onclick="downloadTemplate()" class="btn-outline">Download Spec</button>
                <button type="button" onclick="loadTemplateForAnalysis()" class="btn-primary">Load Industrial Blueprint</button>
            </div>
        </section>

        <!-- File Upload for Diff/Apply -->
        <section class="glass-card">
            <h3>Target State Manifest</h3>
            <p>Select a manifest file (.json) to analyze or apply schema changes.</p>
            <div class="field">
                <label for="manifestFile" class="sr-only">Manifest file (.json)</label>
                <input type="file" id="manifestFile" accept=".json">
            </div>
            <div class="btn-row">
                <button type="button" onclick="analyzeManifest()" id="diffBtn" class="btn-outline">Analyze Drift (Diff)</button>
                <button type="button" onclick="applyManifest()" id="applyBtn" class="btn-primary">Orchestrate (Apply)</button>
            </div>
        </section>

        <!-- Export Live Catalog -->
        <section class="glass-card">
            <h3>Export Live Catalog</h3>
            <p>Export the fabric's current schemas, tables &amp; relationships (including already-existing crawled objects) as a re-applicable manifest.</p>
            <div class="field">
                <label for="exportSource" class="sr-only">Export source</label>
                <select id="exportSource">
                    <option value="">All datasources (multi-source manifest)</option>
                </select>
            </div>
            <div class="btn-row">
                <button type="button" onclick="exportCatalog()" id="exportBtn" class="btn-primary">Export Manifest</button>
            </div>
        </section>
    </div>

    <!-- Orchestration Plan / Results -->
    <section id="resultCard" class="glass-card" style="display: none;">
        <div class="card-head">
            <h3 id="resultTitle">Orchestration Plan</h3>
            <span id="resultBadge" class="badge badge-info">ANALYZED</span>
        </div>

        <div id="planSummary" class="text-muted mb-2" role="status"></div>

        <div class="table-wrapper">
            <table id="planTable">
                <thead>
                    <tr>
                        <th>Type</th>
                        <th>Table</th>
                        <th>Operation</th>
                        <th>Details</th>
                        <th id="statusCol" style="display: none;">Status</th>
                    </tr>
                </thead>
                <tbody id="planBody"></tbody>
            </table>
        </div>
    </section>
</div>

<script>
    let lastManifestFileName = '';

    // Populate the export source picker from the live catalog.
    async function loadExportSources() {
        try {
            const res = await fetch(`${API_BASE}/metadata/sources`, { headers: getAuthHeaders() });
            if (!res.ok) return;
            const data = await res.json();
            const sources = Array.isArray(data) ? data : (data.sources || data.data || []);
            const sel = document.getElementById('exportSource');
            sources.forEach(s => {
                const name = s.name || s;
                const opt = document.createElement('option');
                opt.value = name;
                opt.textContent = `${name}${s.type ? ' (' + s.type + ')' : ''} — single source`;
                sel.appendChild(opt);
            });
        } catch (e) { console.error('[Metadata] loadExportSources failed', e); }
    }

    async function exportCatalog() {
        const btn = document.getElementById('exportBtn');
        const source = document.getElementById('exportSource').value;
        const originalText = btn.innerText;
        btn.innerText = 'Exporting...';
        btn.disabled = true;
        try {
            const qs = source ? `?source=${encodeURIComponent(source)}` : '';
            const res = await fetch(`${API_BASE}/metadata/export${qs}`, { headers: getAuthHeaders() });
            if (!res.ok) throw new Error(`Server returned ${res.status}`);
            const data = await res.json();

            const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
            const url = window.URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            const tag = source ? source.replace(/[^a-zA-Z0-9_]/g, '') : 'all-sources';
            a.download = `fabric-export-${tag}-${new Date().toISOString().split('T')[0]}.json`;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            window.URL.revokeObjectURL(url);

            const nRes = (data.schemas || []).reduce((n, s) => n + (s.resources || []).length, 0);
            let msg = `Exported ${data.schemas ? data.schemas.length : 0} schema(s), ${nRes} resource(s)` +
                      `${data.relationships ? ', ' + data.relationships.length + ' relationship(s)' : ''}.`;
            if (data.warnings && data.warnings.length) {
                msg += `\n\nDependency notes:\n` + data.warnings.map(w => '• ' + w).join('\n');
            }
            showModal('Export Complete', msg);
        } catch (e) {
            console.error('[Metadata] Export failed:', e);
            showModal('Error', 'Catalog export failed: ' + e.message);
        } finally {
            btn.innerText = originalText;
            btn.disabled = false;
        }
    }

    async function downloadTemplate() {
        const btn = document.querySelector('button[onclick="downloadTemplate()"]');
        const originalText = btn.innerText;
        btn.innerText = 'Generating...';
        btn.disabled = true;

        try {
            const res = await fetch(`${API_BASE}/metadata/template`, { headers: getAuthHeaders() });
            if (!res.ok) throw new Error(`Server returned ${res.status}`);
            
            const data = await res.json();
            const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
            const url = window.URL.createObjectURL(blob);
            
            const a = document.createElement('a');
            a.href = url;
            a.download = `data_fabric_blueprint_${new Date().toISOString().split('T')[0]}.json`;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            window.URL.revokeObjectURL(url);
            
            showModal('Success', 'Orchestration blueprint generated and downloaded successfully.');
        } catch (e) {
            console.error('[Metadata] Download failed:', e);
            showModal('Error', 'Industrial Blueprint Generation Failed: ' + e.message);
        } finally {
            btn.innerText = originalText;
            btn.disabled = false;
        }
    }

    async function loadTemplateForAnalysis() {
        showModal('Load Blueprint', 'This will load the definitive industrial blueprint for immediate drift analysis. Proceed?', runTemplateAnalysis, 'Proceed');
    }

    async function runTemplateAnalysis() {
        const btn = document.querySelector('button[onclick="loadTemplateForAnalysis()"]');
        const originalText = btn ? btn.innerText : '';
        if (btn) { btn.innerText = 'Loading...'; btn.disabled = true; }

        // Loading state
        const card = document.getElementById('resultCard');
        const body = document.getElementById('planBody');
        card.style.display = 'block';
        document.getElementById('resultTitle').innerText = 'Orchestration Plan';
        document.getElementById('planSummary').innerText = 'Loading blueprint and analyzing drift...';
        body.innerHTML = '<tr><td colspan="5" class="state-cell">Loading...</td></tr>';

        try {
            const res = await fetch(`${API_BASE}/metadata/template`, { headers: getAuthHeaders() });
            const data = await res.json();

            const res2 = await fetch(`${API_BASE}/metadata/diff`, {
                method: 'POST',
                headers: getAuthHeaders(),
                body: JSON.stringify(data)
            });
            const diffData = await res2.json();
            displayPlan(diffData.changes || [], 'Orchestration Plan', 'ANALYZED', false);
        } catch (e) {
            showModal('Error', 'Template Analysis Failed: ' + e.message);
        } finally {
            if (btn) { btn.innerText = originalText; btn.disabled = false; }
        }
    }

    async function analyzeManifest() {
        const fileInput = document.getElementById('manifestFile');
        if (!fileInput.files[0]) return alert('Please select a manifest file first.');
        lastManifestFileName = fileInput.files[0].name;

        const formData = new FormData();
        formData.append('file', fileInput.files[0]);

        const btn = document.getElementById('diffBtn');
        const originalText = btn.innerText;
        btn.innerText = 'Analyzing...';
        btn.disabled = true;

        const uploadHeaders = getAuthHeaders();
        delete uploadHeaders['Content-Type'];

        try {
            const res = await fetch(`${API_BASE}/metadata/diff`, {
                method: 'POST',
                headers: uploadHeaders,
                body: formData
            });
            const data = await res.json();
            displayPlan(data.changes || [], 'Orchestration Plan', 'ANALYZED', false);
        } catch (e) {
            alert('Analysis failed: ' + e.message);
        } finally {
            btn.innerText = originalText;
            btn.disabled = false;
        }
    }

    async function applyManifest() {
        const fileInput = document.getElementById('manifestFile');
        if (!fileInput.files[0]) return alert('Please select a manifest file first.');
        lastManifestFileName = fileInput.files[0].name;

        showModal('Industrial Warning', 'This will execute DDL/DML operations on the live fabric. Proceed?', runApplyManifest, 'Proceed');
    }

    async function runApplyManifest() {
        const fileInput = document.getElementById('manifestFile');
        if (!fileInput.files[0]) return alert('Please select a manifest file first.');

        const formData = new FormData();
        formData.append('file', fileInput.files[0]);

        const btn = document.getElementById('applyBtn');
        const originalText = btn.innerText;
        btn.innerText = 'Orchestrating...';
        btn.disabled = true;

        const uploadHeaders = getAuthHeaders();
        delete uploadHeaders['Content-Type'];

        try {
            const res = await fetch(`${API_BASE}/metadata/apply`, {
                method: 'POST',
                headers: uploadHeaders,
                body: formData
            });
            const data = await res.json();
            displayPlan(data.plan, 'Orchestration Results', 'SUCCESS', true, data.results);
        } catch (e) {
            alert('Orchestration failed: ' + e.message);
        } finally {
            btn.innerText = originalText;
            btn.disabled = false;
        }
    }

    function displayPlan(plan, title, badgeText, showStatus, results = []) {
        const card = document.getElementById('resultCard');
        const body = document.getElementById('planBody');
        const titleEl = document.getElementById('resultTitle');
        const badgeEl = document.getElementById('resultBadge');
        const summaryEl = document.getElementById('planSummary');
        const statusCol = document.getElementById('statusCol');

        card.style.display = 'block';
        titleEl.innerText = title;
        badgeEl.innerText = badgeText;
        badgeEl.className = 'badge ' + (badgeText === 'SUCCESS' ? 'badge-ok' : 'badge-info');
        statusCol.style.display = showStatus ? 'table-cell' : 'none';

        if (!Array.isArray(plan) || plan.length === 0) {
            summaryEl.innerText = 'No schema drift detected. Live environment matches target state.';
            body.innerHTML = '<tr><td colspan="5" class="state-cell">Empty Plan</td></tr>';
            return;
        }

        const MAX_ROWS = 500;
        const capped = plan.length > MAX_ROWS;
        const rows = capped ? plan.slice(0, MAX_ROWS) : plan;

        summaryEl.innerText = `${plan.length} operations parsed from ${lastManifestFileName || 'manifest payload'} and aligned to target state.`
            + (capped ? ` (showing ${MAX_ROWS} of ${plan.length})` : '');

        body.innerHTML = rows.map((p, idx) => {
            const raw = JSON.stringify(p);
            const detail = raw.substring(0, 180) + (raw.length > 180 ? '...' : '');
            const ok = results[idx]?.status === 'SUCCESS' || results[idx]?.status?.startsWith('SUCCESS');
            return `
            <tr>
                <td><span class="badge badge-muted">${escapeHtml(p.action || p.type)}</span></td>
                <td><strong>${escapeHtml(p.table || p.name || p.type || 'N/A')}</strong></td>
                <td>${escapeHtml(p.operation || p.action)}</td>
                <td class="text-muted"><code>${escapeHtml(detail)}</code></td>
                ${showStatus ? `<td><span class="badge ${ok ? 'badge-ok' : 'badge-danger'}">${ok ? 'DONE' : 'ERROR'}</span></td>` : ''}
            </tr>
        `;
        }).join('');
    }

    // Populate export source picker on load.
    document.addEventListener('DOMContentLoaded', loadExportSources);
</script>

<%- include('partials/footer') %>
