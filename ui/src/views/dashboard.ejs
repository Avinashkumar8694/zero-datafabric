<%- include('partials/header') %>

<div class="fade-in">
    <!-- Stats Row -->
    <div class="grid">
        <div class="glass-card">
            <p class="text-muted">Total Tenants</p>
            <h1 id="stat-tenants">--</h1>
        </div>
        <div class="glass-card">
            <p class="text-muted">Active Connections</p>
            <h1 id="stat-connections">--</h1>
        </div>
        <div class="glass-card">
            <p class="text-muted">Security Audits (24h)</p>
            <h1 id="stat-audits">--</h1>
        </div>
    </div>

    <div class="grid" style="grid-template-columns: 2fr 1fr;">
        <!-- Recent Activity -->
        <section class="glass-card">
            <h3>Recent Fabric Events</h3>
            <div class="table-wrapper">
                <table>
                    <thead>
                        <tr>
                            <th>Module</th>
                            <th>Action</th>
                            <th>Target</th>
                            <th>Time</th>
                        </tr>
                    </thead>
                    <tbody id="activityBody">
                        <tr><td colspan="4">No recent activity detected</td></tr>
                    </tbody>
                </table>
            </div>
        </section>

        <!-- System Health -->
        <section class="glass-card">
            <h3>Fabric Health</h3>
            <div id="healthTelemetry" style="padding-top: 1rem;">
                <div style="margin-bottom: 1rem; display: flex; justify-content: space-between;">
                    <span>Status</span>
                    <span id="healthStatus" class="badge-sync">CHECKING...</span>
                </div>
                <div style="margin-bottom: 1rem; display: flex; justify-content: space-between;">
                    <span>DB Latency</span>
                    <span id="dbLatency" class="text-muted">--</span>
                </div>
                <div style="margin-bottom: 1rem; display: flex; justify-content: space-between;">
                    <span>Uptime</span>
                    <span id="sysUptime" class="text-muted">--</span>
                </div>
                <div style="font-size: 0.7rem; color: var(--text-muted); border-top: 1px solid var(--border); padding-top: 0.5rem; margin-top: 0.5rem;">
                    Pool: <span id="dbPool">--</span>
                </div>
            </div>
        </section>
    </div>
</div>

<script>
    async function loadStats() {
        try {
            const res = await fetch(`${API_BASE}/admin/stats`, {
                headers: getAuthHeaders()
            });
            const stats = await res.json();
            
            document.getElementById('stat-tenants').innerText = stats.tenants || '0';
            document.getElementById('stat-connections').innerText = stats.connections || '0';
            document.getElementById('stat-audits').innerText = stats.audits || '0';
        } catch (e) {
            console.error('[Dashboard] Stats fetch failed', e);
            document.getElementById('stat-tenants').innerText = '--';
            document.getElementById('stat-connections').innerText = '--';
            document.getElementById('stat-audits').innerText = '--';
        }
    }

    async function loadHealth() {
        try {
            const res = await fetch(`${API_BASE.replace('/api', '')}/api/health`);
            const data = await res.json();
            
            const statusEl = document.getElementById('healthStatus');
            statusEl.innerText = data.status;
            statusEl.style.background = data.status === 'HEALTHY' ? 'var(--success)' : 'var(--danger)';
            
            document.getElementById('dbLatency').innerText = data.database.latency;
            document.getElementById('sysUptime').innerText = data.uptime;
            document.getElementById('dbPool').innerText = `Total: ${data.database.pool.total}, Idle: ${data.database.pool.idle}`;
        } catch (e) {
            document.getElementById('healthStatus').innerText = 'OFFLINE';
            document.getElementById('healthStatus').style.background = 'var(--danger)';
        }
    }

    async function loadEvents() {
        const body = document.getElementById('activityBody');
        try {
            const res = await fetch(`${API_BASE}/events`, {
                headers: getAuthHeaders()
            });
            const events = await res.json();
            
            if (Array.isArray(events) && events.length > 0) {
                body.innerHTML = events.map(e => `
                    <tr>
                        <td style="text-transform: uppercase; font-size: 0.7rem; font-weight: bold;">${e.action.split('.')[0] || 'ENGINE'}</td>
                        <td>${e.action}</td>
                        <td><span class="badge-sync">${e.tableName || 'N/A'}</span></td>
                        <td class="text-muted">${new Date(e.createdAt).toLocaleTimeString()}</td>
                    </tr>
                `).join('');
            } else {
                body.innerHTML = '<tr><td colspan="4">No recent activity detected</td></tr>';
            }
        } catch (e) {
            body.innerHTML = '<tr><td colspan="4" class="text-danger">Failed to load events</td></tr>';
        }
    }

    loadStats();
    loadHealth();
    loadEvents();
    setInterval(loadHealth, 10000); 
    setInterval(loadEvents, 10000); 
</script>

<%- include('partials/footer') %>
