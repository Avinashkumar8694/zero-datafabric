      <li><a href="https://github.com" target="_blank">Docs</a></li>
    </ul>
    <div class="home-nav-cta">
      <a href="javascript:void(0)" id="navLoginBtn" class="btn-home-ghost">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        Sign In with SSO
      </a>
      <a href="javascript:void(0)" id="navDashBtn" class="btn-home-primary" style="display:none">
        Go to Dashboard →
      </a>
    </div>
  </nav>

  <!-- ── Hero ── -->
  <section class="hero-section">
    <div class="hero-badge">
      <span class="dot"></span>
      Enterprise Data Fabric Platform
    </div>

    <h1 class="hero-h1">
      Unify Every Data Source<br>
      <span class="gradient-text">Into One Intelligent Fabric</span>
    </h1>

    <p class="hero-sub">
      Connect PostgreSQL, MongoDB, Elasticsearch and more into a single governed,
      real-time data layer — with triggers, replication, analytics, and SSO built in.
    </p>

    <div class="hero-actions">
      <a href="javascript:void(0)" id="heroLoginBtn" class="btn-hero-cta">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
