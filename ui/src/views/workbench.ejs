    .wb-mode { display:flex; gap:0.5rem; }
    .tab-btn { border:none; background:#f1f5f9; border-radius:8px; padding:0.45rem 0.8rem; font-weight:700; cursor:pointer; color:#475569; }
    .tab-btn.active { background:#dbeafe; color:#1d4ed8; }
