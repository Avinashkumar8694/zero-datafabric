    .wb-detail { background:#fff; border:1px solid #e5e7eb; border-radius:10px; overflow:hidden; }
    .wb-detail-head { display:flex; justify-content:space-between; align-items:center; padding:0.5rem 0.75rem; border-bottom:1px solid #eef2f7; background:#f8fafc; }
    .wb-detail-title { font-size:0.82rem; color:#334155; font-weight:700; }
    .wb-detail-title .wb-cap { font-weight:400; color:#94a3b8; font-size:0.72rem; margin-left:0.4rem; }
