<%- include('partials/header') %>

<div class="page fade-in">
  <div class="page-head">
    <div>
      <h1 class="page-title">Custom Analytics</h1>
      <p class="page-sub">Build reusable, parameterized analytics with the visual AST builder. Play one to run it (you will be prompted for variables) or trigger it via <code>POST /api/saved-analytics/:id/run</code>.</p>
    </div>
    <div class="page-actions">
      <a href="/analytics" class="btn-outline"><i class="fas fa-arrow-left" aria-hidden="true"></i> Dashboard</a>
      <button type="button" class="btn-primary" onclick="openBuilder()"><i class="fas fa-plus" aria-hidden="true"></i> Create analytic</button>
    </div>
  </div>
  <section class="glass-card">
    <div id="caList" class="cols-auto"></div>
    <div id="caEmpty" class="empty-state" style="display:none;">No custom analytics yet. Click <strong>Create analytic</strong>.</div>
  </section>
</div>

<!-- ============ BUILDER MODAL ============ -->
<div id="builderModal" class="ca-modal" role="dialog" aria-modal="true" aria-labelledby="builderTitle">
  <div class="sheet">
    <div class="ca-head">
      <h3 id="builderTitle">Create analytic</h3>
      <div class="row-actions">
        <button type="button" id="bPreviewToggle" class="btn-outline" onclick="togglePreviewPane()"><i class="fas fa-eye" aria-hidden="true"></i> Preview</button>
        <button type="button" class="btn-outline" onclick="closeBuilder()">Close</button>
      </div>
    </div>
    <div class="ca-body" id="caBody">
      <!-- left: the builder -->
      <div>
        <div class="ca-field"><label for="bName">Name</label><input id="bName" class="ca-input" placeholder="reports_by_manager"></div>
        <div class="ca-field"><label for="bDesc">Description</label><input id="bDesc" class="ca-input" placeholder="Direct reports of a manager"></div>

        <span class="label" id="bTypesLabel">Query type</span>
        <div class="ca-types" id="bTypes" role="group" aria-labelledby="bTypesLabel"></div>

        <!-- source/resource (SELECT/AGGREGATE/RECURSIVE) -->
        <div id="bSourceRow" class="cols-2">
          <div class="ca-field"><label for="bSource">Source</label><select id="bSource" class="ca-select" onchange="onBSource()"></select></div>
          <div class="ca-field"><label for="bResource">Resource</label><select id="bResource" class="ca-select" onchange="onBResource()"></select></div>
        </div>

        <!-- SUB-ANALYTICS as CTEs (compose one analytic inside another) -->
        <div class="ca-sec" data-for="SELECT,AGGREGATE">
          <div class="h"><b>Sub-analytics (CTE)</b>
            <span class="row-actions">
              <select id="bCtePick" class="ca-select ca-select-sm" aria-label="Saved analytic to reuse as CTE"></select>
              <button type="button" class="btn-outline mini-btn" onclick="addCteFromPick()">+ as CTE</button>
            </span>
          </div>
          <div class="text-muted small mb-1">Reuse a saved AST analytic as a named CTE, then set <b>Resource</b> to that CTE to query its result.</div>
          <div id="bCtes"></div>
        </div>

        <!-- SELECT section -->
        <div class="ca-sec" data-for="SELECT,AGGREGATE">
          <div class="h"><b>Columns</b><span class="text-muted small">click to toggle · empty = all (*)</span></div>
          <div id="bCols"></div>
        </div>

        <!-- WHERE section -->
        <div class="ca-sec" data-for="SELECT,AGGREGATE,RECURSIVE">
          <div class="h"><b>Filters (WHERE)</b><button class="btn-outline mini-btn" onclick="addWhere()">+ filter</button></div>
          <div id="bWhere"></div>
        </div>

        <!-- DISTINCT (SELECT) -->
        <div class="ca-sec" data-for="SELECT">
          <div class="h"><b>Modifiers</b><label class="ca-mini-label"><input type="checkbox" id="bDistinct" onchange="renderPreview()"> DISTINCT</label></div>
        </div>

        <!-- WINDOW functions (SELECT/AGGREGATE) — RANK / ROW_NUMBER / running totals -->
        <div class="ca-sec" data-for="SELECT,AGGREGATE">
          <div class="h"><b>Window functions</b><button class="btn-outline mini-btn" onclick="addWindow()">+ window</button></div>
          <div class="text-muted small mb-1">RANK / DENSE_RANK / ROW_NUMBER, or SUM/AVG/COUNT/MIN/MAX OVER (PARTITION BY … ORDER BY …). Computed in-fabric.</div>
          <div id="bWindows"></div>
        </div>

        <!-- AGGREGATE section -->
        <div class="ca-sec" data-for="AGGREGATE">
          <div class="h"><b>Group by</b></div>
          <div id="bGroupBy"></div>
          <div class="h mt-1"><b>Aggregates</b><button class="btn-outline mini-btn" onclick="addAgg()">+ aggregate</button></div>
          <div id="bAggs"></div>
          <div class="h mt-1"><b>Having (post-aggregate)</b><button class="btn-outline mini-btn" onclick="addHaving()">+ having</button></div>
          <div id="bHaving"></div>
        </div>

        <!-- ORDER/LIMIT -->
        <div class="ca-sec" data-for="SELECT,AGGREGATE">
          <div class="h"><b>Order by</b><button class="btn-outline mini-btn" onclick="addOrder()">+ order</button></div>
          <div id="bOrders"></div>
          <div class="ca-field ca-limit mt-1"><label for="bLimit">Limit</label><input id="bLimit" class="ca-input" type="number" value="50"></div>
        </div>

        <!-- JOINS (SELECT) — multiple, cross-source; base table alias is `a` -->
        <div class="ca-sec" data-for="SELECT">
          <div class="h"><b>Joins (cross-source, chainable)</b><button class="btn-outline mini-btn" onclick="addJoin()">+ join</button></div>
          <div class="text-muted small mb-1">Base table is alias <code>a</code>; joins are <code>b</code>, <code>c</code>, … Reference columns like <code>a.id</code> / <code>b.customer_id</code>.</div>
          <div id="bJoins"></div>
        </div>

        <!-- SET OPERATIONS (SELECT) — UNION / INTERSECT / EXCEPT legs -->
        <div class="ca-sec" data-for="SELECT">
          <div class="h"><b>Set operations</b><button class="btn-outline mini-btn" onclick="addSetOp()">+ leg</button></div>
          <div class="text-muted small mb-1">Combine the base query with other source/resource legs (columns must line up).</div>
          <div id="bSetOps"></div>
        </div>

        <!-- RECURSIVE -->
        <div class="ca-sec" data-for="RECURSIVE">
          <div class="h"><b>Hierarchy (connect-by)</b></div>
          <div class="cols-2">
            <div class="ca-field"><label for="bRecParent">parent column</label><select id="bRecParent" class="ca-select" onchange="renderPreview()"></select></div>
            <div class="ca-field"><label for="bRecChild">child column</label><select id="bRecChild" class="ca-select" onchange="renderPreview()"></select></div>
            <div class="ca-field"><label for="bRecAnchor">anchor column (roots)</label><select id="bRecAnchor" class="ca-select" onchange="renderPreview()"></select></div>
            <div class="ca-field"><label for="bRecDir">direction</label><select id="bRecDir" class="ca-select" onchange="renderPreview()"><option value="down">down (children)</option><option value="up">up (ancestors)</option></select></div>
            <div class="ca-field"><label for="bRecDepth">max depth</label><input id="bRecDepth" class="ca-input" type="number" value="10"></div>
            <div class="ca-field"><label for="bRecPath">path column (optional)</label><select id="bRecPath" class="ca-select" onchange="renderPreview()"></select></div>
          </div>
        </div>

        <!-- CALL -->
        <div class="ca-sec" data-for="CALL">
          <div class="h"><b>Function / procedure</b></div>
          <div class="cols-2">
            <div class="ca-field"><label for="bCallKind">kind</label><select id="bCallKind" class="ca-select" onchange="renderPreview()"><option value="function">function</option><option value="procedure">procedure</option></select></div>
            <div class="ca-field"><label for="bCallSchema">schema (optional)</label><input id="bCallSchema" class="ca-input" placeholder="public" oninput="renderPreview()"></div>
          </div>
          <div class="ca-field"><label for="bCallName">name</label><input id="bCallName" class="ca-input" placeholder="current_user_id" oninput="renderPreview()"></div>
          <div class="h"><b>Arguments</b><button class="btn-outline mini-btn" onclick="addArg()">+ arg</button></div>
          <div id="bArgs"></div>
        </div>

        <!-- VARIABLES -->
        <div class="ca-sec">
          <div class="h"><b>Variables</b><span class="row-actions"><button type="button" class="btn-outline mini-btn" onclick="detectVars()">detect {{ }}</button><button class="btn-outline mini-btn" onclick="addVar()">+ variable</button></span></div>
          <div id="bVars"></div>
          <div class="text-muted small mt-1">Tick "bind" on a filter to turn its value into a <code>{{variable}}</code>. Variables are prompted at Play time.</div>
        </div>
      </div>

      <!-- right: live preview (AST | SQL) + test — toggled via the Preview button -->
      <div id="bPreviewPane" style="display:none;">
        <div class="ca-preview">
          <div class="between flex items-center">
            <div class="ca-types">
              <div class="ca-type active" id="pvAst" role="button" tabindex="0" onclick="setPreview('AST')">AST</div>
              <div class="ca-type" id="pvSql" role="button" tabindex="0" onclick="setPreview('SQL')">SQL</div>
            </div>
            <label class="ca-mini-label"><input type="checkbox" id="bRawOn" onchange="toggleRaw()"> advanced (edit raw)</label>
          </div>
          <pre class="ca-code mt-1" id="bPreview">{}</pre>
          <textarea id="bRaw" class="ca-input ca-raw mt-1" style="display:none;" aria-label="Raw AST JSON" oninput="renderPreview()" placeholder='Full control — edit/paste any nested AST config here (subqueries, AND/OR groups, multiple joins, unions, CTEs)…'></textarea>
          <button type="button" class="btn-outline btn-block mt-1" onclick="testBuild()"><i class="fas fa-flask" aria-hidden="true"></i> Test run</button>
          <div id="bTest" class="ca-test" style="display:none;"></div>
        </div>
      </div>
    </div>
    <div class="ca-foot">
      <button type="button" class="btn-outline" onclick="closeBuilder()">Cancel</button>
      <button type="button" class="btn-primary" onclick="saveBuild()"><i class="fas fa-floppy-disk" aria-hidden="true"></i> Save analytic</button>
    </div>
  </div>
</div>

<!-- ============ PLAY (variable prompt) MODAL ============ -->
<div id="playModal" class="ca-modal" role="dialog" aria-modal="true" aria-labelledby="playTitle">
  <div class="sheet sm">
    <div class="ca-head"><h3 id="playTitle">Inputs</h3><button type="button" class="btn-outline" onclick="closePlay()">Close</button></div>
    <div class="ca-body single"><div id="playInputs"></div></div>
    <div class="ca-foot"><button type="button" class="btn-outline" onclick="closePlay()">Cancel</button><button type="button" class="btn-primary" id="playRunBtn"><i class="fas fa-play" aria-hidden="true"></i> Run</button></div>
  </div>
</div>

<!-- ============ RESULT MODAL ============ -->
<div id="resultModal" class="ca-modal" role="dialog" aria-modal="true" aria-labelledby="resultTitle">
  <div class="sheet">
    <div class="ca-head"><h3 id="resultTitle">Result</h3><button type="button" class="btn-outline" onclick="closeResult()">Close</button></div>
    <div class="ca-body single">
      <div id="resultBound" class="text-muted small mb-1"></div>
      <div id="resultKpis" class="stat-grid"></div>
      <div class="table-wrapper"><table id="resultTable"><thead id="resultHead"></thead><tbody id="resultBody"></tbody></table></div>
      <div id="resultPlan" class="mt-2"></div>
    </div>
  </div>
</div>

<script src="/js/custom-analytics.js"></script>
<%- include('partials/footer') %>
