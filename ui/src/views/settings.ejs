<%- include('partials/header') %>

<div class="fade-in settings-shell">
    <div class="settings-hero">
        <h2 style="margin:0;">Platform Settings</h2>
        <p class="text-muted" style="margin:0.35rem 0 0;">Tenant-scoped controls for downstreams, guardrails, and trigger notification channels.</p>
    </div>
    <div class="grid settings-grid">
        <!-- Infrastructure -->
        <section class="glass-card">
            <h3>Fabric Infrastructure</h3>
            <p class="text-muted" style="margin-bottom: 2rem;">Core orchestration endpoints and environment status.</p>
            
            <div class="form-group">
                <label style="display: block; margin-bottom: 0.5rem; color: var(--text-muted);">Orchestrator URL</label>
                <input type="text" value="http://127.0.0.1:4000" class="context-select" style="width: 100%;" readonly>
            </div>
            
            <div class="form-group">
                <label style="display: block; margin-bottom: 0.5rem; color: var(--text-muted);">PostgREST Gateway</label>
                <input type="text" value="http://localhost:3000" class="context-select" style="width: 100%;" readonly>
            </div>

            <div class="form-group" style="margin-top: 1.5rem;">
                <label style="display: block; margin-bottom: 0.5rem; color: var(--text-muted);">Industrial Grade</label>
                <span class="badge-sync" style="background: var(--success)">V4.0 COMPLIANT</span>
            </div>
        </section>

        <!-- Downstream Registry (Interactive Toggles) -->
        <section class="glass-card">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
                <h3>Downstream Control Center</h3>
                <button onclick="location.href='/metadata'" class="btn-outline" style="padding: 0.3rem 0.8rem; font-size: 0.8rem;">Full Manifest Editor</button>
            </div>
            <p class="text-muted" style="margin-bottom: 1.5rem;">Enable or disable search/analytics targets in real-time. Changes trigger an atomic re-orchestration.</p>
            
            <div id="downstreamList" style="display: flex; flex-direction: column; gap: 1rem;">
                <div class="text-muted" style="text-align: center; padding: 2rem;">Scanning registry...</div>
            </div>
        </section>

        <!-- Feature Toggles (Baseline) -->
        <section class="glass-card">
            <h3>Advanced Guardrails</h3>
            <p class="text-muted" style="margin-bottom: 2rem;">Enforcement and consistency policies.</p>
            
            <div style="display: flex; flex-direction: column; gap: 1rem;">
                <div class="nav-item" style="display: flex; justify-content: space-between; align-items: center; border: 1px solid var(--border);">
                    <span>Row-Level Security (RLS)</span>
                    <span class="badge-sync" style="background: var(--primary)">ENFORCED</span>
                </div>
                <div class="nav-item" style="display: flex; justify-content: space-between; align-items: center; border: 1px solid var(--border);">
                    <span>Soft Delete Strategy</span>
                    <span class="badge-sync" style="background: var(--surface-hover)">ACTIVE</span>
                </div>
                <div class="nav-item" style="display: flex; justify-content: space-between; align-items: center; border: 1px solid var(--border);">
                    <span>Audit Trail Gating</span>
                    <span class="badge-sync" style="background: var(--primary)">ENABLED</span>
                </div>
            </div>
        </section>

        <section class="glass-card">
            <div class="trg-head">
                <h3 style="margin:0; font-size: 1rem;">Notification Channels</h3>
                <button class="btn-outline" style="padding: 0.25rem 0.6rem; font-size: 0.75rem;" onclick="loadChannels()">Refresh</button>
            </div>
            <p class="text-muted" style="margin-bottom: 1.25rem; font-size: 0.8rem;">Configure notification targets for triggers. These are scoped to the active tenant.</p>
            
            <div style="display:grid; grid-template-columns: 1fr 1fr; gap:0.75rem; margin-bottom:0.75rem;">
                <div>
                    <label class="trg-label">Type</label>
                    <select id="chType" class="trg-select" onchange="updateConfigTemplate()">
                        <option value="EMAIL">EMAIL</option>
                        <option value="TELEGRAM">TELEGRAM</option>
                        <option value="WEBHOOK">WEBHOOK</option>
                    </select>
                </div>
                <div>
                    <label class="trg-label">Channel Name</label>
                    <input id="chName" class="trg-input" placeholder="primary_email">
                </div>
            </div>
            
            <div id="dynamicFieldsContainer" style="margin-bottom: 0.75rem;">
                <!-- Fields injected here -->
            </div>

            <div class="full" style="margin-bottom: 0.75rem; display:none;" id="jsonModeContainer">
                <div style="display:flex; justify-content:space-between; align-items: center; margin-bottom: 0.3rem;">
                    <label class="trg-label" style="margin-bottom:0;">Configuration (JSON)</label>
                    <a href="javascript:void(0)" onclick="toggleJsonMode()" style="font-size: 0.65rem; text-decoration: none; color: var(--primary); font-weight: 600;">Switch to Form</a>
                </div>
                <textarea id="chConfig" class="trg-text" style="min-height: 120px;"></textarea>
            </div>
            
            <div style="text-align: right; margin-bottom: 0.75rem;">
                <a href="javascript:void(0)" id="jsonModeToggle" onclick="toggleJsonMode()" style="font-size: 0.65rem; text-decoration: none; color: var(--text-muted);">Advanced: Edit JSON</a>
            </div>

            <div style="display:flex; justify-content: space-between; align-items:center;">
                <label style="display:flex; align-items:center; gap:0.5rem; font-size: 0.8rem; cursor: pointer; color: var(--text-muted);">
                    <input id="chDefault" type="checkbox" style="width: 16px; height: 16px;"> Set as Default
                </label>
                <button class="btn-primary" onclick="saveChannel()">Save Channel</button>
            </div>

            <div id="channelsList" style="margin-top:1.5rem; display:flex; flex-direction:column; gap:0.75rem;"></div>
        </section>
    </div>
</div>

<style>
    .settings-shell { display:flex; flex-direction:column; gap:1.5rem; }
    .settings-hero { border:1px solid var(--border); border-radius:14px; padding:1.25rem 1.5rem; background:linear-gradient(140deg,#f8fbff 0%,#ffffff 70%); }
    .settings-grid .glass-card { border-radius:14px; box-shadow: 0 10px 28px rgba(2,6,23,0.06); padding: 1.5rem; }
    .trg-label { display: block; font-size: 0.7rem; font-weight: 600; color: var(--text-muted); margin-bottom: 0.3rem; text-transform: uppercase; letter-spacing: 0.05em; }
    .trg-input, .trg-select, .trg-text { width: 100%; border: 1px solid var(--border); border-radius: 8px; padding: 0.5rem 0.6rem; font-size: 0.8rem; background: #fdfdfd; transition: border-color 0.2s; }
    .trg-input:focus, .trg-select:focus, .trg-text:focus { border-color: var(--primary); outline: none; background: #fff; }
    .trg-text { min-height: 80px; font-family: 'JetBrains Mono', monospace; font-size: 0.75rem; line-height: 1.4; }
    .trg-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; }
    .code-sm { font-family: 'JetBrains Mono', monospace; font-size: 0.7rem; color: var(--text-muted); background: #f1f5f9; padding: 0.1rem 0.3rem; border-radius: 4px; }
    .badge-sync { padding: 0.2rem 0.5rem; border-radius: 6px; font-size: 0.65rem; font-weight: 600; color: white; text-transform: uppercase; background: var(--primary); }
    /* Premium Toggle Switch */
    .switch {
        position: relative;
        display: inline-block;
        width: 46px;
        height: 24px;
    }
    .switch input { opacity: 0; width: 0; height: 0; }
    .slider {
        position: absolute;
        cursor: pointer;
        top: 0; left: 0; right: 0; bottom: 0;
        background-color: var(--surface-hover);
        transition: .4s;
        border-radius: 24px;
        border: 1px solid var(--border);
    }
    .slider:before {
        position: absolute;
        content: "";
        height: 18px; width: 18px;
        left: 3px; bottom: 2px;
        background-color: var(--text-muted);
        transition: .4s;
        border-radius: 50%;
    }
    input:checked + .slider { background-color: var(--success); border-color: var(--success); }
    input:checked + .slider:before { transform: translateX(21px); background-color: black; }
</style>

<script>
    async function loadDownstreamStatus() {
        try {
            const res = await fetch(`${API_BASE}/metadata/downstream`, { headers: getAuthHeaders() });
            const data = await res.json();
            const container = document.getElementById('downstreamList');
            
            if (!data || data.length === 0) {
                container.innerHTML = '<div class="text-muted" style="text-align: center; padding: 2rem;">No downstream targets configured. Apply a manifest to see targets.</div>';
                return;
            }

            container.innerHTML = data.map(target => `
                <div class="nav-item" style="display: flex; justify-content: space-between; align-items: center; border: 1px solid var(--border); background: var(--bg); padding: 1rem;">
                    <div>
                        <strong style="color: var(--primary);">${target.target_type}</strong>
                        <div style="font-size: 0.7rem; color: var(--text-muted);">${target.target_type === 'ELASTICSEARCH' ? 'Elasticsearch Search Sync' : 'Snowflake CDC Analytics'}</div>
                        <div style="font-size: 0.7rem; color: var(--text-muted); margin-top: 0.25rem;">
                            ${(target.config && target.config.detail && target.config.detail.message) ? target.config.detail.message : 'Connector ready'}
                        </div>
                    </div>
                    <div style="display: flex; align-items: center; gap: 0.8rem;">
                        <span style="font-size: 0.7rem; font-weight: bold; color: ${target.status === 'ACTIVE' ? 'var(--success)' : (target.status === 'ERROR' || target.status === 'NOT_CONFIGURED' ? 'var(--danger)' : 'var(--text-muted)')};">
                            ${target.status}
                        </span>
                        <label class="switch">
                            <input type="checkbox" ${target.status === 'ACTIVE' ? 'checked' : ''} onchange="toggleTarget('${target.target_type}', this.checked)">
                            <span class="slider"></span>
                        </label>
                    </div>
                </div>
            `).join('');
        } catch (e) {
            console.error('Failed to load downstream status', e);
        }
    }

    async function toggleTarget(type, enabled) {
        try {
            const res = await fetch(`${API_BASE}/metadata/downstream/toggle`, {
                method: 'POST',
                headers: { ...getAuthHeaders(), 'Content-Type': 'application/json' },
                body: JSON.stringify({ targetType: type, enabled })
            });
            const data = await res.json();
            if (data.status === 'SUCCESS') {
                showToast(`${type} status updated to ${enabled ? 'ENABLED' : 'DISABLED'}`);
                loadDownstreamStatus(); // Refresh UI
            } else {
                alert('Toggle failed: ' + (data.message || data.error));
                loadDownstreamStatus(); // Revert UI
            }
        } catch (e) {
            alert('Error toggling target: ' + e.message);
            loadDownstreamStatus();
        }
    }

    function showToast(msg) {
        // Simple toast implementation or just console log for now
        console.log('[Fabric Notification]', msg);
    }

    async function loadChannels() {
        const list = document.getElementById('channelsList');
        list.innerHTML = '<div class="text-muted">Loading channels...</div>';
        try {
            const res = await fetch(`${API_BASE}/admin/notification-channels`, { headers: getAuthHeaders() });
            const rows = await res.json();
            if (!Array.isArray(rows) || rows.length === 0) {
                list.innerHTML = '<div class="text-muted">No channels configured for this tenant.</div>';
                return;
            }
            
            // Clear and build list
            list.innerHTML = '';
            rows.forEach(r => {
                const item = document.createElement('div');
                item.className = 'channel-card';
                item.style.cssText = 'border:1px solid var(--border); background: #fff; padding: 1rem; border-radius: 12px; margin-bottom: 0.75rem; position: relative;';
                
                const configStr = JSON.stringify(r.config, null, 2);
                
                item.innerHTML = `
                    <div style="display:flex; justify-content:space-between; align-items: flex-start; gap: 1rem;">
                        <div style="flex: 1; min-width: 0;">
                            <div style="display:flex; align-items:center; gap:0.4rem; flex-wrap: wrap; margin-bottom: 0.5rem;">
                                <strong style="font-size: 0.9rem; color: var(--primary);">${r.name}</strong>
                                <span class="badge-sync" style="background: #f1f5f9; color: #64748b; border: 1px solid var(--border); font-size: 0.6rem;">${r.channelType}</span>
                                ${r.isDefault ? '<span class="badge-sync" style="background: var(--success); font-size: 0.6rem;">DEFAULT</span>' : ''}
                            </div>
                            <div style="font-size:0.7rem; color:var(--text-muted); margin-bottom: 0.6rem;">
                                <span style="color: var(--success);">●</span> ${r.status}
                            </div>
                            <div class="config-preview" style="font-family: monospace; font-size: 0.65rem; background: #f8fafc; border: 1px solid var(--border); padding: 0.4rem; border-radius: 6px; color: #64748b; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; cursor: pointer;">
                                ${JSON.stringify(r.config)}
                            </div>
                        </div>
                        <div style="display:flex; gap:0.35rem; align-items: center;">
                            <button class="btn-edit btn-outline" style="padding: 0.35rem 0.6rem; font-size: 0.7rem; border-radius: 6px;">Edit</button>
                            <button class="btn-test btn-outline" style="padding: 0.35rem 0.6rem; font-size: 0.7rem; border-radius: 6px;">Test</button>
                            <button class="btn-del btn-outline" style="padding: 0.35rem 0.6rem; font-size: 0.7rem; border-radius: 6px; color: #ef4444; border-color: #fee2e2; background: #fef2f2;">Del</button>
                        </div>
                    </div>
                `;
                
                // Secure Event Listeners
                item.querySelector('.config-preview').onclick = () => alert(configStr);
                item.querySelector('.btn-test').onclick = () => testChannel(r.channelType, r.name);
                item.querySelector('.btn-del').onclick = () => deleteChannel(r.id);
                item.querySelector('.btn-edit').onclick = () => {
                    document.getElementById('chType').value = r.channelType;
                    document.getElementById('chName').value = r.name;
                    document.getElementById('chConfig').value = configStr;
                    document.getElementById('chDefault').checked = r.isDefault;
                    updateConfigTemplate();
                    document.getElementById('chName').focus();
                    window.scrollTo({ top: 0, behavior: 'smooth' });
                };

                list.appendChild(item);
            });
        } catch (e) {
            console.error(e);
            list.innerHTML = '<div class="text-danger">Failed to load channels</div>';
        }
    }

    async function saveChannel() {
        try {
            const channelType = document.getElementById('chType').value;
            const name = document.getElementById('chName').value.trim();
            const cfgRaw = document.getElementById('chConfig').value.trim();
            const isDefault = document.getElementById('chDefault').checked;
            if (!name || !cfgRaw) return alert('Name and config are required');
            const config = JSON.parse(cfgRaw);
            const res = await fetch(`${API_BASE}/admin/notification-channels`, {
                method: 'POST',
                headers: getAuthHeaders(),
                body: JSON.stringify({ channelType, name, config, isDefault, status: 'ACTIVE' })
            });
            const data = await res.json();
            if (!res.ok) throw new Error(data.error || 'Save failed');
            showToast('Channel saved');
            loadChannels();
        } catch (e) {
            alert(`Failed: ${e.message}`);
        }
    }

    async function deleteChannel(id) {
        const res = await fetch(`${API_BASE}/admin/notification-channels/${id}`, {
            method: 'DELETE',
            headers: getAuthHeaders()
        });
        const data = await res.json();
        if (!res.ok) return alert(data.error || 'Delete failed');
        loadChannels();
    }

    async function testChannel(channelType, name) {
        const sampleByType = {
            EMAIL: { params: { to: 'ops@example.com', subject: 'Settings Test {{newRow.id}}', text: 'Settings test for {{triggerName}}' } },
            TELEGRAM: { params: { chatId: '@tenant_ops', text: 'Settings test {{newRow.id}}' } },
            WEBHOOK: { url: 'https://example.local/test', method: 'POST', payload: { kind: 'settings-test', id: '{{newRow.id}}' } }
        };
        const res = await fetch(`${API_BASE}/admin/notification-channels/test`, {
            method: 'POST',
            headers: getAuthHeaders(),
            body: JSON.stringify({ channelType, name, sample: sampleByType[channelType] || {} })
        });
        const data = await res.json();
        if (!res.ok) return alert(data.error || 'Test failed');
        showToast(`Test job queued: ${data.jobId}`);
    }

    let isJsonMode = false;
    function toggleJsonMode() {
        isJsonMode = !isJsonMode;
        document.getElementById('dynamicFieldsContainer').style.display = isJsonMode ? 'none' : 'block';
        document.getElementById('jsonModeContainer').style.display = isJsonMode ? 'block' : 'none';
        document.getElementById('jsonModeToggle').style.display = isJsonMode ? 'none' : 'block';
        if (!isJsonMode) syncFieldsFromConfig();
    }

    function syncFieldsFromConfig() {
        const type = document.getElementById('chType').value;
        const configStr = document.getElementById('chConfig').value;
        try {
            const config = JSON.parse(configStr || '{}');
            if (type === 'EMAIL') {
                setVal('df_from', config.fromEmail);
                setVal('df_to', config.defaultTo);
                setVal('df_host', config.smtp?.host);
                setVal('df_port', config.smtp?.port);
                setVal('df_user', config.smtp?.auth?.user);
                setVal('df_pass', config.smtp?.auth?.pass);
            } else if (type === 'TELEGRAM') {
                setVal('df_token', config.botToken);
                setVal('df_chat', config.chatId);
            } else if (type === 'WEBHOOK') {
                setVal('df_url', config.url);
                setVal('df_method', config.method);
                setVal('df_headers', JSON.stringify(config.headers || {}, null, 2));
            }
        } catch (e) {}
    }

    function setVal(id, val) {
        const el = document.getElementById(id);
        if (el) el.value = val || '';
    }

    function syncConfigFromFields() {
        const type = document.getElementById('chType').value;
        let config = {};
        if (type === 'EMAIL') {
            config = {
                fromEmail: document.getElementById('df_from').value,
                defaultTo: document.getElementById('df_to').value,
                smtp: {
                    host: document.getElementById('df_host').value,
                    port: parseInt(document.getElementById('df_port').value) || 587,
                    auth: {
                        user: document.getElementById('df_user').value,
                        pass: document.getElementById('df_pass').value
                    }
                }
            };
        } else if (type === 'TELEGRAM') {
            config = {
                botToken: document.getElementById('df_token').value,
                chatId: document.getElementById('df_chat').value
            };
        } else if (type === 'WEBHOOK') {
            config = {
                url: document.getElementById('df_url').value,
                method: document.getElementById('df_method').value,
                headers: {}
            };
            try { config.headers = JSON.parse(document.getElementById('df_headers').value || '{}'); } catch(e) {}
        }
        document.getElementById('chConfig').value = JSON.stringify(config, null, 2);
    }

    function updateConfigTemplate(force = false) {
        const type = document.getElementById('chType').value;
        const container = document.getElementById('dynamicFieldsContainer');
        
        const fieldMap = {
            EMAIL: `
                <div style="display:grid; grid-template-columns: 1fr 1fr; gap:0.75rem; margin-bottom:0.75rem;">
                    <div><label class="trg-label">From Email</label><input id="df_from" class="trg-input" oninput="syncConfigFromFields()"></div>
                    <div><label class="trg-label">Default To</label><input id="df_to" class="trg-input" oninput="syncConfigFromFields()"></div>
                </div>
                <div style="display:grid; grid-template-columns: 2fr 1fr; gap:0.75rem; margin-bottom:0.75rem;">
                    <div><label class="trg-label">SMTP Host</label><input id="df_host" class="trg-input" oninput="syncConfigFromFields()"></div>
                    <div><label class="trg-label">Port</label><input id="df_port" class="trg-input" value="587" oninput="syncConfigFromFields()"></div>
                </div>
                <div style="display:grid; grid-template-columns: 1fr 1fr; gap:0.75rem;">
                    <div><label class="trg-label">SMTP User</label><input id="df_user" class="trg-input" oninput="syncConfigFromFields()"></div>
                    <div><label class="trg-label">SMTP Pass</label><input id="df_pass" type="password" class="trg-input" oninput="syncConfigFromFields()"></div>
                </div>
            `,
            TELEGRAM: `
                <div class="full" style="margin-bottom:0.75rem;"><label class="trg-label">Bot Token</label><input id="df_token" class="trg-input" oninput="syncConfigFromFields()"></div>
                <div class="full"><label class="trg-label">Default Chat ID</label><input id="df_chat" class="trg-input" oninput="syncConfigFromFields()"></div>
            `,
            WEBHOOK: `
                <div style="display:grid; grid-template-columns: 3fr 1fr; gap:0.75rem; margin-bottom:0.75rem;">
                    <div><label class="trg-label">Webhook URL</label><input id="df_url" class="trg-input" oninput="syncConfigFromFields()"></div>
                    <div><label class="trg-label">Method</label><select id="df_method" class="trg-select" oninput="syncConfigFromFields()"><option>POST</option><option>GET</option><option>PUT</option></select></div>
                </div>
                <div class="full"><label class="trg-label">Default Headers (JSON)</label><textarea id="df_headers" class="trg-text" oninput="syncConfigFromFields()">{}</textarea></div>
            `
        };

        container.innerHTML = fieldMap[type] || '';
        if (force) {
            document.getElementById('chConfig').value = ''; 
        }
        syncFieldsFromConfig();
        document.getElementById('chName').placeholder = `primary_${type.toLowerCase()}`;
    }

    async function saveChannel() {
        try {
            if (!isJsonMode) syncConfigFromFields();
            const channelType = document.getElementById('chType').value;
            const name = document.getElementById('chName').value.trim();
            const cfgRaw = document.getElementById('chConfig').value.trim();
            const isDefault = document.getElementById('chDefault').checked;
            if (!name || !cfgRaw) return alert('Name and config are required');
            const config = JSON.parse(cfgRaw);
            const res = await fetch(`${API_BASE}/admin/notification-channels`, {
                method: 'POST',
                headers: getAuthHeaders(),
                body: JSON.stringify({ channelType, name, config, isDefault, status: 'ACTIVE' })
            });
            const data = await res.json();
            if (!res.ok) throw new Error(data.error || 'Save failed');
            showToast('Channel saved');
            loadChannels();
        } catch (e) {
            alert(`Failed: ${e.message}`);
        }
    }

    document.addEventListener('DOMContentLoaded', () => {
        loadDownstreamStatus();
        loadChannels();
        updateConfigTemplate();
    });
</script>

<%- include('partials/footer') %>
