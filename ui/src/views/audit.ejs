<%- include('partials/header') %>

<div class="page fade-in">
    <div class="page-head">
        <div>
            <h1 class="page-title">Audit logs</h1>
            <p class="page-sub">Query execution traces and immutable row-level governance history.</p>
        </div>
    </div>

    <!-- Query execution audit trail -->
    <section class="glass-card">
        <div class="card-head">
            <div>
                <h3>Query Execution Log</h3>
                <p>Every query the fabric runs: legs, turnaround time (TAT), memory, and plan. Click <strong>View</strong> for the full trace.</p>
            </div>
            <div class="card-actions"><button type="button" onclick="loadQueryLogs()" class="btn-outline">Refresh</button></div>
        </div>
        <div class="table-wrapper">
            <table>
                <thead><tr>
                    <th>Time</th><th>User</th><th>Mode</th><th>Strategy</th><th>Rows</th>
                    <th>TAT</th><th>Exec</th><th>Mem</th><th>Status</th><th><span class="sr-only">Actions</span></th>
                </tr></thead>
                <tbody id="qlBody"><tr><td colspan="10" class="state-cell">Loading…</td></tr></tbody>
            </table>
        </div>
    </section>

    <!-- Governance audit logs (row changes) -->
    <section class="glass-card">
        <div class="card-head">
            <div>
                <h3>Security Forensics &amp; Audit Logs</h3>
                <p>Immutable history of row-level fabric operations.</p>
            </div>
            <div class="card-actions"><button type="button" onclick="loadAudit()" class="btn-outline">Refresh Logs</button></div>
        </div>
        <div class="table-wrapper">
            <table>
                <thead><tr><th>Time</th><th>User</th><th>Action</th><th>Table</th><th>Payload</th><th><span class="sr-only">Actions</span></th></tr></thead>
                <tbody id="auditBody"><tr><td colspan="6" class="state-cell">Streaming logs...</td></tr></tbody>
            </table>
        </div>
    </section>
</div>

<!-- Query detail modal -->
<div id="qlModal" class="modal-overlay" role="dialog" aria-modal="true" aria-labelledby="qlTitle">
  <div class="modal-card lg">
    <div class="modal-header">
      <h3 id="qlTitle">Query detail</h3>
      <button type="button" onclick="closeQl()" class="modal-close" aria-label="Close dialog">&times;</button>
    </div>
    <div id="qlDetail" class="modal-body"></div>
  </div>
</div>

<!-- Governance audit detail modal -->
<div id="auditModal" class="modal-overlay" role="dialog" aria-modal="true" aria-labelledby="auditTitle">
  <div class="modal-card lg">
    <div class="modal-header">
      <h3 id="auditTitle">Audit detail</h3>
      <button type="button" onclick="closeAudit()" class="modal-close" aria-label="Close dialog">&times;</button>
    </div>
    <div id="auditDetail" class="modal-body"></div>
  </div>
</div>

<script>
    let QLOGS = [];
    async function loadQueryLogs() {
        const body = document.getElementById('qlBody');
        body.innerHTML = '<tr><td colspan="10" class="state-cell">Loading…</td></tr>';
        try {
            const res = await fetch(`${API_BASE}/query-logs?limit=300`, { headers: getAuthHeaders() });
            QLOGS = await res.json();
            if (!Array.isArray(QLOGS) || !QLOGS.length) { body.innerHTML = '<tr><td colspan="10" class="state-cell">No query logs yet — run a query in the Workbench or Analytics.</td></tr>'; return; }
            body.innerHTML = QLOGS.map((l,i) => `
                <tr class="fade-in">
                    <td><code>${escapeHtml(new Date(l.createdAt).toLocaleTimeString())}</code></td>
                    <td>${escapeHtml(l.username||'')}${l.role?` <span class="tag">${escapeHtml(l.role)}</span>`:''}</td>
                    <td><span class="tag">${escapeHtml(l.mode)}</span></td>
                    <td><code>${escapeHtml(l.strategy||'—')}</code></td>
                    <td>${escapeHtml(l.rowCount ?? '—')}</td>
                    <td>${escapeHtml(l.tatMs ?? '—')}ms</td>
                    <td>${escapeHtml(l.executionMs ?? '—')}ms</td>
                    <td>${escapeHtml(l.memDeltaKb ?? '—')}KB</td>
                    <td class="${l.status==='ERROR'?'text-danger':'text-ok'}">${escapeHtml(l.status)}</td>
                    <td><button class="btn-outline btn-sm" onclick="viewQl('${escapeHtml(l.id)}')">View</button></td>
                </tr>`).join('');
        } catch(e) { body.innerHTML = '<tr><td colspan="10" class="state-cell">Failed to load query logs.</td></tr>'; }
    }

    async function viewQl(id) {
        const res = await fetch(`${API_BASE}/query-logs/${id}`, { headers: getAuthHeaders() });
        const l = await res.json();
        if (l.error) { showModal('Error', l.error); return; }
        document.getElementById('qlTitle').innerText = `${l.mode} · ${l.strategy||''}`;
        const legs = (l.legs||[]).map(x => `
            <div class="mini-box"><strong>${escapeHtml(x.source||'')}</strong>
              <span class="tag">${escapeHtml(x.engine||'')}/${escapeHtml(x.mode||'')}</span>
              ${escapeHtml(x.operation||'')} → <strong>${escapeHtml(x.rowsReturned ?? '—')}</strong> rows in ${escapeHtml(x.ms ?? '—')}ms
              ${x.target?`<div class="text-muted small">${escapeHtml(x.target)}</div>`:''}
              ${x.query?`<pre class="code-block sm mt-1">${escapeHtml(x.query)}</pre>`:''}
            </div>`).join('') || '<div class="text-muted">No per-leg trace (single-statement execution).</div>';
        document.getElementById('qlDetail').innerHTML = `
            <div class="mini-grid">
              <div><div class="k">TAT (wall)</div><div class="v">${escapeHtml(l.tatMs ?? '—')} ms</div></div>
              <div><div class="k">Engine exec</div><div class="v">${escapeHtml(l.executionMs ?? '—')} ms</div></div>
              <div><div class="k">Memory Δ</div><div class="v">${escapeHtml(l.memDeltaKb ?? '—')} KB</div></div>
              <div><div class="k">Rows</div><div class="v">${escapeHtml(l.rowCount ?? '—')}</div></div>
              <div><div class="k">Rows scanned</div><div class="v">${escapeHtml(l.rowsScanned ?? '—')}</div></div>
              <div><div class="k">Status</div><div class="v ${l.status==='ERROR'?'text-danger':'text-ok'}">${escapeHtml(l.status)}</div></div>
            </div>
            <div class="text-muted small">${escapeHtml(l.username||'')} ${l.role?'· '+escapeHtml(l.role):''} · ${escapeHtml(l.api||'')} · ${escapeHtml(new Date(l.createdAt).toLocaleString())}</div>
            ${l.error?`<p class="text-danger mt-1">⚠ ${escapeHtml(l.error)}</p>`:''}
            <h4 class="detail-h">Query</h4>
            <pre class="code-block">${escapeHtml(l.queryText||'')}</pre>
            <h4 class="detail-h">Execution legs (${(l.legs||[]).length})</h4>
            ${legs}
            ${(l.pushed||[]).length?`<h4 class="detail-h">Pushdown / compensation</h4>${(l.pushed||[]).map(p=>`<div class="text-muted small">• ${escapeHtml(p)}</div>`).join('')}`:''}
            ${(l.warnings||[]).length?`<h4 class="detail-h">Warnings</h4>${(l.warnings||[]).map(w=>`<div class="text-warning small">⚠ ${escapeHtml(w)}</div>`).join('')}`:''}
        `;
        document.getElementById('qlModal').classList.add('active');
    }
    function closeQl(){ document.getElementById('qlModal').classList.remove('active'); }

    let AUDITLOGS = [];
    async function loadAudit() {
        const body = document.getElementById('auditBody');
        body.innerHTML = '<tr><td colspan="6" class="state-cell">Streaming logs…</td></tr>';
        try {
            const response = await fetch(`${API_BASE}/admin/audit-logs`, { headers: getAuthHeaders() });
            const data = await response.json();
            if (!Array.isArray(data)) { body.innerHTML = '<tr><td colspan="6" class="state-cell">No audit logs available</td></tr>'; return; }
            AUDITLOGS = data.slice(0, 500);
            body.innerHTML = AUDITLOGS.map((log, i) => `
                <tr class="fade-in">
                    <td><code>${escapeHtml(new Date(log.changed_at).toLocaleString())}</code></td>
                    <td><strong>${escapeHtml(log.user_name)}</strong></td>
                    <td><span class="badge ${log.action === 'DELETE' ? 'badge-danger' : 'badge-info'}">${escapeHtml(log.action)}</span></td>
                    <td><code>${escapeHtml(log.table_name)}</code></td>
                    <td><div class="cell-clip" title="Open View for the full payload">${escapeHtml(JSON.stringify(log.new_data || log.old_data))}</div></td>
                    <td><button class="btn-outline btn-sm" onclick="viewAudit(${i})">View</button></td>
                </tr>`).join('') + (data.length > 500 ? `<tr><td colspan="6" class="state-cell">Showing 500 of ${escapeHtml(data.length)} logs</td></tr>` : '');
        } catch (err) { body.innerHTML = '<tr><td colspan="6" class="state-cell">Failed to fetch governance logs</td></tr>'; }
    }

    // Full forensic detail for one governance row-change event, with an old→new field diff.
    function viewAudit(i) {
        const l = AUDITLOGS[i];
        if (!l) return;
        const oldD = l.old_data || {};
        const newD = l.new_data || {};
        const keys = [...new Set([...Object.keys(oldD), ...Object.keys(newD)])].sort();
        const cell = (v) => v === undefined ? '<span class="text-muted">—</span>' : escapeHtml(typeof v === 'object' ? JSON.stringify(v) : String(v));
        const diffRows = keys.map((k) => {
            const before = oldD[k], after = newD[k];
            const changed = JSON.stringify(before) !== JSON.stringify(after);
            return `<tr${changed ? ' class="row-changed"' : ''}>
                <td><strong>${escapeHtml(k)}</strong>${changed ? ' <span class="tag">changed</span>' : ''}</td>
                <td><code>${cell(before)}</code></td>
                <td><code>${cell(after)}</code></td>
            </tr>`;
        }).join('') || '<tr><td colspan="3" class="state-cell">No field data recorded.</td></tr>';
        document.getElementById('auditTitle').innerText = `${l.action} · ${l.table_name}`;
        document.getElementById('auditDetail').innerHTML = `
            <div class="mini-grid">
              <div><div class="k">Action</div><div class="v">${escapeHtml(l.action)}</div></div>
              <div><div class="k">Table</div><div class="v">${escapeHtml(l.table_name)}</div></div>
              <div><div class="k">Row ID</div><div class="v">${escapeHtml(l.row_id ?? '—')}</div></div>
              <div><div class="k">Tenant</div><div class="v">${escapeHtml(l.tenant_id ?? '—')}</div></div>
              <div><div class="k">User</div><div class="v">${escapeHtml(l.user_name ?? '—')}</div></div>
              <div><div class="k">When</div><div class="v">${escapeHtml(new Date(l.changed_at).toLocaleString())}</div></div>
            </div>
            <h4 class="detail-h">Field changes (before → after)</h4>
            <div class="table-wrapper"><table>
              <thead><tr><th>Column</th><th>Before</th><th>After</th></tr></thead>
              <tbody>${diffRows}</tbody>
            </table></div>
            <h4 class="detail-h">Raw payloads</h4>
            <div class="cols-2">
              <div><div class="text-muted small">old_data</div><pre class="code-block md">${escapeHtml(JSON.stringify(l.old_data ?? null, null, 2))}</pre></div>
              <div><div class="text-muted small">new_data</div><pre class="code-block md">${escapeHtml(JSON.stringify(l.new_data ?? null, null, 2))}</pre></div>
            </div>`;
        document.getElementById('auditModal').classList.add('active');
    }
    function closeAudit(){ document.getElementById('auditModal').classList.remove('active'); }

    loadQueryLogs();
    loadAudit();
</script>

<%- include('partials/footer') %>
