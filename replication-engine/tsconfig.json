{
  "compilerOptions": {
    "target": "ESNext",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": false,
    "skipLibCheck": true,
    "outDir": "dist"
  },
  "include": ["src/**/*", "../backend/src/**/*"],
  "exclude": ["../backend/src/**/*.test.ts", "../backend/src/tests/**/*", "../backend/scratch/**/*",
    "../backend/src/diagnose_api.ts", "../backend/src/check_users*.ts", "../backend/src/verify_*.ts", "../backend/src/seed_admin.ts"]
}
