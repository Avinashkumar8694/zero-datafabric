<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <script>
        // Theme before first paint: saved choice, else the system preference, else dark (shared with the landing page).
        (function () {
            var t = null;
            try { t = localStorage.getItem('df-theme'); } catch (e) {}
            if (t !== 'light' && t !== 'dark') t = (window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches) ? 'light' : 'dark';
            document.documentElement.setAttribute('data-theme', t);
        })();
        function toggleTheme() {
            var next = document.documentElement.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
            document.documentElement.setAttribute('data-theme', next);
            try { localStorage.setItem('df-theme', next); } catch (e) {}
        }
    </script>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/pages.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&family=Outfit:wght@400;600;800&display=swap" rel="stylesheet">
    <script>
        // Global Industrial API Orchestration
        const API_BASE = window.location.hostname.includes('fabrixly.com') 
            ? `/api`
            : ((window.location.hostname === 'localhost' && localStorage.getItem('df_api_base')) || `http://${window.location.hostname}:4000`) + '/api';
        function getToken() {
            return localStorage.getItem('token');
        }
        function getDecodedToken() {
            const token = getToken();
            if (!token) return null;
            try {
                const base64Url = token.split('.')[1];
                const base64 = base64Url.replace(/-/g, '+').replace(/_/g, '/');
                const jsonPayload = decodeURIComponent(window.atob(base64).split('').map(function(c) {
                    return '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2);
                }).join(''));
                return JSON.parse(jsonPayload);
            } catch (e) {
                return null;
            }
        }
        function performLogout() {
            let isSso = localStorage.getItem('auth_method') === 'sso';
            if (!isSso) {
                const decoded = getDecodedToken();
                if (decoded && decoded.auth_method === 'sso') {
                    isSso = true;
                }
            }
            localStorage.removeItem('token');
            localStorage.removeItem('active_tenant');
            localStorage.removeItem('auth_method');
            if (isSso) {
                const homeUrl = window.location.origin + '/';
                window.location.href = `${API_BASE}/auth/sso/logout?redirect_uri=${encodeURIComponent(homeUrl)}`;
            } else {
                window.location.href = '/login';
            }
        }
        {
            const publicPaths = ['/', '/login', '/logout'];
            const isPublic = publicPaths.some(p => window.location.pathname === p || window.location.pathname.startsWith(p + '?'));
            if (!getToken() && !isPublic) {
                window.location.href = '/login';
            }
        }

        // Industrial Identity Propagation Helper
        function getAuthHeaders() {
            return {
                'Authorization': `Bearer ${getToken()}`,
                'Content-Type': 'application/json',
                'x-tenant-id': localStorage.getItem('active_tenant') || 'tenant_A'
            };
        }

        // Global HTML-escape for safe interpolation of API/datasource values into innerHTML
        // and into onclick/attribute contexts. Available to every screen (defined before view scripts).
        function escapeHtml(v) {
            if (v === null || v === undefined) return '';
            const s = typeof v === 'object' ? JSON.stringify(v) : String(v);
            return s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
        }
        // Escape for use inside a single-quoted JS string in an inline onclick handler.
        function escapeJs(v) {
            return String(v ?? '').replace(/\\/g, '\\\\').replace(/'/g, "\\'").replace(/"/g, '\\"').replace(/</g, '\\x3C');
        }

        const nativeFetch = window.fetch.bind(window);
        window.fetch = async (...args) => {
            const response = await nativeFetch(...args);
            if (response.status === 401) {
                const url = typeof args[0] === 'string' ? args[0] : (args[0]?.url || '');
                if (!url.includes('/api/settings/login')) {
                    performLogout();
                }
            }
            return response;
        };
    </script>
</head>
<body class="<%= title.includes('Login') || title.includes('Home') ? 'login-page' : '' %>">
    <div class="app-layout">
        <% if (!title.includes('Login') && !title.includes('Home') && !title.includes('Logout')) { %>
        <!-- Sidebar Navigation -->
        <aside class="sidebar">
            <div class="sidebar-header">
                <div class="logo">
                    <div class="logo-icon"></div>
                    <span>Zero Data Fabric</span>
                </div>
                <button id="sidebarCloseBtn" class="sidebar-close-btn" aria-label="Close Navigation">
                    <i class="fas fa-times" aria-hidden="true"></i>
                </button>
            </div>
            <nav class="sidebar-nav" aria-label="Main navigation">
                <a href="/dashboard" class="nav-item" id="nav-dashboard"><i class="fas fa-chart-line"></i> Overview</a>
                <a href="/tenants" class="nav-item" id="nav-tenants"><i class="fas fa-building"></i> Tenants</a>
                <a href="/connections" class="nav-item" id="nav-connections"><i class="fas fa-link"></i> Connections</a>
                <a href="/replication" class="nav-item" id="nav-replication"><i class="fas fa-copy"></i> Replication</a>
                <a href="/workbench" class="nav-item" id="nav-workbench"><i class="fas fa-terminal"></i> Workbench</a>
                <a href="/analytics" class="nav-item" id="nav-analytics"><i class="fas fa-chart-pie"></i> Analytics</a>
                <a href="/analytics/custom" class="nav-item" id="nav-custom-analytics"><i class="fas fa-wand-magic-sparkles"></i> Custom Analytics</a>
                <a href="/catalog" class="nav-item" id="nav-catalog"><i class="fas fa-search"></i> Explorer</a>
                <a href="/metadata" class="nav-item" id="nav-metadata"><i class="fas fa-cubes"></i> Catalog</a>
                <a href="/iam" class="nav-item" id="nav-iam"><i class="fas fa-users-cog"></i> Identity</a>
                <a href="/audit" class="nav-item" id="nav-audit"><i class="fas fa-shield-halved"></i> Audit Logs</a>
                <a href="/triggers" class="nav-item" id="nav-triggers"><i class="fas fa-bolt"></i> Triggers</a>
                <a href="/plans" class="nav-item" id="nav-plans"><i class="fas fa-tags"></i> Plans</a>
                <a href="/integration-guide" class="nav-item" id="nav-integration-guide"><i class="fas fa-book"></i> Integration Guide</a>
                <div class="nav-spacer"></div>
                <a href="/system" class="nav-item" id="nav-system" style="display:none"><i class="fas fa-server"></i> System</a>
                <a href="/settings" class="nav-item" id="nav-settings"><i class="fas fa-cog"></i> Settings</a>
            </nav>
            <div class="sidebar-footer">
                <div class="user-profile">
                    <div class="avatar" id="userAvatar">A</div>
                    <div class="user-info">
                        <span class="username" id="displayUsername">Admin</span>
                        <span class="tenant" id="displayTenant">tenant_A</span>
                    </div>
                </div>
                <button id="logoutBtn" class="logout-btn">Log Out</button>
            </div>
        </aside>
        <div id="sidebarOverlay" class="sidebar-overlay"></div>
        <% } %>

        <!-- Main Content Area -->
        <main class="main-content">
            <% if (!title.includes('Login') && !title.includes('Home') && !title.includes('Logout')) { %>
            <header class="top-bar">
                <div class="top-bar-left">
                    <button id="sidebarToggleBtn" class="sidebar-toggle-btn" aria-label="Toggle Navigation">
                        <i class="fas fa-bars" aria-hidden="true"></i>
                    </button>
                    <h2><%= title.split(' - ')[1] %></h2>
                </div>
                <div class="top-bar-right">
                    <div class="identity-context">
                        <select id="tenantSwitcher" class="context-select" aria-label="Active tenant"></select>
                    </div>
                    <button type="button" class="theme-toggle-btn" onclick="toggleTheme()" aria-label="Switch between dark and light theme" title="Theme">
                        <svg class="i-moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
                        <svg class="i-sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8zM12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
                    </button>
                    <button id="topLogoutBtn" class="btn-outline top-logout-btn" title="Log Out" aria-label="Log Out">
                        <i class="fas fa-arrow-right-from-bracket"></i>
                        <span class="top-logout-text">Log Out</span>
                    </button>
                </div>
            </header>
            
            <!-- Expired Trial Warning Banner -->
            <div id="trialExpiredBanner" class="alert-bar" role="alert" style="display: none;">
                <div class="alert-bar-icon"><i class="fas fa-triangle-exclamation" aria-hidden="true"></i></div>
                <div class="alert-bar-body">
                    <strong>Trial Subscription Expired</strong>
                    <span>Your trial period has expired. You are not allowed to perform any actions. Please <a href="mailto:fabric@fabrixly.com?subject=Trial%20Extension%20/%20Self%20Deployment%20Inquiry">contact us at fabric@fabrixly.com</a> for self-deployment setup and subscription options.</span>
                </div>
            </div>
            <% } %>
            <div class="content-wrapper">

    <!-- Premium Modal Overlay -->
    <div id="fabricModal" class="modal-overlay" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
        <div class="modal-card">
            <div class="modal-header">
                <h3 id="modalTitle">Notification</h3>
                <button type="button" class="modal-close" onclick="closeModal()" aria-label="Close dialog">&times;</button>
            </div>
            <div id="modalBody" class="modal-body">
                Message goes here...
            </div>
            <div class="modal-footer">
                <button id="modalSecondaryBtn" class="btn-outline" onclick="closeModal()">Cancel</button>
                <button id="modalPrimaryBtn" class="btn-primary" onclick="closeModal()">Confirm</button>
            </div>
        </div>
    </div>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <script>
        // Premium Modal Orchestrator
        function showModal(title, message, onConfirm = null, confirmText = 'OK') {
            document.getElementById('modalTitle').innerText = title;
            document.getElementById('modalBody').innerText = message;
            const primaryBtn = document.getElementById('modalPrimaryBtn');
            primaryBtn.innerText = confirmText;
            
            const secondaryBtn = document.getElementById('modalSecondaryBtn');
            secondaryBtn.style.display = onConfirm ? '' : 'none';

            primaryBtn.onclick = () => {
                if (onConfirm) onConfirm();
                closeModal();
            };
            
            document.getElementById('fabricModal').classList.add('active');
        }

        function closeModal() {
            document.getElementById('fabricModal').classList.remove('active');
        }

        // Global Alert Override for Premium UX
        window.alert = (msg) => showModal('Notice', msg);

        // Identity context logic
        async function loadTenantSwitcher() {
            const switcher = document.getElementById('tenantSwitcher');
            if (!switcher) return;
            try {
                const res = await fetch(`${API_BASE}/tenants`, { headers: getAuthHeaders() });
                const tenants = await res.json();
                if (Array.isArray(tenants)) {
                    switcher.innerHTML = tenants.map(t => `<option value="${t.id}">${t.name} (${t.id})</option>`).join('');
                    const activeTenant = localStorage.getItem('active_tenant');
                    if (activeTenant) switcher.value = activeTenant;
                    else if (tenants.length > 0) localStorage.setItem('active_tenant', tenants[0].id);
                }
            } catch (e) { switcher.innerHTML = '<option value="">Error Loading</option>'; }
        }

        document.getElementById('tenantSwitcher')?.addEventListener('change', async (e) => {
            const newTenant = e.target.value;
            try {
                const res = await fetch(`${API_BASE}/auth/token`, {
                    method: 'POST',
                    headers: getAuthHeaders(),
                    body: JSON.stringify({ tenantId: newTenant })
                });
                const data = await res.json();
                if (data.token) {
                    localStorage.setItem('token', data.token);
                    localStorage.setItem('active_tenant', newTenant);
                    window.location.reload();
                }
            } catch (err) { console.error('[Identity] Switch failed'); }
        });

        function getDecodedToken() {
            const token = getToken();
            if (!token) return null;
            try {
                const base64Url = token.split('.')[1];
                const base64 = base64Url.replace(/-/g, '+').replace(/_/g, '/');
                const jsonPayload = decodeURIComponent(window.atob(base64).split('').map(function(c) {
                    return '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2);
                }).join(''));
                return JSON.parse(jsonPayload);
            } catch (e) {
                return null;
            }
        }

        async function checkTrialStatus() {
            // Exclude pages that do not show top bar
            if (window.location.pathname.includes('/login') || window.location.pathname.includes('/logout') || window.location.pathname === '/') {
                return;
            }
            try {
                const res = await fetch(`${API_BASE}/subscriptions/me`, { headers: getAuthHeaders() });
                if (!res.ok) return;
                const sub = await res.json();
                if (sub) {
                    if (sub.plan_name === 'selfhost') {
                        // Hide Plans related configuration / tab
                        const plansTab = document.getElementById('nav-plans');
                        if (plansTab) plansTab.style.display = 'none';
                    }
                    if (sub.is_trial_expired) {
                        const banner = document.getElementById('trialExpiredBanner');
                        if (banner) {
                            banner.style.display = 'flex';
                        }
                        
                        // Disable all action buttons and forms on the page
                        setTimeout(() => {
                            const inputs = document.querySelectorAll('input, select, textarea, button');
                            inputs.forEach(el => {
                                if (el.id !== 'tenantSwitcher' && el.id !== 'logoutBtn' && el.id !== 'topLogoutBtn') {
                                    el.disabled = true;
                                    el.style.opacity = '0.6';
                                    el.style.cursor = 'not-allowed';
                                }
                            });
                            
                            // Disable links
                            const links = document.querySelectorAll('a');
                            links.forEach(el => {
                                if (!el.href.startsWith('mailto:') && !el.id?.includes('logout') && el.href !== window.location.href) {
                                    el.style.pointerEvents = 'none';
                                    el.style.opacity = '0.5';
                                }
                            });
                        }, 500);
                    }
                }
            } catch (e) {
                console.error('[TrialCheck] Error checking subscription trial status:', e);
            }
        }

        window.addEventListener('load', () => {
            loadTenantSwitcher();
            checkTrialStatus();

            // Populate profile details and gate admin tabs
            const decoded = getDecodedToken();
            if (decoded) {
                const username = decoded.username || decoded.email || 'User';
                const tenant = decoded.tenant_id || 'tenant_A';
                const role = decoded.internal_role || 'USER';
                
                const displayUsername = document.getElementById('displayUsername');
                if (displayUsername) displayUsername.innerText = username;
                
                const displayTenant = document.getElementById('displayTenant');
                if (displayTenant) displayTenant.innerText = tenant;
                
                const userAvatar = document.getElementById('userAvatar');
                if (userAvatar) userAvatar.innerText = username.charAt(0).toUpperCase();
                
                // The System page (platform administration) is only offered to platform admins
                const navSystem = document.getElementById('nav-system');
                if (navSystem && role === 'ADMIN') navSystem.style.display = '';

                // Hide Admin-only tabs if not admin
                if (role !== 'ADMIN') {
                    const adminTabs = ['nav-plans', 'nav-tenants', 'nav-iam', 'nav-audit'];
                    adminTabs.forEach(id => {
                        const el = document.getElementById(id);
                        if (el) el.style.display = 'none';
                    });
                }
            }
        });

        document.getElementById('logoutBtn')?.addEventListener('click', performLogout);
        document.getElementById('topLogoutBtn')?.addEventListener('click', performLogout);

        // Mobile Sidebar Controls
        function toggleMobileSidebar(forceClose = false) {
            const sidebar = document.querySelector('.sidebar');
            const overlay = document.getElementById('sidebarOverlay');
            if (!sidebar || !overlay) return;
            if (forceClose || sidebar.classList.contains('mobile-open')) {
                sidebar.classList.remove('mobile-open');
                overlay.classList.remove('active');
                document.body.style.overflow = '';
            } else {
                sidebar.classList.add('mobile-open');
                overlay.classList.add('active');
                if (window.innerWidth <= 900) {
                    document.body.style.overflow = 'hidden';
                }
            }
        }

        document.getElementById('sidebarToggleBtn')?.addEventListener('click', () => toggleMobileSidebar());
        document.getElementById('sidebarCloseBtn')?.addEventListener('click', () => toggleMobileSidebar(true));
        document.getElementById('sidebarOverlay')?.addEventListener('click', () => toggleMobileSidebar(true));

        document.querySelectorAll('.nav-item').forEach(link => {
            link.addEventListener('click', () => {
                if (window.innerWidth <= 900) {
                    toggleMobileSidebar(true);
                }
            });
        });

        window.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') toggleMobileSidebar(true);
        });

        window.addEventListener('resize', () => {
            if (window.innerWidth > 900) {
                toggleMobileSidebar(true);
            }
        });
    </script>

