      <div class="stat-item">
        <div class="stat-num">TypeORM</div>
        <div class="stat-label">Versioned Migrations</div>
      </div>
    </div>
  </section>

  <!-- ── Features ── -->
  <section class="section" id="features">
    <div class="section-label">Capabilities</div>
    <h2 class="section-title">Everything in one platform</h2>
    <p class="section-sub">
      From multi-source federation to real-time triggers and governed analytics —
      Zero Fabric handles the entire data layer so your team doesn't have to.
    </p>

    <div class="features-grid">
      <div class="feature-card">
