<%- include('partials/header') %>

<div class="fade-in">
    <div class="glass-card">
        <h3>Metadata Orchestration</h3>
        <p class="text-muted" style="margin-bottom: 2rem;">Declarative schema management via industrial orchestration blueprints.</p>
        
        <div class="grid">
            <!-- Template Download -->
            <section class="glass-card" style="background: var(--bg);">
                <h4>Orchestration Blueprint</h4>
                <p class="text-muted" style="font-size: 0.8rem; margin-bottom: 1.5rem;">Download the definitive V7.0 specification as a reference for your target state.</p>
                <div style="display: flex; gap: 0.5rem;">
                    <button onclick="downloadTemplate()" class="btn-outline" style="flex: 1;">Download Spec</button>
                    <button onclick="loadTemplateForAnalysis()" class="btn-primary" style="flex: 1;">Load Industrial Blueprint</button>
                </div>
            </section>

            <!-- File Upload for Diff/Apply -->
            <section class="glass-card" style="background: var(--bg);">
                <h4>Target State Manifest</h4>
                <p class="text-muted" style="font-size: 0.8rem; margin-bottom: 1.5rem;">Select a manifest file (.json) to analyze or apply schema changes.</p>
                <div style="display: flex; gap: 0.5rem; flex-direction: column;">
                    <input type="file" id="manifestFile" accept=".json" class="context-select" style="width: 100%; height: auto; padding: 0.5rem;">
                    <div style="display: flex; gap: 0.5rem; margin-top: 0.5rem;">
                        <button onclick="analyzeManifest()" id="diffBtn" class="btn-outline" style="flex: 1;">Analyze Drift (Diff)</button>
                        <button onclick="applyManifest()" id="applyBtn" class="btn-primary" style="flex: 1;">Orchestrate (Apply)</button>
                    </div>
                </div>
            </section>
        </div>
    </div>

    <!-- Orchestration Plan / Results -->
    <div id="resultCard" class="glass-card" style="display: none; margin-top: 1.5rem;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
            <h3 id="resultTitle">Orchestration Plan</h3>
            <span id="resultBadge" class="badge-sync" style="background: var(--primary);">ANALYZED</span>
        </div>
        
        <div id="planSummary" class="text-muted" style="margin-bottom: 1.5rem; font-size: 0.9rem;"></div>

        <div class="table-wrapper">
            <table id="planTable">
                <thead>
                    <tr>
                        <th>Type</th>
                        <th>Table</th>
                        <th>Operation</th>
                        <th>Details</th>
                        <th id="statusCol" style="display: none;">Status</th>
                    </tr>
                </thead>
                <tbody id="planBody"></tbody>
            </table>
        </div>
    </div>
</div>

<script>
    let lastManifestFileName = '';

    async function downloadTemplate() {
        const btn = document.querySelector('button[onclick="downloadTemplate()"]');
        const originalText = btn.innerText;
        btn.innerText = 'Generating...';
        btn.disabled = true;

        try {
            const res = await fetch(`${API_BASE}/metadata/template`, { headers: getAuthHeaders() });
            if (!res.ok) throw new Error(`Server returned ${res.status}`);
            
            const data = await res.json();
            const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
            const url = window.URL.createObjectURL(blob);
            
            const a = document.createElement('a');
            a.href = url;
            a.download = `data_fabric_blueprint_${new Date().toISOString().split('T')[0]}.json`;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            window.URL.revokeObjectURL(url);
            
            showModal('Success', 'Orchestration blueprint generated and downloaded successfully.');
        } catch (e) {
            console.error('[Metadata] Download failed:', e);
            showModal('Error', 'Industrial Blueprint Generation Failed: ' + e.message);
        } finally {
            btn.innerText = originalText;
            btn.disabled = false;
        }
    }

    async function loadTemplateForAnalysis() {
        showModal('Load Blueprint', 'This will load the definitive industrial blueprint for immediate drift analysis. Proceed?', runTemplateAnalysis, 'Proceed');
    }

    async function runTemplateAnalysis() {
        const btn = document.querySelector('button[onclick="loadTemplateForAnalysis()"]');
        const originalText = btn ? btn.innerText : '';
        if (btn) { btn.innerText = 'Loading...'; btn.disabled = true; }

        // Loading state
        const card = document.getElementById('resultCard');
        const body = document.getElementById('planBody');
        card.style.display = 'block';
        document.getElementById('resultTitle').innerText = 'Orchestration Plan';
        document.getElementById('planSummary').innerText = 'Loading blueprint and analyzing drift...';
        body.innerHTML = '<tr><td colspan="5" class="text-muted" style="text-align:center;">Loading...</td></tr>';

        try {
            const res = await fetch(`${API_BASE}/metadata/template`, { headers: getAuthHeaders() });
            const data = await res.json();

            const res2 = await fetch(`${API_BASE}/metadata/diff`, {
                method: 'POST',
                headers: getAuthHeaders(),
                body: JSON.stringify(data)
            });
            const diffData = await res2.json();
            displayPlan(diffData.changes || [], 'Orchestration Plan', 'ANALYZED', false);
        } catch (e) {
            showModal('Error', 'Template Analysis Failed: ' + e.message);
        } finally {
            if (btn) { btn.innerText = originalText; btn.disabled = false; }
        }
    }

    async function analyzeManifest() {
        const fileInput = document.getElementById('manifestFile');
        if (!fileInput.files[0]) return alert('Please select a manifest file first.');
        lastManifestFileName = fileInput.files[0].name;

        const formData = new FormData();
        formData.append('file', fileInput.files[0]);

        const btn = document.getElementById('diffBtn');
        const originalText = btn.innerText;
        btn.innerText = 'Analyzing...';
        btn.disabled = true;

        const uploadHeaders = getAuthHeaders();
        delete uploadHeaders['Content-Type'];

        try {
            const res = await fetch(`${API_BASE}/metadata/diff`, {
                method: 'POST',
                headers: uploadHeaders,
                body: formData
            });
            const data = await res.json();
            displayPlan(data.changes || [], 'Orchestration Plan', 'ANALYZED', false);
        } catch (e) {
            alert('Analysis failed: ' + e.message);
        } finally {
            btn.innerText = originalText;
            btn.disabled = false;
        }
    }

    async function applyManifest() {
        const fileInput = document.getElementById('manifestFile');
        if (!fileInput.files[0]) return alert('Please select a manifest file first.');
        lastManifestFileName = fileInput.files[0].name;

        showModal('Industrial Warning', 'This will execute DDL/DML operations on the live fabric. Proceed?', runApplyManifest, 'Proceed');
    }

    async function runApplyManifest() {
        const fileInput = document.getElementById('manifestFile');
        if (!fileInput.files[0]) return alert('Please select a manifest file first.');

        const formData = new FormData();
        formData.append('file', fileInput.files[0]);

        const btn = document.getElementById('applyBtn');
        const originalText = btn.innerText;
        btn.innerText = 'Orchestrating...';
        btn.disabled = true;

        const uploadHeaders = getAuthHeaders();
        delete uploadHeaders['Content-Type'];

        try {
            const res = await fetch(`${API_BASE}/metadata/apply`, {
                method: 'POST',
                headers: uploadHeaders,
                body: formData
            });
            const data = await res.json();
            displayPlan(data.plan, 'Orchestration Results', 'SUCCESS', true, data.results);
        } catch (e) {
            alert('Orchestration failed: ' + e.message);
        } finally {
            btn.innerText = originalText;
            btn.disabled = false;
        }
    }

    function displayPlan(plan, title, badgeText, showStatus, results = []) {
        const card = document.getElementById('resultCard');
        const body = document.getElementById('planBody');
        const titleEl = document.getElementById('resultTitle');
        const badgeEl = document.getElementById('resultBadge');
        const summaryEl = document.getElementById('planSummary');
        const statusCol = document.getElementById('statusCol');

        card.style.display = 'block';
        titleEl.innerText = title;
        badgeEl.innerText = badgeText;
        badgeEl.style.background = badgeText === 'SUCCESS' ? 'var(--success)' : 'var(--primary)';
        statusCol.style.display = showStatus ? 'table-cell' : 'none';

        if (!Array.isArray(plan) || plan.length === 0) {
            summaryEl.innerText = 'No schema drift detected. Live environment matches target state.';
            body.innerHTML = '<tr><td colspan="5" class="text-muted">Empty Plan</td></tr>';
            return;
        }

        const MAX_ROWS = 500;
        const capped = plan.length > MAX_ROWS;
        const rows = capped ? plan.slice(0, MAX_ROWS) : plan;

        summaryEl.innerText = `${plan.length} operations parsed from ${lastManifestFileName || 'manifest payload'} and aligned to target state.`
            + (capped ? ` (showing ${MAX_ROWS} of ${plan.length})` : '');

        body.innerHTML = rows.map((p, idx) => {
            const raw = JSON.stringify(p);
            const detail = raw.substring(0, 180) + (raw.length > 180 ? '...' : '');
            const ok = results[idx]?.status === 'SUCCESS' || results[idx]?.status?.startsWith('SUCCESS');
            return `
            <tr>
                <td><span class="badge-sync" style="background: var(--surface-hover);">${escapeHtml(p.action || p.type)}</span></td>
                <td><strong>${escapeHtml(p.table || p.name || p.type || 'N/A')}</strong></td>
                <td>${escapeHtml(p.operation || p.action)}</td>
                <td class="text-muted" style="font-size: 0.8rem;"><code>${escapeHtml(detail)}</code></td>
                ${showStatus ? `<td><span class="badge-sync" style="background: ${ok ? 'var(--success)' : 'var(--danger)'}; color: black;">${ok ? 'DONE' : 'ERROR'}</span></td>` : ''}
            </tr>
        `;
        }).join('');
    }
</script>

<%- include('partials/footer') %>
