{
  "name": "inventory-shortage-alert",
  "event": "UPDATE",
  "resource": "warehouse_stock",
  "condition": "NEW.quantity < 10",
  "action": {
    "type": "WEBHOOK",
    "endpoint": "https://alerts.fabrixly.com/hooks/stock"
  }
}</code></pre>
            </div>

            <h3>5. SQL Mode Windowing and CTEs</h3>
