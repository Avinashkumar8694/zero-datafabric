# ─────────────────────────────────────────────
# Replication Engine — Environment Configuration
# ─────────────────────────────────────────────

# Database (shared fabric control-plane)
DATABASE_URL=postgresql://fabric_admin:mqh6A5GJWdwJZmHyc1fm3luB@localhost:5434/datafabric

# Worker identity — unique per replica when scaling horizontally
# Each worker claims jobs via SKIP LOCKED so N replicas can run safely in parallel
WORKER_ID=replication-engine-1

# How often the worker polls for new copy jobs (ms)
FABRIC_COPY_POLL_MS=2000

# How long before an in-progress job is considered stale/orphaned and reclaimed (ms)
FABRIC_COPY_STALE_MS=60000

# Copy batch size — rows fetched per page during SYNC/REPLICATE
FABRIC_COPY_BATCH=1000

# Memory ceiling in MB — worker pauses batching if heap exceeds this
FABRIC_COPY_MEM_CEILING_MB=1024

# Hard cap on total rows per copy job (safety limit)
FABRIC_COPY_MAX_ROWS=5000000

# ── Kafka CDC (optional) ─────────────────────
# Set to true to enable Kafka-based CDC → Elasticsearch pipeline
FABRIC_CDC_VIA_KAFKA=false
KAFKA_BROKERS=localhost:9092
