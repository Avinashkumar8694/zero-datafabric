<%- include('partials/header') %>

<div class="page fade-in">
    <div class="page-head">
        <div>
            <h1 class="page-title">Overview</h1>
            <p class="page-sub">Tenants, connections, security audits and live fabric health at a glance.</p>
        </div>
    </div>

    <!-- Stats Row -->
    <div class="stat-grid">
        <div class="stat-card">
            <span class="stat-label">Total Tenants</span>
            <span class="stat-value" id="stat-tenants">--</span>
        </div>
        <div class="stat-card">
            <span class="stat-label">Active Connections</span>
            <span class="stat-value" id="stat-connections">--</span>
        </div>
        <div class="stat-card">
            <span class="stat-label">Security Audits (24h)</span>
            <span class="stat-value" id="stat-audits">--</span>
        </div>
        <div class="stat-card warn" id="dataResetCard" style="display: none;">
            <span class="stat-label">Next Data Reset</span>
            <span class="stat-value sm text-warning" id="stat-reset-time">--</span>
        </div>
    </div>

    <div class="split">
        <!-- Recent Activity -->
        <section class="glass-card">
            <h3>Recent Fabric Events</h3>
            <div class="table-wrapper">
                <table>
                    <thead>
                        <tr>
                            <th>Module</th>
                            <th>Action</th>
                            <th>Target</th>
                            <th>Time</th>
                        </tr>
                    </thead>
                    <tbody id="activityBody">
                        <tr><td colspan="4" class="state-cell">No recent activity detected</td></tr>
                    </tbody>
                </table>
            </div>
        </section>

        <!-- System Health -->
        <section class="glass-card">
            <h3>Fabric Health</h3>
            <div id="healthTelemetry" class="health-list">
                <div class="health-row">
                    <span>Status</span>
                    <span id="healthStatus" class="badge badge-muted">CHECKING...</span>
                </div>
                <div class="health-row">
                    <span>DB Latency</span>
                    <span id="dbLatency" class="text-muted">--</span>
                </div>
                <div class="health-row">
                    <span>Uptime</span>
                    <span id="sysUptime" class="text-muted">--</span>
                </div>
                <div class="health-foot">
                    Pool: <span id="dbPool">--</span>
                </div>
            </div>
        </section>
    </div>
</div>

<script>
    async function loadStats() {
        try {
            const res = await fetch(`${API_BASE}/admin/stats`, {
                headers: getAuthHeaders()
            });
            const stats = await res.json() || {};

            document.getElementById('stat-tenants').innerText = stats.tenants || '0';
            document.getElementById('stat-connections').innerText = stats.connections || '0';
            document.getElementById('stat-audits').innerText = stats.audits || '0';

            // Load next data reset time
            const subRes = await fetch(`${API_BASE}/subscriptions/me`, { headers: getAuthHeaders() });
            if (subRes.ok) {
                const sub = await subRes.json();
                if (sub && sub.next_data_reset_at) {
                    const card = document.getElementById('dataResetCard');
                    if (card) {
                        card.style.display = 'block';
                        const resetDate = new Date(sub.next_data_reset_at);
                        document.getElementById('stat-reset-time').innerText = resetDate.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) + ' (' + resetDate.toLocaleDateString() + ')';
                    }
                }
            }
        } catch (e) {
            console.error('[Dashboard] Stats fetch failed', e);
            document.getElementById('stat-tenants').innerText = '--';
            document.getElementById('stat-connections').innerText = '--';
            document.getElementById('stat-audits').innerText = '--';
        }
    }

    async function loadHealth() {
        try {
            const res = await fetch(`${API_BASE.replace('/api', '')}/api/health`);
            const data = await res.json();
            
            const statusEl = document.getElementById('healthStatus');
            statusEl.innerText = data.status;
            statusEl.className = 'badge ' + (data.status === 'HEALTHY' ? 'badge-ok' : 'badge-danger');
            
            document.getElementById('dbLatency').innerText = data.database.latency;
            document.getElementById('sysUptime').innerText = data.uptime;
            document.getElementById('dbPool').innerText = `Total: ${data.database.pool.total}, Idle: ${data.database.pool.idle}`;
        } catch (e) {
            document.getElementById('healthStatus').innerText = 'OFFLINE';
            document.getElementById('healthStatus').className = 'badge badge-danger';
        }
    }

    async function loadEvents() {
        const body = document.getElementById('activityBody');
        body.innerHTML = '<tr><td colspan="4" class="state-cell">Loading events…</td></tr>';
        try {
            const res = await fetch(`${API_BASE}/events`, {
                headers: getAuthHeaders()
            });
            const events = await res.json();

            if (Array.isArray(events) && events.length > 0) {
                const capped = events.slice(0, 500);
                const rows = capped.map(e => `
                    <tr>
                        <td class="cell-module">${escapeHtml((e.action || '').split('.')[0] || 'ENGINE')}</td>
                        <td>${escapeHtml(e.action)}</td>
                        <td><span class="badge badge-sync">${escapeHtml(e.tableName || 'N/A')}</span></td>
                        <td class="text-muted">${escapeHtml(new Date(e.createdAt).toLocaleTimeString())}</td>
                    </tr>
                `).join('');
                const note = events.length > 500
                    ? `<tr><td colspan="4" class="state-cell">Showing 500 of ${escapeHtml(events.length)} events</td></tr>`
                    : '';
                body.innerHTML = rows + note;
            } else {
                body.innerHTML = '<tr><td colspan="4" class="state-cell">No recent activity detected</td></tr>';
            }
        } catch (e) {
            body.innerHTML = '<tr><td colspan="4" class="state-cell text-danger">Failed to load events</td></tr>';
        }
    }

    loadStats();
    loadHealth();
    loadEvents();
    setInterval(loadHealth, 10000); 
    setInterval(loadEvents, 10000); 
</script>

<%- include('partials/footer') %>
