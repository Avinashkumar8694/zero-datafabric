{
  "name": "zero-data-fabric-monorepo",
  "version": "1.0.0",
  "description": "Industrial Monorepo for Zero Data Fabric",
  "main": "index.js",
  "scripts": {
    "install:all": "npm install && cd backend && npm install && cd ../ui && npm install",
    "infra:up": "docker-compose up -d",
    "infra:down": "docker-compose down",
    "db:migrate": "cd backend && npx ts-node src/config/migrate.ts",
    "start:backend": "cd backend && npm start",
    "start:ui": "cd ui && npm start",
    "start": "npx concurrently \"npm run start:backend\" \"npm run start:ui\"",
    "test:manifest": "node test-manifest.js",
    "examples:all": "node examples/run-all-examples.js",
    "examples:queries": "node examples/all-query-types.js",
    "examples:multisource": "node examples/multi-datasource-queries.js",
    "examples:prepare": "node examples/prepare-demo-env.js",
    "examples:inserts": "node examples/inserts-all-datasources.js",
    "examples:views": "node examples/views-mviews-sequences-procs-triggers.js",
    "examples:mutations": "node examples/update-delete-advanced.js",
    "examples:complex": "node examples/aggregation-and-complex.js",
    "examples:triggers": "node examples/trigger-engine-examples.js",
    "examples:sources": "node examples/register-3-datasources.js",
    "examples:fed-aggregate": "node examples/federated-aggregate.js",
    "examples:fed-join": "node examples/federated-join-pushdown.js",
    "stop": "lsof -ti:4000,3001 | xargs kill -9",
    "setup": "npm run install:all && npm run infra:up && npm run db:migrate",
    "test": "cd backend && npm test -- --runInBand"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "axios": "^1.16.0"
  }
}
