<%- include('partials/header') %>

<div class="login-container" id="loginContainer">
    <!-- Ambient glowing orbs -->
    <div class="login-orb login-orb-1"></div>
    <div class="login-orb login-orb-2"></div>

    <!-- Loading spinner before settings decide to show page or redirect -->
    <div id="loginLoadingState" class="login-loading-state">
        <div class="login-spinner"></div>
        <p>Connecting to authentication provider...</p>
    </div>

    <!-- Login card (only shown if Data Fabric own login / password login is enabled) -->
    <div class="glass-card login-card" id="loginCard" style="display: none;">
        <!-- Logo / Brand Badge -->
        <div class="login-brand-header">
            <img id="loginLogo" src="" alt="Logo" class="login-custom-logo" style="display: none;" />
            <div id="loginDefaultBadge" class="login-default-badge">
                <span>ZF</span>
            </div>
            <h2 id="loginTitle" class="login-title">Data Fabric</h2>
            <p id="loginSubtitle" class="login-subtitle">Sign in to your unified data fabric workspace</p>
        </div>
        
        <!-- Password Login Form -->
        <form id="passwordLoginForm" class="login-form">
            <div class="login-input-group">
                <label for="usernameInput">Username / Email</label>
                <div class="login-input-wrap">
                    <i class="fas fa-envelope input-icon"></i>
                    <input type="text" id="usernameInput" required placeholder="name@company.com or username" autocomplete="username" />
                </div>
            </div>
            <div class="login-input-group">
                <label for="passwordInput">Password</label>
                <div class="login-input-wrap">
                    <i class="fas fa-lock input-icon"></i>
                    <input type="password" id="passwordInput" required placeholder="••••••••••••" autocomplete="current-password" />
                </div>
            </div>
            <button type="submit" id="loginSubmitBtn" class="btn-signin-primary">
                <span>Sign In</span>
                <i class="fas fa-arrow-right"></i>
            </button>
        </form>

        <!-- Divider (shown when both password & SSO are enabled) -->
        <div id="loginDivider" class="login-divider" style="display: none;">
            <span>OR CONTINUE WITH</span>
        </div>

        <!-- SSO Button -->
        <button id="ssoBtn" type="button" class="btn-signin-sso" style="display: none;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-shield"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
            <span>Sign In with Enterprise SSO</span>
        </button>

        <p id="message" class="login-error-msg"></p>

        <!-- Footer Trust Badge -->
        <div class="login-footer-trust">
            <i class="fas fa-shield-halved"></i>
            <span>Governed &amp; Isolated Multi-Tenant Cloud</span>
        </div>
    </div>
</div>

<script>
    // Check for SSO callback token in query params
    const urlParams = new URLSearchParams(window.location.search);
    const token = urlParams.get('token');
    if (token) {
        localStorage.setItem('token', token);
        const timezone = Intl.DateTimeFormat().resolvedOptions().timeZone;
        
        // Log timezone on the backend before redirecting to dashboard
        fetch(`${API_BASE}/auth/timezone`, {
            method: 'POST',
            headers: { 
                'Content-Type': 'application/json',
                'Authorization': `Bearer ${token}`
            },
            body: JSON.stringify({ timezone })
        }).catch(err => {
            console.error('[Timezone] Failed to update user timezone:', err);
        }).finally(() => {
            window.location.href = '/dashboard';
        });
    }

    async function initializeLoginPage() {
        // If we just got a token from SSO callback, keep loading indicator until redirect above fires
        if (token) return;

        try {
            const res = await fetch(`${API_BASE}/settings/login`);
            if (!res.ok) {
                // If backend error, show password login as safe fallback
                showCustomLoginCard();
                return;
            }
            const data = await res.json();
            if (!data) {
                showCustomLoginCard();
                return;
            }

            // ── Requirement: If password login is NOT enabled (only SSO is enabled) or not selfhost,
            // DO NOT show an intermediate login page! Redirect directly to SSO Identity Provider! ──
            if (!data.allow_password_login || !data.selfhost) {
                if (data.sso_enabled !== false) {
                    window.location.replace(`${API_BASE}/auth/sso`);
                    return;
                }
            }

            // ── Self-host mode with password login enabled: show customized login page ──
            showCustomLoginCard();

            if (data.bg_color) {
                document.body.style.background = data.bg_color;
                document.getElementById('loginContainer').style.background = data.bg_color;
            }
            if (data.title) {
                document.getElementById('loginTitle').innerText = data.title;
            }
            if (data.logo_url) {
                const logo = document.getElementById('loginLogo');
                logo.src = data.logo_url;
                logo.style.display = 'block';
                document.getElementById('loginDefaultBadge').style.display = 'none';
            }

            // Show SSO button only if SSO is enabled
            const ssoBtn = document.getElementById('ssoBtn');
            const divider = document.getElementById('loginDivider');
            if (data.sso_enabled !== false) {
                ssoBtn.style.display = 'flex';
                divider.style.display = 'flex';
            } else {
                ssoBtn.style.display = 'none';
                divider.style.display = 'none';
            }
        } catch (err) {
            console.error('[LoginInit] Error initializing login settings:', err);
            showCustomLoginCard();
        }
    }

    function showCustomLoginCard() {
        document.getElementById('loginLoadingState').style.display = 'none';
        document.getElementById('loginCard').style.display = 'flex';
    }

    // Run initialize immediately
    initializeLoginPage();

    document.getElementById('ssoBtn')?.addEventListener('click', () => {
        window.location.href = `${API_BASE}/auth/sso`;
    });

    document.getElementById('passwordLoginForm')?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const username = document.getElementById('usernameInput').value;
        const password = document.getElementById('passwordInput').value;
        const msg = document.getElementById('message');
        const submitBtn = document.getElementById('loginSubmitBtn');

        msg.innerText = '';
        submitBtn.disabled = true;
        submitBtn.style.opacity = '0.7';

        try {
            const res = await fetch(`${API_BASE}/auth/login`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ username, password })
            });

            if (!res.ok) {
                const err = await res.json();
                throw new Error(err.error || 'Invalid username or password');
            }

            const data = await res.json();
            if (data.token) {
                localStorage.setItem('token', data.token);
                
                // Track user timezone on login
                const timezone = Intl.DateTimeFormat().resolvedOptions().timeZone;
                await fetch(`${API_BASE}/auth/timezone`, {
                    method: 'POST',
                    headers: { 
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${data.token}`
                    },
                    body: JSON.stringify({ timezone })
                }).catch(err => console.error('[Timezone] Error:', err));

                window.location.href = '/dashboard';
            }
        } catch (err) {
            msg.innerText = err.message;
            submitBtn.disabled = false;
            submitBtn.style.opacity = '1';
        }
    });
</script>

<style>
    /* Full bleed modern login layout - eliminate any outer layout padding/margins */
    html, body.login-page {
        background: #04060f !important;
        margin: 0 !important;
        padding: 0 !important;
        width: 100% !important;
        min-height: 100vh !important;
        overflow-x: hidden !important;
    }

    body.login-page .app-layout {
        display: block !important;
        height: auto !important;
        min-height: 100vh !important;
        width: 100% !important;
        margin: 0 !important;
        padding: 0 !important;
        background: #04060f !important;
        overflow: visible !important;
    }

    body.login-page .main-content {
        width: 100% !important;
        min-height: 100vh !important;
        margin: 0 !important;
        padding: 0 !important;
        background: transparent !important;
        overflow: visible !important;
        display: flex !important;
        flex-direction: column !important;
    }

    body.login-page .content-wrapper {
        width: 100% !important;
        min-height: 100vh !important;
        margin: 0 !important;
        padding: 0 !important;
        background: transparent !important;
        overflow: visible !important;
        display: flex !important;
        flex-direction: column !important;
    }

    .login-container {
        min-height: 100vh;
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: radial-gradient(circle at 50% 0%, #0d1627 0%, #04060f 100%);
        padding: 2.5rem 1.25rem;
        position: relative;
        overflow: hidden;
        box-sizing: border-box;
    }

    /* Ambient background grid */
    .login-container::before {
        content: '';
        position: absolute;
        inset: 0;
        background-image:
          linear-gradient(rgba(0, 97, 255, 0.05) 1px, transparent 1px),
          linear-gradient(90deg, rgba(0, 97, 255, 0.05) 1px, transparent 1px);
        background-size: 50px 50px;
        pointer-events: none;
    }

    /* Floating orbs */
    .login-orb {
        position: absolute;
        border-radius: 50%;
        filter: blur(100px);
        opacity: 0.22;
        pointer-events: none;
    }
    .login-orb-1 {
        width: 500px;
        height: 500px;
        background: #0061FF;
        top: -150px;
        left: -100px;
    }
    .login-orb-2 {
        width: 450px;
        height: 450px;
        background: #6366f1;
        bottom: -100px;
        right: -100px;
    }

    /* Loading state */
    .login-loading-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 1rem;
        color: #94a3b8;
        font-size: 0.9rem;
        position: relative;
        z-index: 10;
    }

    .login-spinner {
        width: 36px;
        height: 36px;
        border: 3px solid rgba(255, 255, 255, 0.1);
        border-top-color: #0061FF;
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
    }
    @keyframes spin {
        to { transform: rotate(360deg); }
    }

    /* Premium login card */
    .login-card {
        width: 100%;
        max-width: 440px;
        background: rgba(15, 23, 42, 0.78) !important;
        backdrop-filter: blur(28px);
        -webkit-backdrop-filter: blur(28px);
        border: 1px solid rgba(255, 255, 255, 0.12) !important;
        border-radius: 20px;
        padding: 2.75rem 2.25rem;
        box-shadow: 0 25px 60px -15px rgba(0, 0, 0, 0.65), 0 0 35px rgba(0, 97, 255, 0.12);
        display: flex;
        flex-direction: column;
        position: relative;
        z-index: 10;
        box-sizing: border-box;
    }

    /* Brand Header */
    .login-brand-header {
        text-align: center;
        margin-bottom: 2rem;
    }

    .login-default-badge {
        width: 46px;
        height: 46px;
        margin: 0 auto 1.25rem auto;
        background: linear-gradient(135deg, #0061FF, #6366f1);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: 'Outfit', sans-serif;
        font-weight: 800;
        font-size: 1.15rem;
        color: #fff;
        box-shadow: 0 0 25px rgba(0, 97, 255, 0.45);
    }

    .login-custom-logo {
        max-height: 70px;
        max-width: 180px;
        object-fit: contain;
        margin: 0 auto 1.25rem auto;
    }

    .login-title {
        font-family: 'Outfit', sans-serif;
        font-weight: 800;
        font-size: 1.75rem;
        color: #ffffff;
        letter-spacing: -0.02em;
        margin-bottom: 0.35rem;
    }

    .login-subtitle {
        color: #94a3b8;
        font-size: 0.88rem;
        line-height: 1.5;
    }

    /* Form Styles */
    .login-form {
        display: flex;
        flex-direction: column;
        gap: 1.2rem;
        width: 100%;
    }

    .login-input-group {
        text-align: left;
        display: flex;
        flex-direction: column;
        gap: 0.45rem;
    }

    .login-input-group label {
        font-size: 0.75rem;
        font-weight: 700;
        color: #94a3b8;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .login-input-wrap {
        position: relative;
        display: flex;
        align-items: center;
    }

    .login-input-wrap .input-icon {
        position: absolute;
        left: 0.95rem;
        color: #64748b;
        font-size: 0.9rem;
        pointer-events: none;
    }

    .login-input-wrap input {
        width: 100%;
        padding: 0.85rem 1rem 0.85rem 2.6rem;
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 10px;
        color: #f8fafc;
        font-size: 0.95rem;
        outline: none;
        transition: all 0.2s ease;
        box-sizing: border-box;
    }

    .login-input-wrap input::placeholder {
        color: #475569;
    }

    .login-input-wrap input:focus {
        border-color: #0061FF;
        background: rgba(255, 255, 255, 0.07);
        box-shadow: 0 0 0 3px rgba(0, 97, 255, 0.25);
    }

    /* Primary Submit Button */
    .btn-signin-primary {
        width: 100%;
        padding: 0.9rem;
        background: linear-gradient(135deg, #0061FF, #6366f1);
        color: #ffffff;
        border: none;
        border-radius: 10px;
        font-weight: 700;
        font-size: 0.98rem;
        cursor: pointer;
        transition: all 0.25s ease;
        box-shadow: 0 0 25px rgba(0, 97, 255, 0.35);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        margin-top: 0.5rem;
    }

    .btn-signin-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 0 35px rgba(0, 97, 255, 0.55);
        background: linear-gradient(135deg, #0052d9, #4f46e5);
    }

    /* Divider */
    .login-divider {
        display: flex;
        align-items: center;
        margin: 1.5rem 0 1.25rem 0;
        color: #64748b;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.08em;
    }

    .login-divider::before,
    .login-divider::after {
        content: '';
        flex: 1;
        height: 1px;
        background: rgba(255, 255, 255, 0.08);
    }

    .login-divider span {
        padding: 0 0.85rem;
    }

    /* SSO Button */
    .btn-signin-sso {
        width: 100%;
        padding: 0.85rem;
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.12);
        color: #f8fafc;
        border-radius: 10px;
        font-weight: 600;
        font-size: 0.95rem;
        cursor: pointer;
        transition: all 0.2s ease;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
    }

    .btn-signin-sso:hover {
        background: rgba(255, 255, 255, 0.08);
        border-color: rgba(99, 102, 241, 0.45);
        transform: translateY(-1px);
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
    }

    /* Error Message */
    .login-error-msg {
        margin-top: 1rem;
        color: #f87171;
        font-size: 0.85rem;
        text-align: center;
        min-height: 1.2rem;
    }

    /* Trust Footer Badge */
    .login-footer-trust {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        margin-top: 1.75rem;
        padding-top: 1.25rem;
        border-top: 1px solid rgba(255, 255, 255, 0.06);
        color: #64748b;
        font-size: 0.75rem;
        font-weight: 500;
    }

    .login-footer-trust i {
        color: #10b981;
    }

    /* Mobile adjustments */
    @media (max-width: 480px) {
        .login-container {
            padding: 1.5rem 1rem;
        }
        .login-card {
            padding: 2rem 1.25rem;
            border-radius: 16px;
        }
        .login-title {
            font-size: 1.5rem;
        }
        .btn-signin-primary, .btn-signin-sso {
            padding: 0.8rem;
            font-size: 0.92rem;
        }
    }
</style>

<%- include('partials/footer') %>
