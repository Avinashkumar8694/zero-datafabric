    <div class="stats-bar">
      <div class="stat-item">
        <div class="stat-num">6+</div>
        <div class="stat-label">Data Sources</div>
      </div>
      <div class="stat-divider"></div>
      <div class="stat-item">
        <div class="stat-num">Real-time</div>
        <div class="stat-label">CDC & Replication</div>
      </div>
      <div class="stat-divider"></div>
      <div class="stat-item">
        <div class="stat-num">SSO</div>
        <div class="stat-label">OIDC / OAuth2</div>
      </div>
      <div class="stat-divider"></div>
      <div class="stat-item">
        <div class="stat-num">Row-level</div>
