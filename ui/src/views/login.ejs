<%- include('partials/header') %>

<div class="login-container">
    <div class="glass-card">
        <h2>Login to Data Fabric</h2>
        <form id="loginForm">
            <div class="form-group">
                <label>Username</label>
                <input type="text" id="username" value="admin" required>
            </div>
            <div class="form-group">
                <label>Password</label>
                <input type="password" id="password" value="admin" required>
            </div>
            <button type="submit" class="btn-primary">Sign In</button>
        </form>
        <div style="margin: 1.5rem 0; text-align: center; color: var(--text-muted); font-size: 0.9rem; position: relative;">
            <span style="background: var(--surface); padding: 0 10px; position: relative; z-index: 1;">OR</span>
            <div style="position: absolute; top: 50%; left: 0; right: 0; height: 1px; background: var(--border); z-index: 0;"></div>
        </div>
        <button id="ssoBtn" type="button" class="btn-sso" style="width: 100%; padding: 1rem; background: transparent; color: var(--text); border: 1px solid var(--border); border-radius: 8px; font-weight: 600; cursor: pointer; transition: all 0.3s; display: flex; align-items: center; justify-content: center; gap: 8px;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-shield"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
            Sign In with SSO
        </button>
        <p id="message"></p>
    </div>
</div>

<script>
    // Check for SSO callback token in query params
    const urlParams = new URLSearchParams(window.location.search);
    const token = urlParams.get('token');
    if (token) {
        localStorage.setItem('token', token);
        window.location.href = '/dashboard';
    }

    document.getElementById('ssoBtn').addEventListener('click', () => {
        window.location.href = `${API_BASE}/auth/sso`;
    });

    document.getElementById('loginForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        const username = document.getElementById('username').value;
        const password = document.getElementById('password').value;
        
        try {
            const response = await fetch(`${API_BASE}/auth/login`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ username, password })
            });
            
            const data = await response.json();
            
            if (response.ok) {
                localStorage.setItem('token', data.token);
                window.location.href = '/dashboard';
            } else {
                document.getElementById('message').innerText = data.error || 'Login failed';
            }
        } catch (err) {
            document.getElementById('message').innerText = 'Error connecting to API';
        }
    });
</script>

<style>
    .login-container {
        height: 80vh;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .glass-card {
        background: var(--surface);
        padding: 3rem;
        border-radius: 16px;
        border: 1px solid var(--border);
        width: 100%;
        max-width: 400px;
    }
    .glass-card h2 {
        margin-bottom: 2rem;
        text-align: center;
    }
    .form-group {
        margin-bottom: 1.5rem;
    }
    .form-group label {
        display: block;
        margin-bottom: 0.5rem;
        color: var(--text-muted);
    }
    .form-group input {
        width: 100%;
        padding: 0.8rem;
        background: var(--bg);
        border: 1px solid var(--border);
        border-radius: 8px;
        color: var(--text);
        outline: none;
    }
    .form-group input:focus {
        border-color: var(--primary);
    }
    .btn-primary {
        width: 100%;
        padding: 1rem;
        background: var(--primary);
        color: white;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.3s;
    }
    .btn-primary:hover {
        background: var(--primary-dark);
    }
    .btn-sso:hover {
        background: rgba(255, 255, 255, 0.05) !important;
        border-color: var(--primary) !important;
    }
    #message {
        margin-top: 1rem;
        color: #ef4444;
        text-align: center;
    }
</style>

<%- include('partials/footer') %>
