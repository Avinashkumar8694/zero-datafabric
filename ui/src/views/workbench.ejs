<%- include('partials/header') %>

<div class="wb-shell fade-in">
    <aside class="wb-left">
        <div class="wb-left-head">
            <h3>Workbench Explorer</h3>
            <input id="explorerSearch" class="wb-input" placeholder="Search sources, schemas, resources..." oninput="filterExplorer()">
        </div>
        <div id="explorerTree" class="wb-tree">
            <div class="wb-muted" style="padding:1rem;">Loading explorer...</div>
        </div>
    </aside>

    <section class="wb-main">
        <div class="wb-top">
            <div class="wb-title">
                <h2>Query Workbench</h2>
                <p>Pick a mode, write your query, and run it across any data source.</p>
            </div>
            <div class="wb-actions">
                <button class="btn-outline" onclick="openRelationships()">Relationships</button>
                <a href="/workbench/docs" class="btn-outline" target="_blank" rel="noreferrer">Docs</a>
            </div>
        </div>

        <div class="wb-toolbar">
            <div class="wb-mode" role="tablist" aria-label="Query mode">
                <button id="modeSql" class="tab-btn active" onclick="setMode('SQL')">SQL</button>
                <button id="modeAst" class="tab-btn" onclick="setMode('AST')">AST</button>
            </div>
            <div class="wb-run-controls">
                <select id="templatePicker" class="wb-input" style="max-width:220px;" onchange="applyTemplate(this.value)">
                    <option value="">Load example…</option>
                </select>
                <label class="wb-muted" for="rowLimit" style="font-size:0.78rem;">Rows</label>
                <input id="rowLimit" class="wb-input" type="number" min="1" max="10000" value="100"
                       style="max-width:80px;" title="Max rows to fetch (applied as LIMIT / query limit)">
                <button class="btn-outline" onclick="clearEditor()">Clear</button>
                <button id="runBtn" class="btn-primary" onclick="runCurrent()">Run</button>
            </div>
        </div>

        <div id="joinBuilder" class="wb-join" style="display:none;">
            <strong>AST Join Builder</strong>
            <div class="wb-join-grid">
                <select id="joinPrimary" class="wb-input"></select>
                <select id="joinType" class="wb-input">
                    <option value="INNER">INNER</option>
                    <option value="LEFT">LEFT</option>
                    <option value="RIGHT">RIGHT</option>
                    <option value="FULL">FULL</option>
                </select>
                <select id="joinSecondary" class="wb-input"></select>
                <input id="joinOn" class="wb-input" placeholder='Join condition, e.g. "shipments.id = shipment_details.shipment_id"'>
                <button class="btn-outline" onclick="buildJoinAst()">Generate AST</button>
            </div>
        </div>

        <div class="wb-editor-wrap">
            <textarea id="sqlEditor" class="wb-editor" placeholder="SELECT * FROM tenant_tenant_A_global_supply_chain.shipments LIMIT 50;"></textarea>
            <textarea id="astEditor" class="wb-editor" style="display:none;" placeholder='{"type":"SELECT","schema":"Global_Supply_Chain","limit":50,"query":{"select":["*"],"from":{"resource":"shipments"}}}'></textarea>
        </div>

        <div id="wbDetail" class="wb-detail" style="display:none;">
            <div class="wb-detail-head">
                <span id="wbDetailTitle" class="wb-detail-title"></span>
                <button class="wb-detail-toggle" onclick="toggleDetail()" title="Collapse / expand">–</button>
            </div>
            <div id="wbDetailBody" class="wb-detail-body"></div>
        </div>

        <div class="wb-results">
            <div class="wb-results-head">
                <span id="resultMeta" class="wb-muted">Ready.</span>
                <span id="wbSpinner" class="wb-spinner" style="display:none;"></span>
            </div>
            <div id="wbError" class="wb-error" style="display:none;"></div>
            <div id="wbPlan" class="wb-plan" style="display:none;"></div>
            <div class="wb-table-wrap">
                <table id="resultsTable">
                    <thead id="resultsHead"></thead>
                    <tbody id="resultsBody">
                        <tr><td class="wb-muted" style="padding:2rem;">No results yet.</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </section>
</div>

<div id="wbErModal" class="wb-er-modal" style="display:none;" onclick="if(event.target===this)closeRelationships()">
    <div class="wb-er-dialog" role="dialog" aria-label="Relationship diagram">
        <div class="wb-er-head">
            <strong>Relationships</strong>
            <button class="wb-detail-toggle" onclick="closeRelationships()" title="Close">✕</button>
        </div>
        <div id="wbErBody" class="wb-er-body"></div>
    </div>
</div>

<style>
    .wb-shell { display:flex; height:calc(100vh - 84px); background:#f7f9fc; }
    .wb-left { width:320px; border-right:1px solid #e5e7eb; background:#fff; display:flex; flex-direction:column; }
    .wb-left-head { padding:1rem; border-bottom:1px solid #eef2f7; }
    .wb-left-head h3 { margin-bottom:0.75rem; font-size:1rem; }
