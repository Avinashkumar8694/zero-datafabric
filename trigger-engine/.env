# ─────────────────────────────────────────────
# Trigger Engine — Environment Configuration
# ─────────────────────────────────────────────

# Database (shared fabric control-plane)
DATABASE_URL=postgresql://fabric_admin:fabric_password@localhost:5434/datafabric

# Polling interval: how often the worker checks for pending trigger jobs
TRIGGER_POLL_INTERVAL_MS=1500

# HTTP port this microservice listens on
PORT=4001

# ── Email (nodemailer) ──────────────────────
# Used for EMAIL trigger action type
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="Zero Data Fabric <noreply@yourdomain.com>"

# ── Telegram ────────────────────────────────
# Used for TELEGRAM trigger action type
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# ── Webhook ─────────────────────────────────
# Optional: outbound webhook request timeout (ms)
WEBHOOK_TIMEOUT_MS=5000
