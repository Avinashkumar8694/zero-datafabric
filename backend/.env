# ─────────────────────────────────────────────
# Backend API — Environment Configuration
# ─────────────────────────────────────────────

# HTTP port
PORT=4000

# Database (fabric hub)
DATABASE_URL=postgresql://fabric_admin:fabric_password@localhost:5434/datafabric

# JWT signing secret
JWT_SECRET=reallyreallyreallyreallyverysecret

# ── SSO / OIDC ───────────────────────────────
OIDC_ISSUER=https://ids.fabrixly.com/oidc
OIDC_CLIENT_ID=zero-datafabric
OIDC_CLIENT_SECRET=bc79a2ed33935010666d9e4e1e0f29d7c80f0cd01d4a45267b6bc9b51fb9dd1d
OIDC_CALLBACK_URL=http://localhost:4000/api/auth/sso/callback
UI_BASE_URL=http://localhost:3006

# ── Redis (query cache + rate limiting) ──────
REDIS_URL=redis://localhost:6379

# ── Kafka ────────────────────────────────────
KAFKA_BROKERS=localhost:9092

# ── Replication engine mode ──────────────────
# Set to true when running replication-engine as a SEPARATE microservice.
# This disables the embedded copy-job worker inside the API process.
REPLICATION_ENGINE_EXTERNAL=false

# ── Kafka CDC pipeline (optional) ────────────
FABRIC_CDC_VIA_KAFKA=false

# ── Cryptographic License Configuration ──────
LICENSE_KEY=eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCJ9..0maFjUN6sJOIstTBUgCvStTSHRgz9ddlNj2s_2pwHptmBhZzY-xufqoQ4KGByzrSCxUkg-aBJAxLL0V5tC3wdiGnSJWORbvzr-HaG2htMw4GhWdHs2TrszK0sXkVuzp8CUobr2xzssXhrG2ZdUHK3tAfILZAQNR0gsAIsH-QyaJ5sKjiWuGoOv7V89YVGx5TpaECmIMRmZwUCzooZOBrSq6wd7ICzEOcdo2_axHqeTlAB1gEvlDQ1ocYYlrcEWGHjMjU51IB_PMC2SmBw6Q99OFaa0_7-3YMJnAlnJbY-9NNJ6R5rFsbVBBoHOAdoKbHaAWi_vLLs2ZZYziqkvwhNg

# Distributed execution (Citus). COORDINATOR_HOST = the name workers use to reach this coordinator (compose: db, prod: pg-fabric).
COORDINATOR_HOST=db
COORDINATOR_PORT=5432
# Dev only: allow 127.0.0.1/localhost workers.
# ALLOW_LOOPBACK_WORKERS=true

# ── Added with multi-tenancy / distributed execution (all optional; defaults shown) ─────────────
# Platform: set false to turn every plan limit and trial end off (licence ceiling still applies)
# PLAN_LIMITS_ENABLED=true
# Default execution region for sessions without an x-region header
# DEFAULT_REGION=AP

# Source/webhook safety (SSRF + hub protection)
# ALLOW_HUB_SOURCE=false          # platform admin only: allow registering the hub itself as a data source
# ALLOW_PRIVATE_SOURCES=true      # false blocks private/loopback ranges for new data sources (link-local/metadata always blocked)
# ALLOW_PRIVATE_WEBHOOKS=false    # true allows trigger webhooks to private/loopback hosts

# Manifests
# MANIFEST_MAX_UPLOAD_BYTES=5242880
# MANIFEST_EXTRA_EXTENSIONS=      # comma separated extra Postgres extensions allowed in manifests
MANIFEST_ALLOW_FREE_SQL_OWNERS=true  # true lets workspace owners (not only platform admins) use free-SQL function/view bodies

# Query engine / replication tuning (defaults are compiled in; uncomment to override)
# ES_HOST=localhost
# ES_PORT=9200
# ES_MUTATION_POLL_MS=1500
# MONGO_HOST=localhost
# MONGO_PORT=27017
# TRIGGER_ENGINE_URL=http://localhost:4001/api/trig-engine/transpile
# TRIGGER_POLL_INTERVAL_MS=1500
# FABRIC_CDC_KAFKA_BATCH=   # default in code
# FABRIC_CDC_POLL_MS=   # default in code
# FABRIC_COPY_BATCH=   # default in code
# FABRIC_COPY_MAX_ROWS=   # default in code
# FABRIC_COPY_MEM_CEILING_MB=   # default in code
# FABRIC_COPY_POLL_MS=   # default in code
# FABRIC_COPY_STALE_MS=   # default in code
# FABRIC_FED_BIND_MAX_KEYS=   # default in code
# FABRIC_FED_BROADCAST_MAX=   # default in code
# FABRIC_FED_COST_PROBE=1
# FABRIC_FED_MAX_BIND_BATCHES=   # default in code
# FABRIC_FED_MAX_ROWS_PER_LEG=   # default in code
# FABRIC_REPL_MAX_ROWS=   # default in code
# FABRIC_REPL_TICK_MS=   # default in code
# FABRIC_REQUIRE_SELECT_FILTER=   # default in code
# FABRIC_STREAM_BATCH=   # default in code
# FABRIC_STREAM_DEFAULT=   # default in code
# FABRIC_STREAM_HIGHWATER=   # default in code
# FABRIC_STREAM_INTERNAL=   # default in code
