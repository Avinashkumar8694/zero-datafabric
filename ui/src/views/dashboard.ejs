<%- include('partials/header') %>

<div class="fade-in">
    <!-- Stats Row -->
    <div class="grid">
        <div class="glass-card">
            <p class="text-muted">Total Tenants</p>
            <h1 id="stat-tenants">--</h1>
        </div>
        <div class="glass-card">
            <p class="text-muted">Active Connections</p>
            <h1 id="stat-connections">--</h1>
        </div>
        <div class="glass-card">
            <p class="text-muted">Security Audits (24h)</p>
            <h1 id="stat-audits">--</h1>
        </div>
    </div>

    <div class="grid" style="grid-template-columns: 2fr 1fr;">
        <!-- Recent Activity -->
        <section class="glass-card">
            <h3>Recent Fabric Events</h3>
            <div class="table-wrapper">
                <table>
                    <thead>
                        <tr>
                            <th>Module</th>
                            <th>Action</th>
                            <th>Target</th>
                            <th>Time</th>
                        </tr>
                    </thead>
                    <tbody id="activityBody">
                        <tr><td colspan="4">No recent activity detected</td></tr>
                    </tbody>
                </table>
            </div>
        </section>

        <!-- System Health -->
        <section class="glass-card">
            <h3>Fabric Health</h3>
            <div id="healthTelemetry" style="padding-top: 1rem;">
                <div style="margin-bottom: 1rem; display: flex; justify-content: space-between;">
                    <span>Status</span>
                    <span id="healthStatus" class="badge-sync">CHECKING...</span>
                </div>
                <div style="margin-bottom: 1rem; display: flex; justify-content: space-between;">
                    <span>DB Latency</span>
                    <span id="dbLatency" class="text-muted">--</span>
                </div>
                <div style="margin-bottom: 1rem; display: flex; justify-content: space-between;">
                    <span>Uptime</span>
                    <span id="sysUptime" class="text-muted">--</span>
                </div>
                <div style="font-size: 0.7rem; color: var(--text-muted); border-top: 1px solid var(--border); padding-top: 0.5rem; margin-top: 0.5rem;">
                    Pool: <span id="dbPool">--</span>
                </div>
            </div>
        </section>
    </div>
</div>

<script>
    async function loadStats() {
        try {
            const resTenants = await fetch(`${API_BASE}/admin/tenants`, {
                headers: getAuthHeaders()
            });
            if (resTenants.ok) {
                const tenants = await resTenants.json();
                document.getElementById('stat-tenants').innerText = Array.isArray(tenants) ? tenants.length : '0';
            } else {
                document.getElementById('stat-tenants').innerText = 'Err';
            }

            const resConn = await fetch(`${API_BASE}/admin/connections`, {
                headers: getAuthHeaders()
            });
            if (resConn.ok) {
                const connections = await resConn.json();
                document.getElementById('stat-connections').innerText = Array.isArray(connections) ? connections.length : '0';
            } else {
                document.getElementById('stat-connections').innerText = 'Err';
            }
            
            document.getElementById('stat-audits').innerText = '12'; // Mock for now
        } catch (e) {
            document.getElementById('stat-tenants').innerText = 'Offline';
            document.getElementById('stat-connections').innerText = 'Offline';
        }
    }

    async function loadHealth() {
        try {
            const res = await fetch(`${API_BASE.replace('/api', '')}/api/health`);
            const data = await res.json();
            
            const statusEl = document.getElementById('healthStatus');
            statusEl.innerText = data.status;
            statusEl.style.background = data.status === 'HEALTHY' ? 'var(--success)' : 'var(--danger)';
            
            document.getElementById('dbLatency').innerText = data.database.latency;
            document.getElementById('sysUptime').innerText = data.uptime;
            document.getElementById('dbPool').innerText = `Total: ${data.database.pool.total}, Idle: ${data.database.pool.idle}`;
        } catch (e) {
            document.getElementById('healthStatus').innerText = 'OFFLINE';
            document.getElementById('healthStatus').style.background = 'var(--danger)';
        }
    }

    loadStats();
    loadHealth();
    setInterval(loadHealth, 10000); // Poll every 10s
</script>

<%- include('partials/footer') %>
