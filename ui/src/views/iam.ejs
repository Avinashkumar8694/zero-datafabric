<%- include('partials/header') %>

<div class="page fade-in">
    <div class="page-head">
        <div>
            <h1 class="page-title">Identity</h1>
            <p class="page-sub">Provision users, assign them to tenant zones and revoke access.</p>
        </div>
    </div>

    <div class="split side-left">
        <!-- User Creation -->
        <section class="glass-card">
            <h3 id="formTitle">Provision New Identity</h3>
            <p>Grant access to specific tenant zones.</p>
            <form id="iamForm">
                <input type="hidden" id="editUserId">
                <div class="field"><label for="iamUsername">Username</label><input type="text" id="iamUsername" placeholder="Username" required autocomplete="off"></div>
                <div class="field"><label for="iamPassword">Password</label><input type="password" id="iamPassword" placeholder="Password" autocomplete="new-password"></div>
                <div class="field">
                    <label for="iamTenantId">Tenant</label>
                    <select id="iamTenantId" required></select>
                </div>
                <div class="field">
                    <label for="iamRole">Role</label>
                    <select id="iamRole">
                        <option value="USER">Standard User</option>
                        <option value="ADMIN">Administrator</option>
                    </select>
                </div>
                <button type="submit" id="submitBtn" class="btn-primary btn-block">Create Identity</button>
                <button type="button" id="cancelBtn" class="btn-outline btn-block mt-1" style="display: none;">Cancel Edit</button>
            </form>
            <div id="iamStatus" class="form-status" role="status" aria-live="polite"></div>
        </section>

        <!-- Identity Directory -->
        <section class="glass-card">
            <h3>Active Identity Directory</h3>
            <div class="table-wrapper">
                <table>
                    <thead>
                        <tr>
                            <th>User</th>
                            <th>Tenant</th>
                            <th>Role</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody id="iamBody">
                        <tr><td colspan="5" class="state-cell">Loading directory...</td></tr>
                    </tbody>
                </table>
            </div>
        </section>
    </div>
</div>

<script>
    async function loadTenants() {
        const select = document.getElementById('iamTenantId');
        try {
            const response = await fetch(`${API_BASE}/admin/tenants`, {
                headers: getAuthHeaders()
            });
            const data = await response.json();
            select.innerHTML = '<option value="">Assign Tenant...</option>' +
                data.map(t => `<option value="${escapeHtml(t.id)}">${escapeHtml(t.id)}</option>`).join('');
        } catch (err) {}
    }

    async function loadUsers() {
        const body = document.getElementById('iamBody');
        try {
            const response = await fetch(`${API_BASE}/admin/users`, {
                headers: getAuthHeaders()
            });
            const data = await response.json();
            if (!Array.isArray(data)) { body.innerHTML = '<tr><td colspan="5" class="state-cell">Unable to load identities.</td></tr>'; return; }
            body.innerHTML = data.map(u => `
                <tr class="fade-in">
                    <td><strong>${escapeHtml(u.username)}</strong></td>
                    <td><span class="badge badge-sync">${escapeHtml(u.tenant_id)}</span></td>
                    <td>${escapeHtml(u.role)}</td>
                    <td><span class="dot"></span> ${escapeHtml(u.status)}</td>
                    <td><div class="row-actions">
                        <button onclick="editUser('${escapeJs(u.id)}', '${escapeJs(u.username)}', '${escapeJs(u.tenant_id)}', '${escapeJs(u.role)}')" class="btn-outline btn-sm">Edit</button>
                        <button onclick="deleteUser('${escapeJs(u.id)}')" class="btn-outline btn-sm btn-danger">Revoke</button>
                    </div></td>
                </tr>
            `).join('');
        } catch (err) {
            body.innerHTML = '<tr><td colspan="5" class="state-cell">Unauthorized access</td></tr>';
        }
    }

    function editUser(id, username, tenantId, role) {
        document.getElementById('editUserId').value = id;
        document.getElementById('iamUsername').value = username;
        document.getElementById('iamTenantId').value = tenantId;
        document.getElementById('iamRole').value = role;
        document.getElementById('iamPassword').placeholder = 'Leave blank to keep current';
        document.getElementById('submitBtn').innerText = 'Update Identity';
        document.getElementById('cancelBtn').style.display = 'block';
        document.getElementById('formTitle').innerText = 'Update Identity';
    }

    document.getElementById('cancelBtn').addEventListener('click', () => {
        document.getElementById('iamForm').reset();
        document.getElementById('editUserId').value = '';
        document.getElementById('submitBtn').innerText = 'Create Identity';
        document.getElementById('cancelBtn').style.display = 'none';
        document.getElementById('formTitle').innerText = 'Provision New Identity';
    });

    function deleteUser(id) {
        showModal('Revoke Identity', 'Are you sure you want to revoke this identity?', async () => {
            try {
                const res = await fetch(`${API_BASE}/admin/users/${encodeURIComponent(id)}`, {
                    method: 'DELETE',
                    headers: getAuthHeaders()
                });
                if (!res.ok) { const o = await res.json().catch(() => ({})); throw new Error(o.error || `HTTP ${res.status}`); }
                loadUsers();
            } catch (e) { showModal('Revoke Failed', e.message); }
        }, 'Revoke');
    }

    document.getElementById('iamForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        const id = document.getElementById('editUserId').value;
        const payload = {
            username: document.getElementById('iamUsername').value,
            password: document.getElementById('iamPassword').value,
            tenantId: document.getElementById('iamTenantId').value,
            role: document.getElementById('iamRole').value
        };

        const method = id ? 'PUT' : 'POST';
        const url = id ? `${API_BASE}/admin/users/${id}` : `${API_BASE}/admin/users`;

        const btn = document.getElementById('submitBtn');
        const prev = btn.innerText;
        btn.disabled = true; btn.innerText = 'Saving…';
        try {
            const res = await fetch(url, {
                method,
                headers: getAuthHeaders(),
                body: JSON.stringify(payload)
            });
            const out = await res.json().catch(() => ({}));
            if (res.ok) {
                document.getElementById('cancelBtn').click();
                loadUsers();
            } else {
                showModal('Identity Error', out.error || `Request failed (HTTP ${res.status})`);
            }
        } catch (err) {
            showModal('Identity Error', err.message || 'Network error');
        } finally {
            btn.disabled = false; btn.innerText = prev;
        }
    });

    loadTenants();
    loadUsers();
</script>

<%- include('partials/footer') %>
