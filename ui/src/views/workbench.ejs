<%- include('partials/header') %>

<div class="fabric-container fade-in">
    <!-- Sidebar: Catalog Explorer -->
    <div class="fabric-sidebar">
        <div class="sidebar-header">
            <h1 class="sidebar-title">SQL & AST Workbench</h1>
            <div class="search-container">
                <i class="fas fa-search search-icon"></i>
                <input type="text" id="explorerSearch" placeholder="Search objects..." onkeyup="filterExplorer()">
            </div>
        </div>
        <div id="explorerTree" class="tree-view">
            <div class="loading-state"><div class="loading-spinner"></div></div>
        </div>
    </div>

    <!-- Main Panel: IDE Workspace -->
    <div class="fabric-main">
        <!-- Editor Section -->
        <div class="editor-section">
            <div class="editor-toolbar">
                <div class="mode-selector">
                    <button onclick="setMode('SQL')" id="modeSql" class="tab-btn active">SQL NATIVE</button>
                    <button onclick="setMode('CONFIG')" id="modeConfig" class="tab-btn">FEDERATED JSON (AST)</button>
                </div>
                <div class="execution-actions">
                    <button onclick="newQuery()" class="btn-secondary"><i class="fas fa-eraser"></i> Clear</button>
                    <button id="runBtn" class="btn-primary" onclick="executeCurrentQuery()"><i class="fas fa-play"></i> EXECUTE</button>
                </div>
            </div>

            <div id="sqlEditor" class="editor-wrapper">
                <textarea id="sqlInput" spellcheck="false" placeholder="-- PostgreSQL Native SQL Mode
SELECT * FROM shipments LIMIT 50;"></textarea>
            </div>

            <div id="configEditor" class="editor-wrapper" style="display: none;">
                <textarea id="configInput" spellcheck="false" placeholder='{
  "type": "SELECT",
  "tableId": "UUID_HERE",
  "limit": 50,
  "filter": { "status": "PENDING" }
}'></textarea>
            </div>
        </div>

        <!-- Results Section -->
        <div class="results-section">
            <div class="results-header">
                <div class="pipeline-title"><i class="fas fa-list-ul"></i> RESULT PIPELINE</div>
                <div class="pipeline-metrics">
                    <span id="sourceBadge" class="engine-badge" style="display: none;"></span>
                    <span id="execTime" class="metrics-text"></span>
                </div>
            </div>
            
            <div class="grid-viewport">
                <table id="resultsTable">
                    <thead id="resultsHead"></thead>
                    <tbody id="resultsBody">
                        <tr>
                            <td colspan="100" class="empty-state">
                                <i class="fas fa-terminal"></i>
                                <p>Ready for execution. Select a catalog object or write a query.</p>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    :root {
        --sidebar-bg: #f8fafc;
        --border-color: #e2e8f0;
        --active-blue: #2563eb;
        --text-main: #1e293b;
        --text-dim: #64748b;
        --editor-bg: #1e293b;
    }

    .fabric-container { display: flex; height: calc(100vh - 80px); background: #fff; overflow: hidden; }
    
    /* Sidebar Styles */
    .fabric-sidebar { width: 300px; background: var(--sidebar-bg); border-right: 1px solid var(--border-color); display: flex; flex-direction: column; }
    .sidebar-header { padding: 1.5rem; border-bottom: 1px solid var(--border-color); }
    .sidebar-title { font-size: 1rem; font-weight: 800; color: var(--text-main); margin-bottom: 1rem; }
    .search-container { position: relative; }
    .search-icon { position: absolute; left: 0.75rem; top: 50%; transform: translateY(-50%); color: var(--text-dim); font-size: 0.8rem; }
    #explorerSearch { width: 100%; padding: 0.5rem 0.75rem 0.5rem 2.25rem; border: 1px solid var(--border-color); border-radius: 6px; font-size: 0.8rem; }

    /* Tree Styles */
    .tree-view { flex: 1; overflow-y: auto; padding: 1rem 0; }
    .tree-node { padding: 0.5rem 1.25rem; font-weight: 700; color: var(--text-main); font-size: 0.85rem; display: flex; align-items: center; gap: 0.5rem; margin-top: 0.5rem; }
    .tree-cat { padding: 0.25rem 2rem; font-size: 0.65rem; font-weight: 800; color: var(--text-dim); text-transform: uppercase; margin-top: 0.5rem; }
    .tree-item { padding: 0.4rem 2.5rem; cursor: pointer; display: flex; align-items: center; gap: 0.5rem; font-size: 0.8rem; color: var(--text-dim); transition: 0.2s; }
    .tree-item:hover { background: #f1f5f9; color: var(--active-blue); }
    .tree-item.active { background: #eff6ff; color: var(--active-blue); font-weight: 600; border-right: 3px solid var(--active-blue); }

    /* Main Styles */
    .fabric-main { flex: 1; display: flex; flex-direction: column; overflow: hidden; }
    .editor-section { height: 350px; display: flex; flex-direction: column; border-bottom: 4px solid var(--border-color); }
    .editor-toolbar { padding: 0.75rem 1.5rem; border-bottom: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center; background: #fff; }
    .mode-selector { display: flex; gap: 0.5rem; }
    .tab-btn { padding: 0.4rem 0.75rem; border: none; background: none; font-size: 0.75rem; font-weight: 700; cursor: pointer; border-radius: 4px; color: var(--text-dim); }
    .tab-btn.active { background: #eff6ff; color: var(--active-blue); }
    .execution-actions { display: flex; gap: 0.75rem; }

    .editor-wrapper { flex: 1; background: var(--editor-bg); }
    textarea { width: 100%; height: 100%; background: transparent; border: none; padding: 1.5rem; color: #e2e8f0; font-family: 'JetBrains Mono', monospace; font-size: 0.9rem; outline: none; resize: none; line-height: 1.5; }

    /* Results Styles */
    .results-section { flex: 1; display: flex; flex-direction: column; overflow: hidden; background: #fff; }
    .results-header { padding: 0.75rem 1.5rem; border-bottom: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center; background: #f8fafc; }
    .pipeline-title { font-size: 0.75rem; font-weight: 800; color: var(--text-dim); }
    .pipeline-metrics { display: flex; align-items: center; gap: 1rem; }
    .metrics-text { font-size: 0.7rem; font-weight: 600; color: var(--text-dim); }
    .engine-badge { font-size: 0.65rem; font-weight: 700; background: #eff6ff; color: var(--active-blue); padding: 0.2rem 0.5rem; border-radius: 4px; border: 1px solid #dbeafe; }

    .grid-viewport { flex: 1; overflow: auto; }
    table { width: 100%; border-collapse: collapse; font-size: 0.8rem; }
    th { background: #fff; padding: 0.75rem 1rem; text-align: left; border-bottom: 1px solid var(--border-color); color: var(--text-dim); position: sticky; top: 0; z-index: 10; border-right: 1px solid #f1f5f9; }
    td { padding: 0.6rem 1rem; border-bottom: 1px solid #f1f5f9; color: var(--text-main); border-right: 1px solid #f1f5f9; white-space: nowrap; }
    tr:hover { background: #f8fafc; }

    .empty-state { text-align: center; padding: 4rem !important; color: #cbd5e1; border: none !important; }
    .empty-state i { font-size: 3rem; margin-bottom: 1.5rem; display: block; }
</style>

<script>
    let currentMode = 'SQL';
    let explorerData = [];

    async function loadExplorer() {
        const tree = document.getElementById('explorerTree');
        try {
            const sRes = await fetch(`${API_BASE}/metadata/sources`, { headers: getAuthHeaders() });
            const sources = await sRes.json();
            
            let html = '';
            for (const s of sources) {
                html += `<div class="tree-node"><i class="fas fa-server"></i> ${s.name}</div><div id="source-${s.id}-schemas"></div>`;
            }
            tree.innerHTML = html;

            // Load schemas after containers exist
            for (const s of sources) {
                loadWorkbenchSchemas(s.id, s.name);
            }
        } catch (e) { tree.innerHTML = 'Error loading tree.'; }
    }

    async function loadWorkbenchSchemas(sourceId, sourceName) {
        const schemaEl = document.getElementById(`source-${sourceId}-schemas`);
        try {
            const schRes = await fetch(`${API_BASE}/metadata/schemas?sourceId=${sourceId}`, { headers: getAuthHeaders() });
            const schemas = await schRes.json();
            
            let html = '';
            for (const sch of schemas) {
                html += `<div class="tree-item" style="padding-left:1.5rem; font-weight:600;"><i class="fas fa-folder"></i> ${sch.name}</div>`;
                const resRes = await fetch(`${API_BASE}/metadata/tables?schemaId=${sch.schemaId}`, { headers: getAuthHeaders() });
                const resources = await resRes.json();
                
                const categories = {
                    'STORAGE': resources.filter(r => r.resourceType === 'TABLE'),
                    'VIEWS': resources.filter(r => r.resourceType.includes('VIEW')),
                    'LOGIC': resources.filter(r => ['FUNCTION', 'PROCEDURE', 'TRIGGER'].includes(r.resourceType))
                };

                for (const [cat, items] of Object.entries(categories)) {
                    if (items.length > 0) {
                        html += `<div class="tree-cat">${cat}</div>`;
                        items.forEach(t => {
                            html += `<div class="tree-item" onclick="selectResource('${t.tableId}', '${t.name}', '${sourceName}', this)"><i class="fas ${getIcon(t.resourceType)}"></i> ${t.name}</div>`;
                        });
                    }
                }
            }
            schemaEl.innerHTML = html;
        } catch (e) { schemaEl.innerHTML = 'Error loading schemas.'; }
    }
    function getIcon(type) {
        switch(type) {
            case 'TABLE': return 'fa-table';
            case 'VIEW': return 'fa-eye';
            case 'MATERIALIZED_VIEW': return 'fa-bolt';
            case 'SEQUENCE': return 'fa-sort-numeric-up';
            case 'FUNCTION': return 'fa-code';
            case 'PROCEDURE': return 'fa-cogs';
            case 'ENUM': return 'fa-list-ul';
            case 'TRIGGER': return 'fa-running';
            case 'POLICY': return 'fa-shield-alt';
            default: return 'fa-cube';
        }
    }

    function selectResource(tableId, name, sourceName, el) {
        document.querySelectorAll('.tree-item').forEach(i => i.classList.remove('active'));
        el.classList.add('active');
        
        document.getElementById('sourceBadge').style.display = 'block';
        document.getElementById('sourceBadge').innerText = `${sourceName} / ${name}`;
        
        const config = { type: 'SELECT', tableId: tableId, limit: 50 };
        document.getElementById('configInput').value = JSON.stringify(config, null, 2);
        document.getElementById('sqlInput').value = `SELECT * FROM "${name}" LIMIT 50;`;
    }

    function setMode(mode) {
        currentMode = mode;
        document.getElementById('modeSql').classList.toggle('active', mode === 'SQL');
        document.getElementById('modeConfig').classList.toggle('active', mode === 'CONFIG');
        document.getElementById('sqlEditor').style.display = mode === 'SQL' ? 'block' : 'none';
        document.getElementById('configEditor').style.display = mode === 'CONFIG' ? 'block' : 'none';
    }

    function newQuery() {
        document.getElementById('sqlInput').value = '';
        document.getElementById('configInput').value = '';
        document.getElementById('sourceBadge').style.display = 'none';
    }

    async function executeCurrentQuery() {
        const btn = document.getElementById('runBtn');
        btn.disabled = true;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> RUNNING';
        
        const start = performance.now();
        const head = document.getElementById('resultsHead');
        const body = document.getElementById('resultsBody');
        body.innerHTML = '<tr><td colspan="100" style="text-align:center; padding:5rem;">Executing query...</td></tr>';

        try {
            let res, data;
            if (currentMode === 'SQL') {
                res = await fetch(`${API_BASE}/queries/exec`, {
                    method: 'POST',
                    headers: getAuthHeaders(),
                    body: JSON.stringify({ sql: document.getElementById('sqlInput').value })
                });
            } else {
                res = await fetch(`${API_BASE}/queries/engine`, {
                    method: 'POST',
                    headers: getAuthHeaders(),
                    body: JSON.stringify(JSON.parse(document.getElementById('configInput').value))
                });
            }
            data = await res.json();
            const results = Array.isArray(data) ? data : (data.results || []);
            
            document.getElementById('execTime').innerText = `${Math.round(performance.now() - start)}ms`;
            
            if (results.length === 0) {
                body.innerHTML = '<tr><td colspan="100" style="text-align:center; padding:5rem;">Empty result set.</td></tr>';
                return;
            }

            const cols = Object.keys(results[0]);
            head.innerHTML = `<tr>${cols.map(c => `<th>${c}</th>`).join('')}</tr>`;
            body.innerHTML = results.map(row => `<tr>${cols.map(c => `<td>${typeof row[c] === 'object' ? JSON.stringify(row[c]) : row[c]}</td>`).join('')}</tr>`).join('');
        } catch (e) {
            body.innerHTML = `<tr><td colspan="100" style="text-align:center; padding:5rem; color:red;">Execution failed: ${e.message}</td></tr>`;
        } finally {
            btn.disabled = false;
            btn.innerHTML = '<i class="fas fa-play"></i> EXECUTE';
        }
    }

    loadExplorer();
</script>

<%- include('partials/footer') %>
