# ─────────────────────────────────────────────
# Backend API — Environment Configuration
# ─────────────────────────────────────────────

# HTTP port
PORT=4000

# Database (fabric hub)
DATABASE_URL=postgresql://fabric_admin:fabric_password@localhost:5434/datafabric

# JWT signing secret
JWT_SECRET=reallyreallyreallyreallyverysecret

# ── SSO / OIDC ───────────────────────────────
OIDC_ISSUER=https://ids.fabrixly.com/oidc
OIDC_CLIENT_ID=zero-datafabric
OIDC_CLIENT_SECRET=bc79a2ed33935010666d9e4e1e0f29d7c80f0cd01d4a45267b6bc9b51fb9dd1d
OIDC_CALLBACK_URL=http://localhost:4000/api/auth/sso/callback
UI_BASE_URL=http://localhost:3006

# ── Redis (query cache + rate limiting) ──────
REDIS_URL=redis://localhost:6379

# ── Kafka ────────────────────────────────────
KAFKA_BROKERS=localhost:9092

# ── Replication engine mode ──────────────────
# Set to true when running replication-engine as a SEPARATE microservice.
# This disables the embedded copy-job worker inside the API process.
REPLICATION_ENGINE_EXTERNAL=false

# ── Kafka CDC pipeline (optional) ────────────
FABRIC_CDC_VIA_KAFKA=false

