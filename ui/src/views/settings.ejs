<%- include('partials/header') %>

<link rel="stylesheet" href="/css/settings-extra.css">
<link rel="stylesheet" href="/css/console-settings.css">

<div class="ws-page">
    <div class="ws-head">
        <div>
            <h1 class="ws-title">Workspace settings</h1>
            <p class="ws-sub" id="wsSubtitle">Settings, security, API access and plan for the active workspace.</p>
        </div>
        <div class="ws-head-badges" id="wsHeadBadges"></div>
    </div>

    <div id="wsNotice"></div>

    <div class="st-tabs" role="tablist" aria-label="Workspace settings sections">
        <button class="st-tab" role="tab" data-tab="overview" aria-selected="true"><i class="fas fa-gauge" aria-hidden="true"></i> Overview</button>
        <button class="st-tab" role="tab" data-tab="general" aria-selected="false"><i class="fas fa-sliders" aria-hidden="true"></i> General</button>
        <button class="st-tab" role="tab" data-tab="query" aria-selected="false"><i class="fas fa-database" aria-hidden="true"></i> Query</button>
        <button class="st-tab" role="tab" data-tab="security" aria-selected="false"><i class="fas fa-shield-halved" aria-hidden="true"></i> Security</button>
        <button class="st-tab" role="tab" data-tab="api" aria-selected="false"><i class="fas fa-key" aria-hidden="true"></i> API</button>
        <button class="st-tab" role="tab" data-tab="plan" aria-selected="false"><i class="fas fa-layer-group" aria-hidden="true"></i> Plan &amp; usage</button>
    </div>

    <section id="tab-overview" class="st-panel" role="tabpanel"><div id="wsOverview"></div></section>
    <section id="tab-general" class="st-panel" role="tabpanel" hidden></section>
    <section id="tab-query" class="st-panel" role="tabpanel" hidden></section>
    <section id="tab-security" class="st-panel" role="tabpanel" hidden></section>
    <section id="tab-api" class="st-panel" role="tabpanel" hidden>
        <div id="apiPolicyNote"></div>
        <div id="apiPolicy"></div>
        <div class="ws-card">
            <div class="ws-card-head"><h3><i class="fas fa-key" aria-hidden="true"></i> Developer tokens</h3></div>
            <%- include('partials/settings_tokens') %>
        </div>
    </section>
    <section id="tab-plan" class="st-panel" role="tabpanel" hidden></section>
</div>

<script src="/js/console-common.js"></script>
<script src="/js/settings-tokens.js"></script>
<script src="/js/workspace-main.js"></script>
<script src="/js/workspace-forms.js"></script>
<script src="/js/workspace-security.js"></script>
<script src="/js/workspace-api.js"></script>
<script src="/js/workspace-plan.js"></script>
<script>WS.start();</script>

<%- include('partials/footer') %>
