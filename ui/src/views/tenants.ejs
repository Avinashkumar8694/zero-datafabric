<%- include('partials/header') %>

<div class="page fade-in">
    <div class="page-head">
        <div>
            <h1 class="page-title">Tenants</h1>
            <p class="page-sub">Provision isolated schema namespaces and suspend or resume them.</p>
        </div>
    </div>

    <div class="split side-left">
        <!-- Provisioning Form -->
        <section class="glass-card">
            <h3>Provision New Tenant</h3>
            <p>Create a fresh isolated schema namespace.</p>
            <form id="tenantForm">
                <div class="field">
                    <label for="tenantId">Tenant ID</label>
                    <input type="text" id="tenantId" placeholder="e.g. Acme_Corp" required autocomplete="off">
                </div>
                <div class="field">
                    <label for="tenantName">Display name</label>
                    <input type="text" id="tenantName" placeholder="Display Name" required autocomplete="off">
                </div>
                <button type="submit" class="btn-primary btn-block">Deploy Namespace</button>
            </form>
            <div id="tenantStatus" class="form-status" role="status" aria-live="polite"></div>
        </section>

        <!-- Active Tenants Table -->
        <section class="glass-card">
            <h3>Namespace Directory</h3>
            <div class="table-wrapper">
                <table>
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Name</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody id="tenantsBody">
                        <tr><td colspan="4" class="state-cell">Loading namespaces...</td></tr>
                    </tbody>
                </table>
            </div>
        </section>
    </div>
</div>

<script>
    async function loadTenants() {
        const body = document.getElementById('tenantsBody');
        try {
            const response = await fetch(`${API_BASE}/tenants`, {
                headers: getAuthHeaders()
            });
            const data = await response.json();
            
            if (!response.ok) {
                body.innerHTML = `<tr><td colspan="4" class="state-cell text-danger">Error: ${data.error || 'Failed to load namespaces'}</td></tr>`;
                return;
            }

            if (!Array.isArray(data)) {
                body.innerHTML = `<tr><td colspan="4" class="state-cell text-danger">Error: Invalid data format received</td></tr>`;
                return;
            }

            body.innerHTML = data.slice(0, 500).map(t => `
                <tr class="fade-in">
                    <td><code>${escapeHtml(t.id)}</code></td>
                    <td><strong>${escapeHtml(t.name)}</strong></td>
                    <td><span class="dot ${t.status === 'ACTIVE' ? '' : 'warn'}"></span> ${escapeHtml(t.status)}</td>
                    <td>
                        <button onclick="updateTenantStatus('${escapeJs(t.id)}', '${escapeJs(t.name)}', '${t.status === 'ACTIVE' ? 'SUSPENDED' : 'ACTIVE'}')" class="btn-outline btn-sm">
                            ${t.status === 'ACTIVE' ? 'Suspend' : 'Resume'}
                        </button>
                    </td>
                </tr>
            `).join('') + (data.length > 500
                ? `<tr><td colspan="4" class="state-cell">Showing 500 of ${escapeHtml(data.length)} namespaces</td></tr>`
                : '');
        } catch (err) {
            console.error('Fetch Error:', err);
            body.innerHTML = '<tr><td colspan="4" class="state-cell text-danger">Connection Error: Orchestrator Offline</td></tr>';
        }
    }

    async function updateTenantStatus(id, name, status) {
        try {
            const response = await fetch(`${API_BASE}/tenants/${id}`, {
                method: 'PUT',
                headers: getAuthHeaders(),
                body: JSON.stringify({ name, status })
            });
            if (!response.ok) {
                let msg = 'Failed to update tenant status.';
                try { const err = await response.json(); msg = err.error || msg; } catch (_) {}
                showModal('Status Update Failed', msg);
                return;
            }
            loadTenants();
        } catch (e) {
            showModal('Error', 'Status update failed: Orchestrator unreachable.');
        }
    }

    document.getElementById('tenantForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        const id = document.getElementById('tenantId').value;
        const name = document.getElementById('tenantName').value;
        const statusEl = document.getElementById('tenantStatus');
        const submitBtn = e.target.querySelector('button[type="submit"]');
        if (submitBtn) submitBtn.disabled = true;

        try {
            const response = await fetch(`${API_BASE}/tenants`, {
                method: 'POST',
                headers: getAuthHeaders(),
                body: JSON.stringify({ id, name })
            });
            const data = await response.json();
            statusEl.innerText = response.ok ? `Tenant ${id} provisioned successfully.` : (data.error || 'Provisioning failed');
            statusEl.className = 'form-status ' + (response.ok ? 'ok' : 'err');
            if (response.ok) {
                document.getElementById('tenantForm').reset();
                loadTenants();
                if (typeof loadTenantSwitcher === 'function') {
                    loadTenantSwitcher();
                }
            }
        } catch (err) {
            statusEl.innerText = 'API Connection Error';
            statusEl.className = 'form-status err';
        } finally {
            if (submitBtn) submitBtn.disabled = false;
        }
    });

    loadTenants();
</script>

<%- include('partials/footer') %>
