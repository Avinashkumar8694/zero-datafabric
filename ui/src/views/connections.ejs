<%- include('partials/header') %>

<div class="page fade-in">
    <div class="page-head">
        <div>
            <h1 class="page-title">Source Connectivity</h1>
            <p class="page-sub">Live registry view with real-time source reachability.</p>
        </div>
        <div class="page-actions">
            <span id="connCountBadge" class="badge badge-info"><i class="fas fa-network-wired" aria-hidden="true"></i> <span id="connCountText">0 Sources Active</span></span>
            <button type="button" class="btn-primary" onclick="openConnectionModal()"><i class="fas fa-plus" aria-hidden="true"></i> Add Data Source</button>
        </div>
    </div>

    <section class="glass-card">
        <div class="card-head">
            <h3><i class="fas fa-layer-group" aria-hidden="true"></i> Fabric Source Registry</h3>
            <div class="card-actions"><button type="button" class="btn-outline btn-sm" onclick="loadConnections()"><i class="fas fa-heartbeat" aria-hidden="true"></i> Check All Connections</button></div>
        </div>
        <div class="table-wrapper">
            <table>
                <thead>
                    <tr>
                        <th>Engine</th>
                        <th>Source Identity</th>
                        <th>Sync Strategy</th>
                        <th>Connection Endpoint</th>
                        <th>Stored Status</th>
                        <th>Live Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody id="connectionsBody">
                    <tr><td colspan="7" class="state-cell">
                        <span class="spinner" aria-hidden="true"></span> Loading connection registry...
                    </td></tr>
                </tbody>
            </table>
        </div>
    </section>
</div>

<div id="connectionModal" class="modal-overlay" role="dialog" aria-modal="true" aria-labelledby="connModalTitle">
    <div class="modal-card lg">
        <div class="modal-header">
            <h3 id="connModalTitle"><i class="fas fa-plus-circle" aria-hidden="true"></i> Add New Data Source</h3>
            <button type="button" class="modal-close" onclick="closeConnectionModal()" aria-label="Close dialog">&times;</button>
        </div>
        <div class="modal-body">
            <form id="connectionForm">
                <div class="cols-2">
                    <div class="field">
                        <label for="connName">Source Name</label>
                        <input type="text" id="connName" placeholder="e.g. Production_PG" required>
                    </div>
                    <div class="field">
                        <label for="connType">Database Engine</label>
                        <select id="connType" onchange="applyEngineFieldConfig()">
                            <option value="postgres">PostgreSQL</option>
                            <option value="mysql">MySQL / MariaDB</option>
                            <option value="mongodb">MongoDB</option>
                            <option value="snowflake">Snowflake</option>
                            <option value="elasticsearch">Elasticsearch</option>
                            <option value="oracle">Oracle Database</option>
                        </select>
                    </div>
                </div>

                <div class="cols-2">
                    <div class="field">
                        <label for="syncType">Sync Strategy</label>
                        <select id="syncType" onchange="applySyncFieldConfig()">
                            <option value="VIRTUAL">VIRTUAL — query live at the source (zero copy)</option>
                            <option value="SYNC">SYNC — one-time full copy into the hub</option>
                            <option value="CDC">CDC — copy + incremental refresh (watermark)</option>
                        </select>
                    </div>
                    <div class="field" id="cdcCol" style="display:none;">
                        <label for="cdcColumn">CDC Watermark Column</label>
                        <input id="cdcColumn" placeholder="e.g. updated_at or id">
                    </div>
                </div>
                <div id="cdcRow" class="cols-2" style="display:none;">
                    <div class="field">
                        <label for="cdcInterval">Poll interval (ms)</label>
                        <input id="cdcInterval" placeholder="15000" value="15000">
                    </div>
                    <p class="hint field-note">CDC pulls rows where <b>watermark &gt; last</b> on each poll and upserts them into the hub replica.</p>
                </div>
                <div id="syncSchedRow" class="cols-2" style="display:none;">
                    <div class="field">
                        <label for="syncSchedule">Scheduled full re-sync (ms, optional)</label>
                        <input id="syncSchedule" placeholder="e.g. 3600000 (1h), blank = manual only">
                    </div>
                    <p class="hint field-note">Leave blank for on-demand only. Set an interval to periodically re-copy the full source into the hub (keeps a SYNC replica fresh without CDC).</p>
                </div>
                <script>
                    function applySyncFieldConfig() {
                        var v = document.getElementById('syncType').value;
                        document.getElementById('cdcCol').style.display = v === 'CDC' ? '' : 'none';
                        document.getElementById('cdcRow').style.display = v === 'CDC' ? '' : 'none';
                        document.getElementById('syncSchedRow').style.display = v === 'SYNC' ? '' : 'none';
                    }
                </script>

                <div class="cols-host">
                    <div class="field" id="row-host">
                        <label for="connHost">Host</label>
                        <input type="text" id="connHost" placeholder="localhost" required>
                    </div>
                    <div class="field" id="row-port">
                        <label for="connPort">Port</label>
                        <input type="number" id="connPort" value="5432">
                    </div>
                </div>

                <div class="field" id="row-db">
                    <label for="connDB">Database Name</label>
                    <input type="text" id="connDB" placeholder="datafabric">
                </div>

                <div id="row-user-pass" class="cols-2">
                    <div class="field" id="row-user">
                        <label for="connUser">User</label>
                        <input type="text" id="connUser" placeholder="admin" autocomplete="off">
                    </div>
                    <div class="field" id="row-pass">
                        <label for="connPass">Password</label>
                        <input type="password" id="connPass" placeholder="••••" autocomplete="new-password">
                    </div>
                </div>
                <div class="field" id="row-conn-string" style="display:none;">
                    <label for="connConnString">Connection String (Optional)</label>
                    <input type="text" id="connConnString" placeholder="mongodb://... or https://...">
                </div>

                <div id="row-snowflake" class="cols-2" style="display:none;">
                    <div class="field">
                        <label for="connAccount">Account</label>
                        <input type="text" id="connAccount" placeholder="xy12345.ap-south-1">
                    </div>
                    <div class="field">
                        <label for="connWarehouse">Warehouse</label>
                        <input type="text" id="connWarehouse" placeholder="COMPUTE_WH">
                    </div>
                    <div class="field">
                        <label for="connRole">Role</label>
                        <input type="text" id="connRole" placeholder="SYSADMIN">
                    </div>
                    <div class="field">
                        <label for="connSchema">Schema</label>
                        <input type="text" id="connSchema" placeholder="PUBLIC">
                    </div>
                </div>
                <div class="form-actions">
                    <button type="button" class="btn-outline" onclick="closeConnectionModal()">Cancel</button>
                    <button type="submit" class="btn-primary"><i class="fas fa-bolt" aria-hidden="true"></i> Connect Source</button>
                </div>
            </form>
            <div id="connStatus" class="form-status text-center" role="status" aria-live="polite"></div>
        </div>
    </div>
</div>

<script>
    function openConnectionModal() {
        document.getElementById('connectionModal').classList.add('active');
    }
    function closeConnectionModal() {
        document.getElementById('connectionModal').classList.remove('active');
        document.getElementById('connStatus').innerHTML = '';
    }

    function updateDefaultPort() {
        const type = document.getElementById('connType').value;
        const portMap = { postgres: 5432, mysql: 3306, mongodb: 27017, snowflake: 443, elasticsearch: 9200, oracle: 1521 };
        document.getElementById('connPort').value = portMap[type] || 5432;
    }
    function setRequired(id, required) {
        const el = document.getElementById(id);
        if (el) el.required = required;
    }
    function toggleRow(id, show, display = 'block') {
        const row = document.getElementById(id);
        if (row) row.style.display = show ? '' : 'none'; // '' lets the shared .field / .cols-2 classes decide the layout
    }
    function applyEngineFieldConfig() {
        const type = document.getElementById('connType').value;
        updateDefaultPort();

        toggleRow('row-host', true, 'block');
        toggleRow('row-port', true, 'block');
        toggleRow('row-db', true, 'block');
        toggleRow('row-user-pass', true, 'grid');
        toggleRow('row-conn-string', true, 'block');
        toggleRow('row-snowflake', false, 'grid');

        setRequired('connHost', false);
        setRequired('connDB', false);
        setRequired('connUser', false);
        setRequired('connPass', false);
        setRequired('connAccount', false);

        if (type === 'postgres' || type === 'mysql' || type === 'oracle') {
            setRequired('connHost', true);
            setRequired('connDB', true);   // Oracle: service name (e.g. FREEPDB1)
            setRequired('connUser', true);
        } else if (type === 'mongodb') {
            setRequired('connHost', true);
        } else if (type === 'snowflake') {
            toggleRow('row-snowflake', true, 'grid');
            setRequired('connAccount', true);
            setRequired('connUser', true);
            setRequired('connPass', true);
        } else if (type === 'elasticsearch') {
            setRequired('connHost', true);
        }
    }

    function getStatusBadge(status) {
        const cls = status === 'CONNECTED' || status === 'ACTIVE' ? 'badge-ok' : 'badge-danger';
        return `<div class="badge ${cls}">${escapeHtml(status)}</div>`;
    }

    function getLiveBadge(status) {
        const map = { LIVE: 'badge-ok', UNREACHABLE: 'badge-danger', OFFLINE: 'badge-muted', UNKNOWN: 'badge-warn' };
        return `<div class="badge ${map[status] || map.UNKNOWN}">${escapeHtml(status)}</div>`;
    }
    function isConnectedStatus(status) {
        return ['CONNECTED', 'ACTIVE'].includes((status || '').toUpperCase());
    }

    async function loadConnections() {
        const body = document.getElementById('connectionsBody');
        body.innerHTML = '<tr><td colspan="7" class="state-cell">Loading connection registry…</td></tr>';
        try {
            const response = await fetch(`${API_BASE}/admin/connections`, { headers: getAuthHeaders() });
            const data = await response.json();

            if (!Array.isArray(data) || data.length === 0) {
                document.getElementById('connCountText').innerText = `${Array.isArray(data) ? data.length : 0} Sources Active`;
                body.innerHTML = '<tr><td colspan="7" class="state-cell">No integrated sources found in this tenant.</td></tr>';
                return;
            }

            document.getElementById('connCountText').innerText = `${data.length} Sources Active`;

            const capped = data.slice(0, 500);
            const rows = capped.map(c => {
                const connected = isConnectedStatus(c.status);
                const nextStatus = connected ? 'DISCONNECTED' : 'ACTIVE';
                const config = c.config || {};
                const syncType = c.sync_type || config.syncType || 'N/A';
                const endpoint = config.host ? `${config.host}:${config.port}` : (config.uri || config.connectionString || 'N/A');
                return `
                <tr class="fade-in">
                    <td><div class="badge badge-muted">${escapeHtml((c.type || '').toUpperCase())}</div></td>
                    <td>
                        <div><strong>${escapeHtml(c.name)}</strong></div>
                        <div class="text-muted small">ID: ${escapeHtml(String(c.id || '').substring(0,8))}...</div>
                    </td>
                    <td><div class="badge badge-info">${escapeHtml(syncType)}</div></td>
                    <td class="endpoint-cell"><code>${escapeHtml(endpoint)}</code></td>
                    <td>${getStatusBadge(c.status)}</td>
                    <td>${getLiveBadge(c.live_status || 'UNKNOWN')}</td>
                    <td>
                        <div class="row-actions">
                            <button onclick="toggleConnectionStatus('${escapeJs(c.id)}', '${nextStatus}')" class="btn-outline btn-sm">
                                <i class="fas fa-power-off" aria-hidden="true"></i> ${connected ? 'Disconnect' : 'Connect'}
                            </button>
                            ${(String(syncType).toUpperCase() === 'SYNC' || String(syncType).toUpperCase() === 'CDC') ? `
                            <button onclick="runSync('${escapeJs(c.name)}','full')" class="btn-outline btn-sm" title="Full backfill from source into hub"><i class="fas fa-sync" aria-hidden="true"></i> Sync</button>` : ''}
                            ${String(syncType).toUpperCase() === 'CDC' ? `
                            <button onclick="runSync('${escapeJs(c.name)}','cdc')" class="btn-outline btn-sm" title="Incremental CDC refresh (watermark)"><i class="fas fa-bolt" aria-hidden="true"></i> CDC</button>` : ''}
                            <button onclick="removeConnection('${escapeJs(c.id)}', '${escapeJs(c.name)}')" class="btn-outline btn-sm btn-danger" aria-label="Remove source"><i class="fas fa-trash-alt" aria-hidden="true"></i></button>
                        </div>
                    </td>
                </tr>
            `;
            }).join('');
            const note = data.length > 500
                ? `<tr><td colspan="7" class="state-cell">Showing 500 of ${escapeHtml(data.length)} sources</td></tr>`
                : '';
            body.innerHTML = rows + note;
        } catch (err) {
            body.innerHTML = '<tr><td colspan="7" class="state-cell text-danger">Failed to synchronize with Fabric API.</td></tr>';
        }
    }

    async function toggleConnectionStatus(id, newStatus) {
        try {
            const res = await fetch(`${API_BASE}/admin/connections`, {
                method: 'PATCH',
                headers: getAuthHeaders(),
                body: JSON.stringify({ sourceId: id, status: newStatus })
            });
            if (res.ok) {
                showModal('Success', `Source is now ${newStatus.toLowerCase()}.`);
                loadConnections();
            } else {
                const err = await res.json();
                showModal('Status Update Failed', err.error);
            }
        } catch (e) {
            showModal('Error', `Status update failed: ${e.message || 'API unreachable'}`);
        }
    }

    // Manually trigger a physical SYNC/CDC replication of a source into the hub.
    async function runSync(source, mode) {
        showModal('Queuing…', `Assigning ${mode === 'cdc' ? 'CDC refresh' : 'full sync'} of "${source}" to the replication worker…`);
        try {
            const res = await fetch(`${API_BASE}/metadata/sync`, {
                method: 'POST', headers: getAuthHeaders(),
                body: JSON.stringify({ source, mode: mode === 'cdc' ? 'cdc' : 'full' })
            });
            const d = await res.json();
            if (!res.ok) return showModal('Sync failed', d.error || 'Unknown error');
            pollSyncRun(d.runId, mode === 'cdc' ? 'CDC refresh' : 'Full sync', source);
        } catch (e) {
            showModal('Error', `Sync failed: ${e.message || 'API unreachable'}`);
        }
    }

    // Poll a queued SYNC/CDC copy-job run to completion and summarize.
    async function pollSyncRun(runId, title, source) {
        for (let i = 0; i < 200; i++) {
            let run;
            try { run = await (await fetch(`${API_BASE}/replication/runs/${runId}`, { headers: getAuthHeaders() })).json(); }
            catch { await new Promise(r => setTimeout(r, 1500)); continue; }
            if (run.status === 'COMPLETED' || run.status === 'FAILED') {
                if (run.status === 'FAILED') return showModal(`${title} failed`, `<span class="text-danger">${escapeHtml(run.error || 'failed')}</span>`);
                const r = run.result || {};
                const total = (r.tables || []).reduce((n, t) => n + (t.rows || 0), 0);
                const detail = (r.tables || []).map(t => `${escapeHtml(t.schema||'')}.${escapeHtml(t.table||'')}: ${t.rows} rows (${escapeHtml(t.mode||'')})`).join('<br>') || 'no tables';
                return showModal(`${title} complete — "${escapeHtml(source)}"`, `<b>${total}</b> rows across ${(r.tables || []).length} table(s):<br>${detail}${(r.errors || []).length ? '<br><span class="text-danger">' + r.errors.join('<br>') + '</span>' : ''}`);
            }
            showModal(`${title}…`, `Worker status: <b>${escapeHtml(run.status)}</b> (attempt ${run.attempts||0})…`);
            await new Promise(r => setTimeout(r, 1500));
        }
        showModal(title, 'Still running — check the Replication page → Copy-job runs.');
    }

    async function removeConnection(id, name) {
        showModal('Purge Source Registry', `Are you absolutely sure you want to remove '${name}'? This will permanently delete all metadata, virtual tables, and ingested cache.`, async () => {
            try {
                const res = await fetch(`${API_BASE}/admin/connections/${id}`, {
                    method: 'DELETE',
                    headers: getAuthHeaders()
                });
                if (res.ok) {
                    showModal('Zero-Trace Success', 'Source and all associated footprints have been purged from the fabric.');
                    loadConnections();
                } else {
                    const err = await res.json();
                    showModal('Purge Failed', err.error);
                }
            } catch (e) {
                showModal('Error', 'Purge API unreachable.');
            }
        }, 'CONFIRM PURGE');
    }

    document.getElementById('connectionForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        const statusEl = document.getElementById('connStatus');
        const submitBtn = e.target.querySelector('button[type="submit"]');
        if (submitBtn) submitBtn.disabled = true;
        statusEl.innerHTML = '<span class="text-muted"><i class="fas fa-circle-notch fa-spin"></i> Initializing orchestration...</span>';

        const type = document.getElementById('connType').value;
        const common = {
            type,
            syncType: document.getElementById('syncType').value,
            host: document.getElementById('connHost').value || undefined,
            port: parseInt(document.getElementById('connPort').value),
            connectionString: document.getElementById('connConnString').value || undefined,
            user: document.getElementById('connUser').value || undefined,
            pass: document.getElementById('connPass').value || undefined
        };
        // CDC config: watermark column + poll interval (only when syncType === CDC).
        if (common.syncType === 'CDC') {
            const col = document.getElementById('cdcColumn').value.trim();
            if (col) common.cdc = { column: col, intervalMs: parseInt(document.getElementById('cdcInterval').value) || 15000 };
        }
        // SYNC config: optional scheduled full re-sync interval.
        if (common.syncType === 'SYNC') {
            const sched = parseInt(document.getElementById('syncSchedule').value);
            if (sched > 0) common.sync = { scheduleMs: sched };
        }
        let config = { ...common };
        if (type === 'postgres' || type === 'mysql' || type === 'mongodb') {
            config = { ...common, dbName: document.getElementById('connDB').value || undefined };
        } else if (type === 'oracle') {
            // Oracle: the "Database" field is the service name (e.g. FREEPDB1).
            config = { ...common, dbName: document.getElementById('connDB').value || undefined, serviceName: document.getElementById('connDB').value || undefined };
        } else if (type === 'snowflake') {
            config = {
                ...common,
                account: document.getElementById('connAccount').value || undefined,
                warehouse: document.getElementById('connWarehouse').value || undefined,
                role: document.getElementById('connRole').value || undefined,
                schema: document.getElementById('connSchema').value || undefined
            };
        }
        const payload = { name: document.getElementById('connName').value, config };

        try {
            const response = await fetch(`${API_BASE}/admin/connections`, {
                method: 'POST',
                headers: getAuthHeaders(),
                body: JSON.stringify(payload)
            });
            const data = await response.json();
            if (response.ok) {
                closeConnectionModal();
                document.getElementById('connectionForm').reset();
                updateDefaultPort();
                showModal('Fabric Integrated', `Source '${payload.name}' has been successfully virtualized and cataloged.`);
                loadConnections();
            } else {
                statusEl.innerHTML = `<span class="text-danger">Integration Failed: ${escapeHtml(data.error)}</span>`;
            }
        } catch (err) {
            statusEl.innerText = 'CRITICAL: Fabric API Offline';
        } finally {
            if (submitBtn) submitBtn.disabled = false;
        }
    });

    applyEngineFieldConfig();
    loadConnections();
</script>

<%- include('partials/footer') %>
