<%- include('partials/header') %>

<div class="page fade-in">
  <div class="page-head">
    <div>
      <h1 class="page-title">Saved analytics</h1>
      <p class="page-sub">Reusable, parameterized analytics. Play one here (you will be prompted for any variables), or trigger it via <code>POST /api/saved-analytics/:id/run</code>.</p>
    </div>
    <div class="page-actions"><a href="/analytics" class="btn-outline"><i class="fas fa-arrow-left" aria-hidden="true"></i> Build / create</a></div>
  </div>

  <section class="glass-card">
    <div id="anList" class="cols-auto"></div>
    <div id="anEmpty" class="empty-state" style="display:none;">No saved analytics yet. Create one from the Analytics page.</div>
  </section>

  <!-- Run result -->
  <section class="glass-card" id="runCard" style="display:none;">
    <h4 id="runTitle">Result</h4>
    <div id="runBound" class="text-muted small mb-1"></div>
    <div class="table-wrapper"><table id="runTable"><thead id="runHead"></thead><tbody id="runBody"></tbody></table></div>
  </section>

  <section class="glass-card plan-trace" id="runPlan" style="display:none;">
    <h4>Execution plan <span id="planStrategy" class="badge badge-info"></span></h4>
    <div id="planLegs" class="mt-1"></div>
  </section>
</div>

<!-- Variable-input modal -->
<div id="varModal" class="modal-overlay" role="dialog" aria-modal="true" aria-labelledby="varModalTitle">
  <div class="modal-card">
    <div class="modal-header">
      <h3 id="varModalTitle">Provide inputs</h3>
      <button type="button" onclick="closeVarModal()" class="modal-close" aria-label="Close dialog">&times;</button>
    </div>
    <div id="varInputs" class="modal-body"></div>
    <div class="modal-footer">
      <button type="button" onclick="closeVarModal()" class="btn-outline">Cancel</button>
      <button type="button" id="varPlayBtn" class="btn-primary">Play</button>
    </div>
  </div>
</div>

<script>
  let ANALYTICS = [];

  async function loadList(){
    const res = await fetch(`${API_BASE}/saved-analytics`, { headers:getAuthHeaders() });
    ANALYTICS = await res.json();
    const el = document.getElementById('anList');
    document.getElementById('anEmpty').style.display = ANALYTICS.length ? 'none' : 'block';
    el.innerHTML = ANALYTICS.map((a,i) => `
      <div class="mini-box item-card">
        <h4>${escapeHtml(a.name)} <span class="tag">${escapeHtml(a.mode)}</span></h4>
        <div class="text-muted small">${escapeHtml(a.description||'')}</div>
        <div class="text-muted small">${(a.variables||[]).length} variable(s): ${escapeHtml((a.variables||[]).map(v=>v.name).join(', ')||'none')}</div>
        <div class="row-actions mt-1">
          <button class="btn-primary btn-sm" onclick="play(${i})"><i class="fas fa-play" aria-hidden="true"></i> Play</button>
          <button class="btn-outline btn-sm btn-danger" onclick="del('${escapeHtml(a.id)}')">Delete</button>
        </div>
      </div>`).join('');
  }

  function play(i){
    const a = ANALYTICS[i];
    const vars = a.variables || [];
    if(!vars.length){ return runAnalytic(a, {}); }
    // Prompt for variable values.
    document.getElementById('varModalTitle').innerText = `Inputs for "${a.name}"`;
    document.getElementById('varInputs').innerHTML = vars.map(v => `
      <div class="field">
        <label>${escapeHtml(v.label||v.name)} <span class="text-muted">(${escapeHtml(v.type)})${v.required?' *':''}</span></label>
        <input class="input an-vin" data-name="${escapeHtml(v.name)}" data-type="${escapeHtml(v.type)}" value="${escapeHtml(v.default ?? '')}" placeholder="${escapeHtml(v.name)}">
      </div>`).join('');
    document.getElementById('varPlayBtn').onclick = () => {
      const values = {};
      document.querySelectorAll('#varInputs .an-vin').forEach(inp => {
        let val = inp.value;
        if(val === '') return;
        if(inp.dataset.type === 'number') val = Number(val);
        else if(inp.dataset.type === 'boolean') val = (val === 'true');
        values[inp.dataset.name] = val;
      });
      closeVarModal();
      runAnalytic(a, values);
    };
    document.getElementById('varModal').classList.add('active');
  }
  function closeVarModal(){ document.getElementById('varModal').classList.remove('active'); }

  async function runAnalytic(a, values){
    try {
      const res = await fetch(`${API_BASE}/saved-analytics/${a.id}/run`, {
        method:'POST', headers:getAuthHeaders(), body: JSON.stringify({ variables: values }) });
      const r = await res.json();
      if(!res.ok){ return showModal('Run failed', r.error || 'error'); }
      renderResult(a, r);
    } catch(e){ showModal('Error', e.message); }
  }

  function renderResult(a, r){
    document.getElementById('runCard').style.display = 'block';
    document.getElementById('runTitle').innerText = `▶ ${a.name}`;
    const bound = r.boundVariables || {};
    document.getElementById('runBound').innerText = Object.keys(bound).length
      ? 'Bound: ' + Object.entries(bound).map(([k,v])=>`${k}=${v}`).join(', ') : 'No variables.';
    const rows = r.data || [];
    const cols = rows.length ? Object.keys(rows[0]) : [];
    document.getElementById('runHead').innerHTML = '<tr>' + cols.map(c=>`<th>${escapeHtml(c)}</th>`).join('') + '</tr>';
    document.getElementById('runBody').innerHTML = rows.slice(0,200).map(row =>
      '<tr>' + cols.map(c=>`<td>${escapeHtml(row[c])}</td>`).join('') + '</tr>').join('') ||
      `<tr><td class="state-cell">${r.rowCount ?? 0} rows</td></tr>`;
    // plan
    const p = r.plan || {};
    document.getElementById('runPlan').style.display = 'block';
    document.getElementById('planStrategy').innerText = p.strategy || '';
    document.getElementById('planLegs').innerHTML = (p.legs||[]).map(l => `
      <div class="mini-box">
        <strong>${escapeHtml(l.source)}</strong> <span class="tag">${escapeHtml(l.engine)}/${escapeHtml(l.mode)}</span>
        ${escapeHtml(l.operation)} → <strong>${escapeHtml(l.rowsReturned)}</strong> rows in ${escapeHtml(l.ms)}ms</div>`).join('')
      || `<div class="text-muted">Total ${escapeHtml(p.executionMs ?? '—')} ms.</div>`;
  }

  async function del(id){
    if(!confirm('Delete this saved analytic?')) return;
    await fetch(`${API_BASE}/saved-analytics/${id}`, { method:'DELETE', headers:getAuthHeaders() });
    loadList();
  }

  document.addEventListener('DOMContentLoaded', loadList);
</script>

<%- include('partials/footer') %>
