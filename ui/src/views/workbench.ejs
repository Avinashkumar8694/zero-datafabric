    .wb-input { width:100%; border:1px solid #dbe2ea; border-radius:8px; padding:0.5rem 0.65rem; font-size:0.85rem; }
    .wb-muted { color:#64748b; }
    .tree-source { padding:0.5rem 0.9rem; font-weight:700; color:#1e293b; border-top:1px solid #f1f5f9; }
    .tree-schema { padding:0.4rem 1.5rem; color:#334155; font-size:0.85rem; }
    .tree-cat { padding:0.3rem 1.7rem 0.15rem; color:#94a3b8; font-size:0.68rem; font-weight:800; text-transform:uppercase; letter-spacing:0.04em; }
