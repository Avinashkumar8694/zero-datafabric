            </div> <!-- content-wrapper -->
        </main>
    </div> <!-- app-layout -->

    <script>
        // Shared UI Orchestration
        {
            const publicPaths = ['/', '/login', '/logout'];
            const isPublic = publicPaths.some(p => window.location.pathname === p || window.location.pathname.startsWith(p + '?'));
            if (!getToken() && !isPublic) {
                window.location.href = '/logout';
            }
        }

        // Active Link Highlighting
        const currentPath = window.location.pathname;
        const navItems = document.querySelectorAll('.nav-item');
        navItems.forEach(item => {
            if (item.getAttribute('href') === currentPath) {
                item.classList.add('active');
            }
        });

        // Update User Profile UI
        try {
            const token = getToken();
            if (!token) throw new Error('No token');
            const payload = JSON.parse(atob(token.split('.')[1]));
            document.getElementById('displayUsername').innerText = payload.username || 'Admin';
            document.getElementById('displayTenant').innerText = payload.tenant_id || 'System';
            document.getElementById('userAvatar').innerText = (payload.username || 'A')[0].toUpperCase();

            // Hide Admin-only features if user is not ADMIN
            if (payload.internal_role !== 'ADMIN') {
                const adminLinks = ['nav-iam', 'nav-audit'];
                adminLinks.forEach(id => {
                    const el = document.getElementById(id);
                    if (el) el.style.display = 'none';
                });
            }
        } catch (e) {}
    </script>
</body>
</html>
